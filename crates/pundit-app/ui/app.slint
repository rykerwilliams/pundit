// The pundit window (spec D9, D10, D11): sidebar, player area with its
// zoom and empty-state cards, transport bar, error dialog, and the keyboard.
//
// Everything here is presentation. `src/main.rs` turns the callbacks into bus
// commands and feeds bus events back in through the `in` properties.

import { Button, CheckBox, ComboBox, LineEdit, ListView, Palette, ProgressIndicator, ScrollView, Slider, TextEdit } from "std-widgets.slint";
import { Mark, Scrubber } from "scrubber.slint";
import { Splitter } from "splitter.slint";

/// One row of the sidebar's Sources list.
export struct SourceRow {
    name: string,
    /// Already formatted.
    duration: string,
    missing: bool,
    /// Used by a clip, a match event, a highlight or a slate, so it can't be
    /// removed.
    referenced: bool,
}

/// One row of the sidebar's Slates list, in `(video, in point)` order — a
/// range marked while watching, waiting for its commentary.
export struct SlateRow {
    /// The slate's UUID.
    id: string,
    /// `14:05–14:40`, or `14:05–` while the range is still open.
    range: string,
    /// The video it is on, shown only when the project has more than one.
    video: string,
    /// "Untitled" for an empty name, as a clip's row does it.
    name: string,
    /// Comma-separated, already normalized.
    tags: string,
    /// A clip was recorded from it. It stays in the list: a coach re-records —
    /// and that is also what makes the themed pass safe, since a list nothing
    /// leaves is a stable frame of reference for "the next one after this"
    /// (`slate_pass::next_slate`).
    shot: bool,
    /// Both marks are set (BACKLOG #120). A half-marked range — `i` pressed,
    /// `o` not — is **shown and skipped by the themed pass**, so the row has to
    /// say so: a pass that silently passed over rows the coach can see is the
    /// hazard the spec's review found in its own T1.
    timed: bool,
}

/// One row of the sidebar's Clips list, in the project's order.
export struct ClipRow {
    /// The clip's UUID.
    id: string,
    /// "Untitled" for an empty name.
    name: string,
    /// The recording's length, already formatted.
    duration: string,
}

/// One row of the tag overview (Phase 3 C8).
export struct TagRow {
    tag: string,
    /// "3 clips · 1:24", already formatted.
    detail: string,
}

/// One row of the export sheet's target list (Phase 8 E8): all the clips, one
/// tag's, or the clip the sheet was opened on.
export struct TargetRow {
    label: string,
    /// "4 clips · 3:12", or "3 goals · 1:48" for the reel, already
    /// formatted.
    detail: string,
    /// Ticked to export. `src/main.rs` owns it — it holds the targets these
    /// rows stand for — so the sheet only reports a click.
    ticked: bool,
}

/// One row of the export sheet's run list: a target of the run in progress.
export struct RunRow {
    label: string,
    /// Whether this target is the one rendering: only then is there a bar.
    rendering: bool,
    /// How far it has got, 0..1. Meaningless unless `rendering`.
    progress: float,
    /// "Pending", "45%", "Done", "Cancelled" or "Failed".
    status: string,
}

/// One piece of the basket, as its sheet lists it (basket spec C4). The bus
/// resolves all four against the piece's own project every time it publishes
/// the basket, so nothing here is the window's to keep.
export struct BasketPieceRow {
    /// "Rovers v Athletic", or the project's own name — what changes between
    /// two adjacent corners from two different games (basket spec T2).
    match-label: string,
    clip-label: string,
    /// "0:14": roughly how long the piece runs, already formatted.
    length: string,
    /// Why this piece can't be exported, or empty. It covers a project that
    /// can't be read and a clip that has gone; **footage is checked at Start,
    /// not here** (basket spec V1), which is what the note under the list
    /// says.
    problem: string,
}

/// One row of the Match panel's event list (Phase 9 S4).
export struct MatchRow {
    /// The event's UUID.
    id: string,
    /// Where it sits on the concat timeline, already formatted.
    time: string,
    /// "1H start", "Home goal", … — already formatted.
    label: string,
    /// A start/stop this format has no period for. It keeps its place; the
    /// scoreboard ignores it until the format grows or the back-anchor goes
    /// off, so the row says so rather than looking like every other one.
    role-less: bool,
    /// A goal's span in the reel, "−20 s / +6 s"; empty for anything but a
    /// goal, whose row is the only one with the reel's buttons (spec R3).
    reel-span: string,
}

/// One row of the match event editor's list (spec T2). The same events in the
/// same order as `MatchRow`, from the same builder, said the editor's way: the
/// time into a video, which is what its grammar names.
export struct MatchEditorRow {
    /// The event's UUID.
    id: string,
    /// "2 · 14:05.0": the 1-based video number and the time into that video,
    /// the paste grammar's own numbering (spec B1).
    where-text: string,
    /// "1H start", "Home goal", … — what `interpret` makes of the list as it
    /// stands. The editor refuses nothing on match logic, so this row is the
    /// whole feedback channel (spec V2).
    label: string,
    /// A start/stop the format has no period for, greyed as the panel's is.
    role-less: bool,
}

/// One echoed line of the paste box (spec B3): what the parser made of it,
/// before Add is pressed.
export struct PasteLine {
    /// "✓" it will add, "•" it is already tagged, "✗" it is refused.
    glyph: string,
    text: string,
}

/// Everything the paste box says about the block it holds. One callback
/// rather than three, so a keystroke parses the block once.
export struct PasteEcho {
    lines: [PasteLine],
    /// "7 events to add · 1 already tagged · 2 lines refused"; empty for an
    /// empty box.
    summary: string,
    /// How many lines will add: what Add is enabled on.
    adding: int,
    /// "Add 7 events".
    button: string,
}

/// One ready-made colour in the setup sheet's picker
/// (`src/color_picker.rs`'s `KIT_COLORS`).
export struct KitColor {
    /// The swatch's tooltip: "Royal blue", "Claret", ….
    name: string,
    /// `#rrggbb`, written into the field as it stands.
    hex: string,
}

/// A colour as the picker's strip and area hold it: `hue` in degrees
/// (0..360), `sat` and `val` in 0..1. Every conversion to and from it is
/// Rust's (`src/color_picker.rs`) -- see [`ColorPicker`].
export struct Hsv {
    hue: float,
    sat: float,
    val: float,
}

/// A goal row's reel buttons (spec R3): set one end of the goal's span at the
/// scan position, or put it back to the default.
export enum ReelTrim {
    start-here,
    reset-start,
    end-here,
    reset-end,
}

/// What a tag key or one of the Match panel's buttons records (Phase 9 S4).
export enum MatchTag {
    home-goal,
    away-goal,
    start-stop,
}

/// Which way `J`, `L` and the speed button move the scan speed (spec S1).
export enum ScanStep {
    faster,
    slower,
    cycle,
}

/// What a key does, which is the Slint half of the one table every binding
/// lives in (BACKLOG #96, `crates/pundit-app/src/keymap.rs`).
///
/// **One member per `keymap::Action`, plus `none`.** `action-for` answers with
/// one of these and `handle-key`'s chain acts on it, so a key is spelled in
/// exactly one place -- Rust -- and this file holds only what a key *does*
/// and the gates on doing it. `key_action.rs` maps the two with a `match` on
/// the Rust enum, so an action added without a member here fails to compile.
///
/// **The chain over these is not exhaustive and Slint cannot make it so**
/// (plan Risk 1): an action with a default binding and no branch in
/// `handle-key` is a listed key that does nothing. `tests/ui/keys.rs` is the
/// check -- a table of every action, which a new one joins.
export enum KeyAction {
    none,
    open-project,
    undo,
    redo,
    clear-drawings,
    mark-in,
    mark-out,
    tag-home-goal,
    tag-away-goal,
    tag-period,
    highlight-tool,
    toggle-recording,
    delete-clip,
    toggle-play,
    skip-back,
    skip-forward,
    skip-back-far,
    skip-forward-far,
    step-back,
    step-forward,
    prev-event,
    next-event,
    scan-slower,
    scan-faster,
    fit-window,
    zoom-reset,
    zoom-out,
    zoom-in,
    show-keys,
    show-recents,
}

/// Which field of a slate an edit names, so one callback carries both.
export enum SlateField {
    name,
    tags,
}

/// Which of a slate's two marks a button moves (BACKLOG #119).
///
/// **Not folded into [`SlateField`]**: those two carry the text of a field,
/// these two carry no payload at all — the value is the playhead, read in Rust.
export enum SlateMark {
    in-point,
    out-point,
}

/// The inspector's text fields, for `edit-clip`.
export enum ClipField {
    name,
    tags,
    notes,
    transcript,
}

/// How wide an inset is drawn, and which corner it is flush into (#88 spec
/// I1, I2) — `core::project`'s `InsetSize` and `InsetCorner`, which Slint
/// cannot take directly.
///
/// **These two cross as declared enums and the inspector's pickers cross as
/// `int` indices, deliberately.** They are read by `place-self-view`, where a
/// pair of `int`s would read as valid either way round — which is the mistake
/// `core::project::InsetPlacement` exists to make unwritable. The pickers
/// cannot use them: a `ComboBox`'s `current-index` needs a **two-way**
/// binding (see `Inspector::transcript-model`), so the value the control holds
/// has to be the index itself, and `resolution_index` / `resolution_at` in
/// `main.rs` are the shipped shape for that.
export enum InsetSize {
    small,
    medium,
    large,
}

export enum InsetCorner {
    bottom-right,
    bottom-left,
    top-right,
}

/// The selected clip's transcription, as the bus publishes it (Phase 10 S5).
/// `idle` covers "never transcribed" and "ran and found nothing" alike:
/// `transcript-status` is the line that tells those two apart.
export enum TranscriptState {
    idle,
    queued,
    running,
    failed,
}

/// One row of the Devices popover's camera or microphone list.
export struct DeviceRow {
    /// PipeWire's `node.name`, the stored preference; empty for "System
    /// default".
    node-name: string,
    label: string,
    /// The project's current choice.
    chosen: bool,
}

/// One row of the Recent popover (recents spec D1, D2, D3).
///
/// **The row carries its folder and the click sends it back**, which is
/// `DeviceRow`'s shipped pattern (`node-name`, straight through
/// `choose-camera`). An index would be the staleness it was meant to avoid: the
/// rows are built from one list, so an index resolved against a later one opens
/// a project the coach never read.
export struct RecentRow {
    /// The project's folder, sent back by `open-recent`.
    folder: string,
    /// Line one, always populated: the match's name, or the folder's own name
    /// where the project could not be read.
    label: string,
    /// Line two, empty where it would only repeat `label`.
    second-line: string,
    /// The open project. Ticked, and **the one row that is not clickable** —
    /// re-opening the open project would empty its own trash.
    ticked: bool,
    /// The project could not be read. Dimmed, and **still clickable**: the
    /// drive may be about to be plugged in.
    dimmed: bool,
}

/// The recording as the UI last heard it from the bus (Phase 4 R6).
export enum RecordingPhase {
    idle,
    /// Recording, but the camera hasn't delivered a frame yet.
    starting,
    recording,
}

/// Zoom and pan (spec D9), mirrored from the Rust side, which owns it.
export struct ZoomState {
    scale: float,
    pan-x: float,
    pan-y: float,
}

/// Where the picture is drawn in the player area.
export struct PictureRect {
    x: length,
    y: length,
    width: length,
    height: length,
}

/// The zoom readout (spec D9, macOS `ZoomIndicator`): the scale over a
/// logarithmic track from 1× to 10×, with ticks at the snap notches. Hidden
/// at 1×, where there's nothing to read.
component ZoomIndicator inherits Rectangle {
    in property <float> scale;
    in property <[float]> notches;

    /// 1× is the left end, 10× the right: log10(scale).
    function track-x(scale: float) -> length {
        max(0, min(1, log(max(scale, 1), 10))) * track.width
    }

    width: row.preferred-width;
    height: row.preferred-height;
    background: #0000008c;
    border-radius: 6px;
    opacity: root.scale > 1 ? 1 : 0;
    animate opacity { duration: 180ms; easing: ease-out; }

    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 10px;

        Text {
            text: root.scale.to-fixed(2) + "×";
            color: white;
            font-size: 12px;
            font-weight: 600;
            font-family: "monospace";
            width: 56px;
            vertical-alignment: center;
        }

        track := Rectangle {
            width: 140px;
            height: 12px;

            Rectangle {
                y: (parent.height - self.height) / 2;
                height: 3px;
                border-radius: 1.5px;
                background: #ffffff40;
            }
            for notch in root.notches: Rectangle {
                x: root.track-x(notch) - 0.5px;
                y: (parent.height - self.height) / 2;
                width: 1px;
                height: 9px;
                background: #ffffff8c;
            }
            Rectangle {
                x: root.track-x(root.scale) - 4.5px;
                y: (parent.height - self.height) / 2;
                width: 9px;
                height: 9px;
                border-radius: 4.5px;
                background: white;
            }
        }
    }
}

/// A card over the player area: the next thing to do when there's nothing to
/// play.
component EmptyCard inherits Rectangle {
    in property <string> title;
    in property <string> message;
    in property <string> action;
    /// A second, demoted action beside the first. Empty on the cards that have
    /// only one, which is why it is a string rather than a bool: the label *is*
    /// whether there is a button.
    in property <string> secondary;
    in property <bool> enabled: true;
    callback clicked();
    callback secondary-clicked();

    background: black;

    VerticalLayout {
        alignment: center;
        spacing: 16px;
        padding: 40px;

        Text {
            text: root.title;
            color: white;
            font-size: 20px;
            font-weight: 600;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            alignment: center;
            Text {
                text: root.message;
                color: #ffffffb3;
                wrap: word-wrap;
                horizontal-alignment: center;
                width: min(420px, root.width - 80px);
            }
        }

        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            Button {
                text: root.action;
                primary: true;
                enabled: root.enabled;
                clicked => { root.clicked(); }
            }
            if root.secondary != "": Button {
                text: root.secondary;
                enabled: root.enabled;
                clicked => { root.secondary-clicked(); }
            }
        }
    }
}

/// A row of the Devices popover: the device, checked if it's the choice.
/// Clicking it picks it (and closes the popover).
component DeviceChoice inherits Rectangle {
    in property <string> label;
    in property <bool> chosen;
    callback clicked();

    height: 28px;
    border-radius: 4px;
    background: touch.has-hover ? Palette.selection-background : transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 6px;

        Text {
            text: root.chosen ? "✓" : "";
            color: Palette.foreground;
            width: 14px;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: Palette.foreground;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

/// One of the Devices popover's lists, under its title. Picking a row reports
/// its `node-name`.
component DeviceList inherits VerticalLayout {
    in property <string> title;
    in property <[DeviceRow]> rows;
    callback chosen(string);

    spacing: 4px;

    Text {
        text: root.title;
        color: Palette.alternate-foreground;
        font-size: 11px;
    }
    if root.rows.length == 0: Text {
        text: "Looking for devices…";
        color: Palette.alternate-foreground;
    }
    for row in root.rows: DeviceChoice {
        label: row.label;
        chosen: row.chosen;
        clicked => { root.chosen(row.node-name); }
    }
}

/// One row of the Recent popover, on [`DeviceChoice`]'s shape with a second
/// line.
///
/// **The ticked row is not clickable, and that is load-bearing rather than
/// cosmetic**: a click on the open project's row would send `OpenProject` for
/// the folder already open, and the bus's `commit` clears the undo history and
/// `remove_dir_all`s that project's own `recordings/.trash`. Making only the
/// cursor change would still let it happen.
///
/// **`enabled` on the `TouchArea` is the whole of it**, one property rather
/// than two conditions: `TouchArea::input_event_filter_before_children` sets
/// `has_hover` to false when it is disabled
/// (`i-slint-core-1.18.0/items/input_items.rs:81-82`), so the hover background
/// below goes with the click. Wrapping the `TouchArea` in an `if` instead does
/// not compile — the `touch` id leaves scope and `background` cannot reach it.
///
/// A dimmed row stays enabled: the drive may be about to be plugged in.
component RecentChoice inherits Rectangle {
    in property <string> label;
    in property <string> second-line;
    in property <bool> ticked;
    in property <bool> dimmed;
    callback clicked();

    height: root.second-line == "" ? 28px : 40px;
    border-radius: 4px;
    background: touch.has-hover ? Palette.selection-background : transparent;

    touch := TouchArea {
        enabled: !root.ticked;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 6px;

        Text {
            text: root.ticked ? "✓" : "";
            color: Palette.foreground;
            width: 14px;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;

            Text {
                text: root.label;
                color: root.dimmed ? Palette.alternate-foreground : Palette.foreground;
                overflow: elide;
            }
            if root.second-line != "": Text {
                text: root.second-line;
                color: Palette.alternate-foreground;
                font-size: 11px;
                overflow: elide;
            }
        }
    }
}

/// The Recent popover's list (recents spec P5).
///
/// **Two empty states, and the difference matters to the coach**: no list at all
/// is a fresh install, while a list none of whose projects could be read is a
/// drive that isn't mounted — *"my projects are gone"* against *"my drive isn't
/// plugged in"*. `none-resolved` is computed in Rust because Slint cannot fold
/// over a model to learn it.
component RecentList inherits VerticalLayout {
    in property <[RecentRow]> rows;
    in property <bool> none-resolved;
    callback chosen(string);

    spacing: 4px;

    Text {
        text: "Recent projects";
        color: Palette.alternate-foreground;
        font-size: 11px;
    }
    if root.rows.length == 0: Text {
        text: "No projects opened yet.";
        color: Palette.alternate-foreground;
        wrap: word-wrap;
    }
    // No `rows.length > 0` here: `recents::none_resolved` is false for an empty
    // list by construction, and one invariant in two places is one too many.
    if root.none-resolved: Text {
        text: "None of these could be read. If they live on an external drive, plug it in.";
        color: Palette.alternate-foreground;
        wrap: word-wrap;
        font-size: 11px;
    }
    for row in root.rows: RecentChoice {
        label: row.label;
        second-line: row.second-line;
        ticked: row.ticked;
        dimmed: row.dimmed;
        clicked => { root.chosen(row.folder); }
    }
}

/// The Devices popover's Inset section (avatar spec G1): the project's avatar
/// image, or the camera when it has none.
///
/// There are no radio rows, because the image **is** the mode (B1): picking
/// one is what makes a take record commentary without a camera, and removing
/// it is what puts the camera back.
component InsetSection inherits VerticalLayout {
    /// The picked image, empty when there is none or its file has gone.
    in property <image> thumb;
    /// Its file name, empty when nothing is picked.
    in property <string> name;
    /// A name is stored but the file isn't beside `project.json` any more
    /// (A4), so the coach finds out before a take rather than after an export.
    in property <bool> missing;
    callback choose();
    callback remove();

    spacing: 4px;

    Text {
        text: "Inset";
        color: Palette.alternate-foreground;
        font-size: 11px;
    }
    HorizontalLayout {
        spacing: 8px;

        // Min and max, not `width`: a layout sets its children's size, and a
        // plain `width` here is overwritten with the row's.
        if root.name != "" && !root.missing: Image {
            source: root.thumb;
            min-width: 40px;
            max-width: 40px;
            min-height: 40px;
            max-height: 40px;
            image-fit: contain;
        }
        Text {
            text: root.name == "" ? "Camera — no avatar picked"
                : root.missing ? root.name + " is missing"
                : root.name;
            color: root.missing ? #ffcc00 : Palette.foreground;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
            min-width: 0;
        }
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: start;

        Button {
            text: "Choose…";
            clicked => { root.choose(); }
        }
        if root.name != "": Button {
            text: "Remove";
            clicked => { root.remove(); }
        }
    }
}

/// A caption over one of the inspector's fields.
component FieldLabel inherits Text {
    color: Palette.alternate-foreground;
    font-size: 11px;
}

/// A foldable section's header (BACKLOG #113): a chevron, the title, and what
/// the section still says when it is folded away.
///
/// **It replaces a [`FieldLabel`] in a panel's existing title row**, so the
/// panel keeps its own buttons beside it — a generic wrapper could not, because
/// Slint gives a component one `@children` slot and those buttons live in the
/// same row as the title.
///
/// **`summary` is what makes folding "put the rows away" rather than "hide the
/// section".** The Match panel folded still shows the score and clock, which is
/// the line the coach glances at; Sources folded still says a video is missing,
/// which is the one thing that must not be hidden — a coach could otherwise
/// export against a source they never saw was gone.
component FoldHeader inherits Rectangle {
    in property <string> title;
    in property <bool> expanded;
    /// Shown only when folded, after the title.
    in property <string> summary;
    /// Draws `summary` as a warning rather than as information.
    in property <bool> summary-warns;
    callback toggled();

    horizontal-stretch: 1;
    // A `Rectangle` rather than a layout, so the `TouchArea` can fill the whole
    // header: inside a `HorizontalLayout` it would be laid out as a cell and
    // take width from the title.
    height: row.preferred-height;
    border-radius: 4px;
    background: touch.has-hover ? Palette.selection-background : transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        // The focus drop is the caller's: `keys` is the window's id and is not
        // in scope here, and a panel with a field has to commit it before
        // folding anyway.
        clicked => { root.toggled(); }
    }

    row := HorizontalLayout {
        spacing: 6px;

        VerticalLayout {
            alignment: center;
            Text {
                // One glyph, turned: the direction *is* the state.
                text: root.expanded ? "⌄" : "›";
                color: Palette.alternate-foreground;
                font-size: 11px;
                width: 10px;
                horizontal-alignment: center;
            }
        }
        FieldLabel {
            text: root.title;
            vertical-alignment: center;
            horizontal-stretch: root.summary == "" || root.expanded ? 1 : 0;
        }
        if !root.expanded && root.summary != "": FieldLabel {
            text: root.summary;
            color: root.summary-warns ? Palette.foreground : Palette.alternate-foreground;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

/// A comma-separated tag field that offers the tags already in use (C8). The
/// clip inspector's and the slate editor's are one component (BACKLOG #105),
/// so the Tab / Esc rules and the focus trap exist once.
///
/// **The list of suggestions is a separate element, `TagSuggestions` below,
/// which the caller places last in a non-layout parent.** Slint draws in
/// declaration order and has no z-order, so a list declared inside this
/// component would be drawn *under* whatever the caller lays out after the
/// field -- the inspector's checkbox and pickers, the slate editor's clips
/// list. It is the field that is reused twice; the list costs the caller five
/// bindings off the field's own geometry and state, which is cheaper than the
/// rules would be to keep in step twice.
component TagField inherits LineEdit {
    /// The tags already in use that the text so far could become.
    pure callback suggest(string) -> [string];
    /// The text with a suggestion spliced into it.
    pure callback splice(string, string) -> string;
    /// Enter: a commit that keeps focus. **Its own callback rather than
    /// `LineEdit`'s `accepted`**, which a caller would be overriding -- the
    /// suggestions would then stay open over a committed field, silently.
    callback committed(string);
    /// Focus arrived (`true`) or left, which commits. Its own callback for the
    /// reason `committed` is.
    callback focus-moved(bool, string);

    /// For the current fragment, from the last edit. The caller's
    /// `TagSuggestions` renders them.
    out property <[string]> suggestions;
    /// Esc closed them; the next edit reopens them.
    property <bool> dismissed;
    /// There is a list on screen, so Tab and Esc are the list's.
    out property <bool> suggesting: root.has-focus && root.suggestions.length > 0 && !root.dismissed;

    /// Takes `tag` into the field, keeping focus, with the cursor at the end.
    /// It doesn't commit: Enter or leaving the field does.
    public function take(tag: string) {
        root.text = root.splice(root.text, tag);
        root.suggestions = [];
        // Past the end, which clamps to it.
        root.set-selection-offsets(2147483647, 2147483647);
    }

    accepted(text) => {
        root.suggestions = [];
        root.committed(text);
    }
    changed has-focus => {
        root.suggestions = [];
        root.focus-moved(root.has-focus, root.text);
    }
    edited(text) => {
        root.dismissed = false;
        root.suggestions = root.suggest(text);
    }
    // Tab takes the top suggestion; Esc closes them. Otherwise Tab moves focus
    // on, and Esc bubbles to the window, which leaves the field -- which is
    // why this has to `accept`: the window's `text-editing` rejects Esc down
    // to the focused field, and a reject here would send it back up to leave
    // the field and throw away a half-typed tag.
    key-pressed(event) => {
        if (root.suggesting && event.text == Key.Tab) {
            root.take(root.suggestions[0]);
            return accept;
        }
        if (root.suggesting && event.text == Key.Escape) {
            root.dismissed = true;
            return accept;
        }
        reject
    }
}

/// A `TagField`'s suggestions, over whatever is below the field.
///
/// **Not a `PopupWindow`**, whose `show()` would take focus from the field and
/// commit it (C8). And not a child of the field, for the drawing order
/// `TagField`'s own comment gives: the caller declares it last in a parent
/// that is not a layout, so it claims no cell and is drawn over its siblings.
component TagSuggestions inherits Rectangle {
    in property <[string]> suggestions;
    /// One was clicked.
    callback take(string);

    height: list.preferred-height;
    background: Palette.background;
    border-radius: 6px;
    border-width: 1px;
    border-color: Palette.border;

    list := VerticalLayout {
        padding: 4px;

        for tag in root.suggestions: Rectangle {
            height: 26px;
            border-radius: 4px;
            background: suggestion-touch.has-hover ? Palette.selection-background : transparent;

            // A click doesn't take focus from the field.
            suggestion-touch := TouchArea {
                clicked => { root.take(tag); }
            }
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                Text {
                    text: tag;
                    color: Palette.foreground;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }
    }
}

/// The selected clip's fields (Phase 3 C7). The window renders them through
/// the `in-out` properties, and the fields report focus and commits; which
/// clip a commit is for is the window's business.
component Inspector inherits Rectangle {
    in property <bool> enabled;
    in-out property <string> name-text;
    in-out property <string> tags-text;
    in-out property <string> notes-text;
    in-out property <bool> show-pip;
    /// The selected clip's inset size and corner (#88 spec I7), as **indices**
    /// into the two pickers' models -- `main.rs`'s `inset_size_index` and
    /// `inset_corner_index`, which is `resolution_index`'s pattern.
    ///
    /// **Two-way, for the reason `transcript-model` below is:** a `ComboBox`
    /// writes its own `current-index`, which replaces any one-way binding onto
    /// it, and from then on the next clip's value would never reach the
    /// control. Nothing stores an index -- `ClipEdit::InsetSize` carries the
    /// enum -- so the one that lives here lives only between a click and the
    /// command it sends.
    ///
    /// **Both carry their default**, because Slint's is `0` and these are
    /// shown before `show_clip` has ever run -- with no project open, in a
    /// disabled inspector. `inset_size_index(InsetSize::default())` is 1
    /// (Medium); `inset_corner_index(InsetCorner::default())` really is 0
    /// (Bottom right), and says so here so the asymmetry doesn't read as an
    /// oversight.
    in-out property <int> inset-size-index: 1;
    in-out property <int> inset-corner-index: 0;
    /// This clip was recorded with the project's avatar rather than a camera
    /// (avatar G3). One word of the checkbox above follows it; the property,
    /// the command and the undo are the one `show-pip` either way.
    in property <bool> avatar;
    /// The project's avatar image has gone (A4), which costs an avatar clip
    /// its inset. Said here so the coach is told before they export.
    in property <bool> avatar-missing;
    /// The commentary as words (Phase 10 S4), editable like any other field.
    in-out property <string> transcript-text;
    /// What the bus says about this clip's transcription (S5) ...
    in property <TranscriptState> transcript-state;
    /// ... and the line under the box that says it in words -- including the
    /// "no speech found" that an `idle` clip with an empty transcript may
    /// have earned. Empty when there is nothing to say.
    in property <string> transcript-status;
    /// The speech models on offer, in `transcript-model`'s order (Phase 10
    /// S3). `src/main.rs` owns the list: under
    /// `$PUNDIT_WHISPER_MODEL` it is the one model that variable names,
    /// and the picker is disabled.
    in property <[string]> transcript-models;
    /// Which one is chosen, as an index into `transcript-models`. **Two-way:**
    /// a one-way binding onto a ComboBox's `current-index` is overwritten the
    /// first time the coach opens it, and the readout then lies.
    in-out property <int> transcript-model;
    /// Whether the choice is the coach's to make -- false under
    /// `$PUNDIT_WHISPER_MODEL`, which runs what it points at whatever is
    /// picked.
    in property <bool> transcript-model-enabled;
    /// Empty, or -- when the chosen model isn't downloaded yet -- what the
    /// Transcribe button says instead: the download it starts first, and its
    /// size (Phase 11 S3). The button is the prompt; pressing it is the
    /// consent.
    in property <string> transcribe-download;
    /// Some field of this inspector has focus. **Not the window's shortcut
    /// gate** -- that is Slint's own `TextInputInterface.text-input-focused`
    /// and needs telling about nothing. This answers the narrower question
    /// `end-edit`'s reader asks: focus left *this* field, but is it still in
    /// this inspector? If it is, the coach is tabbing between a clip's fields
    /// and `editing-clip-id` must go on naming that clip. So every field of
    /// this component belongs here, and only this component's.
    out property <bool> editing: name.has-focus || tags.has-focus || notes.has-focus
        || transcript.has-focus;
    /// Preview is possible at all (Phase 7 P6): something to play, and
    /// neither recording nor exporting, both of which the bus refuses.
    in property <bool> can-preview;
    /// This clip is the one on screen, so the button closes it instead.
    in property <bool> previewing;
    /// The Preview button: open a preview of this clip, or close the one
    /// showing it. Opening is explicit (P5) -- Space plays the game video
    /// until a preview is open.
    callback preview-clicked();

    /// A field gained focus ...
    callback begin-edit();
    /// ... pressed Enter (a commit that keeps focus) ...
    callback commit(ClipField, string);
    /// ... or lost focus, which commits.
    callback end-edit(ClipField, string);
    callback pip-toggled(bool);
    /// A size or a corner was picked, by index into the picker's model.
    callback inset-size-chosen(int);
    callback inset-corner-chosen(int);
    /// Queue this clip's commentary for transcription (Phase 10 S6).
    callback transcribe-clicked();
    /// Stop the transcription running **and drop the queue behind it**.
    callback cancel-transcribe-clicked();
    /// A speech model was picked, by index into `transcript-models`.
    callback transcript-model-chosen(int);
    /// Existing tags to suggest for the tag field's text (C8).
    pure callback suggest-tags(string) -> [string];
    /// The tag field's text with the suggestion taken.
    pure callback take-suggestion(string, string) -> string;

    /// Focus the tag field, for the test that pins Tab and Esc in it.
    public function focus-tags() { tags.focus(); }

    function focus-changed(field: ClipField, focused: bool, text: string) {
        if (focused) {
            root.begin-edit();
        } else {
            root.end-edit(field, text);
        }
    }

    layout := VerticalLayout {
        padding: 12px;
        spacing: 6px;

        FieldLabel { text: "Name"; }
        name := LineEdit {
            enabled: root.enabled;
            placeholder-text: "Untitled";
            text <=> root.name-text;
            accepted(text) => { root.commit(ClipField.name, text); }
            changed has-focus => { root.focus-changed(ClipField.name, self.has-focus, self.text); }
        }

        FieldLabel { text: "Tags"; }
        // A direct child of the layout, so its x and y place the suggestions.
        tags := TagField {
            enabled: root.enabled;
            placeholder-text: "Comma-separated";
            text <=> root.tags-text;
            suggest(text) => { return root.suggest-tags(text); }
            splice(text, tag) => { return root.take-suggestion(text, tag); }
            committed(text) => { root.commit(ClipField.tags, text); }
            focus-moved(focused, text) => { root.focus-changed(ClipField.tags, focused, text); }
        }

        CheckBox {
            text: root.avatar ? "Show avatar in export" : "Show webcam in export";
            enabled: root.enabled;
            checked <=> root.show-pip;
            toggled => { root.pip-toggled(self.checked); }
        }

        // Where that inset goes and how big (#88 spec I7), under the checkbox
        // that says whether there is one. Not disabled when there isn't: the
        // coach can set the placement before ticking the box, and a greyed
        // pair here would be a second rule about `show-pip` to keep.
        //
        // **`min-width: 0` on both is load-bearing, not tidiness.** A
        // `ComboBox` declares `min-width: 160px` in Slint's default style, so
        // two of them and the gap want **326px** of the 256px this 280px
        // column has inside its padding -- the same overflow the transcript
        // caption row below records for a fourth control (76px past, at the
        // window's 1100x700 minimum). Overridden to 0 and left stretching, the
        // pair simply splits whatever the column gives and the worst case is a
        // clipped label, visible the moment anyone opens the app, rather than
        // a control off the edge. `horizontal-stretch` restates the widget's
        // own default so the whole rule reads here.
        //
        // Vertical space is no longer scarce: the column went inside a
        // `ScrollView` in 0.10.0, so an extra row scrolls and nothing has to
        // give up pixels for it.
        FieldLabel { text: "Inset size and corner"; }
        HorizontalLayout {
            spacing: 6px;
            ComboBox {
                min-width: 0;
                horizontal-stretch: 1;
                // 0.16 / 0.22 / 0.30 of the output width (spec I1); Medium is
                // the width every inset the app has ever drawn had.
                model: ["Small", "Medium", "Large"];
                enabled: root.enabled;
                current-index <=> root.inset-size-index;
                selected => { root.inset-size-chosen(self.current-index); }

                Tooltip { text: @markdown("How wide this clip's inset is in the export"); }
            }
            ComboBox {
                min-width: 0;
                horizontal-stretch: 1;
                // Top-left is deliberately absent: the scoreboard is locked
                // into it and is drawn over the inset (spec I2).
                model: ["Bottom right", "Bottom left", "Top right"];
                enabled: root.enabled;
                current-index <=> root.inset-corner-index;
                selected => { root.inset-corner-chosen(self.current-index); }

                Tooltip { text: @markdown("Which corner this clip's inset sits in. The caption bar gives way to it"); }
            }
        }

        if root.avatar && root.avatar-missing: Text {
            text: "The project's avatar image is missing, so this clip exports with no inset.";
            color: #ffcc00;
            font-size: 11px;
            wrap: word-wrap;
        }

        FieldLabel { text: "Notes"; }
        notes := TextEdit {
            enabled: root.enabled;
            vertical-stretch: 1;
            // Still the field that takes this layout's slack, but no longer
            // the field that pays for all of it: with the transcript below
            // it, an unbounded `notes` collapses to nothing in a 700px
            // window and draws its text over its own caption. The Match
            // panel's event list under this column gives way instead, and it
            // scrolls.
            min-height: 64px;
            text <=> root.notes-text;
            changed has-focus => { root.focus-changed(ClipField.notes, self.has-focus, self.text); }
        }

        // The caption carries the actions, as the Clips list's and the Match
        // panel's do: this column is 280px of a window that may be only
        // 700px tall, and a row of its own for the buttons comes straight
        // out of the Notes box above.
        HorizontalLayout {
            spacing: 6px;
            FieldLabel {
                text: "Transcript";
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            // Which model runs (Phase 10 S3): `small.en` was measured at
            // 0.73x realtime on the reference laptop, so the speed it buys
            // is worth a control. A fixed width, because the row is the
            // tightest in the app and a long name from
            // `$PUNDIT_WHISPER_MODEL` must not push the button out of
            // a 1100px window.
            ComboBox {
                width: 96px;
                model: root.transcript-models;
                // Two-way, so the coach's pick stays on screen (a one-way
                // binding is dropped the first time the popup opens), and
                // `selected` is what tells Rust.
                current-index <=> root.transcript-model;
                enabled: root.enabled && root.transcript-model-enabled;
                selected => { root.transcript-model-chosen(self.current-index); }

                Tooltip {
                    text: root.transcript-model-enabled
                        ? @markdown("Which speech model transcribes: `base.en` is faster, `small.en` more accurate. The clip being transcribed keeps the model it started with.")
                        : @markdown("`$PUNDIT_WHISPER_MODEL` is set, so it is what runs.");
                }
            }
            // **One action, not two.** With the picker beside them, a
            // caption row of [Transcript] [model] [Transcribe] [Cancel] runs
            // 76px past this 280px column at the window's 1100x700 minimum,
            // and Cancel falls off the edge. They are never both live —
            // Transcribe is disabled exactly when Cancel is offered — so the
            // row shows the one that does something, and the line under the
            // box says which state that is.
            //
            // Cancel is beside a waiting clip as much as a running one: the
            // command stops the job in flight *and* drops the queue behind
            // it.
            if root.transcript-state == TranscriptState.queued
                || root.transcript-state == TranscriptState.running: Button {
                text: "Cancel";
                // `CancelTranscription` is not on the recording allow-list,
                // so a click through would be dropped with nothing to show
                // for it.
                enabled: root.enabled;
                clicked => { root.cancel-transcribe-clicked(); }

                Tooltip { text: @markdown("Stop transcribing, and drop what's waiting"); }
            }
            if root.transcript-state != TranscriptState.queued
                && root.transcript-state != TranscriptState.running
                && root.transcribe-download == "": Button {
                text: "Transcribe";
                enabled: root.enabled;
                clicked => { root.transcribe-clicked(); }

                Tooltip { text: @markdown("Write out the commentary recorded over this clip"); }
            }
        }
        // **The download's prompt is the button itself** (Phase 11 S3), and
        // on a row of its own: a caption row that fits "Transcribe" beside
        // the picker has no room for a size, and a prompt that ran off the
        // column's edge would hide the one number it exists to show. The
        // row is there only until the model is -- once, per model.
        if root.transcript-state != TranscriptState.queued
            && root.transcript-state != TranscriptState.running
            && root.transcribe-download != "": Button {
            text: root.transcribe-download;
            enabled: root.enabled;
            clicked => { root.transcribe-clicked(); }

            Tooltip { text: @markdown("The speech model isn't on this computer yet. It is downloaded once, then kept for every clip"); }
        }
        // A fixed height with its own scroll, deliberately: `notes` above
        // already takes this layout's slack, and a second stretchy box would
        // halve both of them.
        transcript := TextEdit {
            enabled: root.enabled;
            height: 88px;
            text <=> root.transcript-text;
            changed has-focus => { root.focus-changed(ClipField.transcript, self.has-focus, self.text); }
        }
        if root.transcript-status != "": Text {
            text: root.transcript-status;
            font-size: 11px;
            wrap: word-wrap;
            color: root.transcript-state == TranscriptState.failed
                ? #ff6b6b
                : Palette.alternate-foreground;
        }

        Button {
            text: root.previewing ? "Close Preview" : "Preview";
            primary: !root.previewing;
            // Closing is always possible; opening needs the bus to be idle.
            enabled: root.previewing || root.can-preview;
            clicked => { root.preview-clicked(); }

            Tooltip {
                text: root.previewing
                    ? @markdown("Close the preview (Esc)")
                    : @markdown("Play this clip as it was recorded");
            }
        }
    }

    // Over the fields below: a sibling of the layout rather than a child of
    // it, so it claims no cell and is drawn last. `TagSuggestions` says why it
    // is placed here and not inside the field.
    if tags.suggesting: TagSuggestions {
        x: tags.x;
        y: tags.y + tags.height + 2px;
        width: tags.width;
        suggestions: tags.suggestions;
        take(tag) => { tags.take(tag); }
    }
}

/// With nothing selected, the inspector's column lists the project's tags
/// (C8). Clicking one filters the Clips list by it, or clears that filter.
component TagOverview inherits VerticalLayout {
    in property <[TagRow]> rows;
    in property <int> clip-count;
    in-out property <string> filter;

    padding: 12px;
    spacing: 8px;

    FieldLabel { text: "Tags"; }
    if root.clip-count == 0: Text {
        text: "No clips yet";
        color: Palette.alternate-foreground;
    }
    if root.clip-count > 0 && root.rows.length == 0: Text {
        text: "No tags yet — add tags to a clip in the inspector.";
        color: Palette.alternate-foreground;
        wrap: word-wrap;
    }
    ListView {
        for row in root.rows: Rectangle {
            height: 40px;
            border-radius: 4px;
            background: row.tag == root.filter || tag-touch.has-hover ? Palette.selection-background : transparent;

            tag-touch := TouchArea {
                clicked => { root.filter = root.filter == row.tag ? "" : row.tag; }
            }
            VerticalLayout {
                padding-left: 6px;
                padding-right: 6px;
                alignment: center;
                spacing: 2px;

                Text {
                    text: row.tag;
                    color: Palette.foreground;
                    overflow: elide;
                }
                Text {
                    text: row.detail;
                    color: Palette.alternate-foreground;
                    font-size: 11px;
                }
            }
        }
    }
}

/// One of a goal row's reel buttons (spec R3): a glyph, as the row's other
/// buttons are, with its name for screen readers and a tooltip.
component ReelButton inherits VerticalLayout {
    in property <string> text;
    in property <string> name;
    in property <styled-text> tip;
    in property <bool> enabled;
    callback clicked();

    alignment: center;
    Button {
        text: root.text;
        width: 28px;
        accessible-label: root.name;
        enabled: root.enabled;
        clicked => { root.clicked(); }

        Tooltip {
            text: root.tip;
        }
    }
}

/// The Match panel (Phase 9 S4), under the inspector's column: the live score
/// and clock, the three tag actions the `z`, `x` and `v` keys also fire, and
/// the tagged events in match order with a seek and a delete each.
///
/// Everything it shows is rendered by `src/main.rs`: the rows from the
/// project, the score and clock from the scan anchor on the 30 Hz tick.
component MatchPanel inherits VerticalLayout {
    /// The project has teams. Without them there is no scoreboard to show,
    /// and the setup sheet is the way in.
    in property <bool> configured;
    /// "Rovers 2 – 1 United", or the two names before kick-off.
    in property <string> score;
    /// "45:00", "45:00 +2:13", "HT", "FT", or a dash before kick-off. Frozen
    /// while a preview is open, whose own scoreboard is in its picture.
    in property <string> clock;
    in property <[MatchRow]> rows;
    /// Tagging is possible: while scanning or recording, never while
    /// previewing or during a recording's start-up (spec S4).
    in property <bool> can-tag;
    /// Every period of the format is tagged already, so another start/stop
    /// would get no role: that action is off and the panel says why (S5).
    in property <bool> at-cap;
    /// A row's buttons: the bus refuses both a seek and a delete while
    /// recording, and the panel doesn't act on the game video behind a
    /// preview.
    in property <bool> can-edit;
    /// How many lines the list has, a goal's row being two: its height.
    in property <int> lines;
    callback tag(MatchTag);
    callback seek(string);
    callback remove(string);
    callback trim(string, ReelTrim);
    callback setup();
    callback edit-events();
    /// Folded away (BACKLOG #113). The header stays and keeps the score and
    /// clock — the line the coach glances at — so folding puts the *rows*
    /// away, not the information.
    in property <bool> expanded: true;
    callback toggle-fold();

    padding: 12px;
    spacing: 6px;

    HorizontalLayout {
        spacing: 8px;
        FoldHeader {
            title: "Match";
            expanded: root.expanded;
            summary: root.configured ? root.score + " · " + root.clock : "";
            toggled => { root.toggle-fold(); }
        }
        // Folded, the buttons go and the summary carries the information: at
        // the column's 280px minimum a chevron, a title, a score, a clock and
        // two buttons do not fit, and both buttons open a sheet anyway.
        if root.expanded: Button {
            text: "Edit events…";
            enabled: root.can-edit;
            clicked => { root.edit-events(); }

            Tooltip {
                text: @markdown("Type or paste match events: one line each, `2 14:05 home goal`");
            }
        }
        if root.expanded: Button {
            text: root.configured ? "Setup…" : "Set up teams…";
            clicked => { root.setup(); }

            Tooltip {
                text: @markdown("Team names, colours and the match format");
            }
        }
    }
    // Folded, only the header above remains (BACKLOG #113).
    if root.expanded: VerticalLayout {
        spacing: 6px;

        if !root.configured: Text {
            text: "No teams yet. The clock and score are drawn into previews and exports once they're set up.";
            color: Palette.alternate-foreground;
            font-size: 11px;
            wrap: word-wrap;
        }
        if root.configured: HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.score;
                color: Palette.foreground;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: root.clock;
                color: Palette.foreground;
                font-family: "monospace";
                vertical-alignment: center;
            }
        }

        Button {
            text: "Home goal  (Z)";
            enabled: root.can-tag;
            clicked => { root.tag(MatchTag.home-goal); }
        }
        Button {
            text: "Away goal  (X)";
            enabled: root.can-tag;
            clicked => { root.tag(MatchTag.away-goal); }
        }
        Button {
            text: "Start / stop  (V)";
            enabled: root.can-tag && !root.at-cap;
            clicked => { root.tag(MatchTag.start-stop); }
        }
        if root.at-cap: Text {
            text: "Every period of this format is tagged. Delete a start/stop, or change the format, to tag another.";
            color: Palette.alternate-foreground;
            font-size: 11px;
            wrap: word-wrap;
        }

        FieldLabel { text: "Events"; }
        if root.rows.length == 0: Text {
            text: "Nothing tagged yet.";
            color: Palette.alternate-foreground;
            font-size: 11px;
        }
        // A height of its own, so a long match scrolls rather than pushing the
        // inspector out of the column.
        ListView {
            height: min(168px, root.lines * 28px);
            for row in root.rows: VerticalLayout {
                HorizontalLayout {
                    height: 28px;
                    spacing: 6px;

                    Text {
                        text: row.time;
                        color: Palette.alternate-foreground;
                        font-family: "monospace";
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: row.label;
                        color: row.role-less ? Palette.alternate-foreground : Palette.foreground;
                        font-size: 11px;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: "→";
                            accessible-label: "Seek";
                            enabled: root.can-edit;
                            clicked => { root.seek(row.id); }

                            Tooltip {
                                text: @markdown("Play the game video from here");
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: "×";
                            accessible-label: "Delete";
                            enabled: root.can-edit;
                            clicked => { root.remove(row.id); }

                            Tooltip {
                                text: @markdown("Delete this event (undoable)");
                            }
                        }
                    }
                }
                // A goal's reel span (R3), on a line of its own: the column has
                // no room for it beside the row. The buttons are glyphs, as the
                // row's are, with their names in the tooltips.
                if row.reel-span != "": HorizontalLayout {
                    height: 28px;
                    spacing: 4px;

                    Text {
                        text: "Reel " + row.reel-span;
                        color: Palette.alternate-foreground;
                        font-size: 11px;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    ReelButton {
                        text: "⇤";
                        name: "Reel starts here";
                        tip: @markdown("Reel starts here: the goal's entry begins at this frame");
                        enabled: root.can-edit;
                        clicked => { root.trim(row.id, ReelTrim.start-here); }
                    }
                    ReelButton {
                        text: "↺";
                        name: "Reset reel start";
                        tip: @markdown("Reset the reel start to the default");
                        enabled: root.can-edit;
                        clicked => { root.trim(row.id, ReelTrim.reset-start); }
                    }
                    ReelButton {
                        text: "⇥";
                        name: "Reel ends here";
                        tip: @markdown("Reel ends here: the goal's entry stops at this frame");
                        enabled: root.can-edit;
                        clicked => { root.trim(row.id, ReelTrim.end-here); }
                    }
                    ReelButton {
                        text: "↺";
                        name: "Reset reel end";
                        tip: @markdown("Reset the reel end to the default");
                        enabled: root.can-edit;
                        clicked => { root.trim(row.id, ReelTrim.reset-end); }
                    }
                }
            }
        }
    }
}

/// One player highlight in the Highlights panel (spec H3): its id, the
/// colour its ring is drawn in and the label on its pill.
export struct HighlightRow {
    id: string,
    ink: color,
    label: string,
}

/// The Highlights panel (spec H3), under the Match panel: the ringed players
/// on the footage, with the selected one's label, its keys and a delete.
///
/// Everything it acts on goes through the bus, as the Match panel's rows do.
/// Its edits are off while recording, where only *placing* a key is allowed:
/// a coach mid-take can mark a player but not recolour or delete one.
component HighlightsPanel inherits VerticalLayout {
    in property <[HighlightRow]> rows;
    /// The selected highlight's id, empty for none. A drag on a ring selects
    /// it, and so does a click on a row.
    in property <string> selected;
    /// The H tool is on, which is what the panel tells the coach how to use.
    in property <bool> tool-on;
    /// Edits are possible: not while recording, and not with nothing loaded.
    in property <bool> can-edit;
    /// The displayed frame carries one of the selected highlight's keys, so
    /// "Delete key here" has something to remove.
    in property <bool> key-here;
    /// The selected highlight's label, two-way as the inspector's fields are:
    /// a `text:` binding breaks the first time it's typed in.
    in-out property <string> label-text;

    callback select(string);
    callback remove(string);
    /// "Delete key here": the key on the frame on screen.
    callback delete-key(string);
    callback begin-edit();
    callback commit(string);
    callback end-edit(string);

    padding: 12px;
    spacing: 6px;

    FieldLabel { text: "Highlights"; }

    if root.rows.length == 0: Text {
        text: root.tool-on
            ? "Pause the game video and drag a box around a player."
            : "Press H, pause, and drag a box around a player to ring them.";
        color: Palette.alternate-foreground;
        font-size: 11px;
        wrap: word-wrap;
    }

    for row in root.rows: VerticalLayout {
        spacing: 4px;

        Rectangle {
            height: 28px;
            border-radius: 4px;
            background: row.id == root.selected ? Palette.selection-background : transparent;

            // The whole row selects; the delete button in front takes its
            // own clicks.
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.select(row.id); }
            }

            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                spacing: 6px;

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: row.ink;
                        // The strokes' own dark edge, so white and yellow hold.
                        border-width: 1px;
                        border-color: #00000066;
                    }
                }
                Text {
                    text: row.label == "" ? "Unlabelled" : row.label;
                    color: row.label == "" ? Palette.alternate-foreground : Palette.foreground;
                    font-size: 11px;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: "×";
                        accessible-label: "Delete";
                        enabled: root.can-edit;
                        clicked => { root.remove(row.id); }

                        Tooltip {
                            text: @markdown("Delete this highlight (undoable)");
                        }
                    }
                }
            }
        }

        // The selected row's own controls: the label its pill shows, and the
        // key on the frame the coach is looking at.
        if row.id == root.selected: VerticalLayout {
            spacing: 4px;

            // Named for `tests/ui/text_editing.rs`: this one used to be folded
            // in through a flag the panel kept (`editing`, `label-focused`),
            // and it is the field that is hardest to reach, inside the `if`
            // under the selected row.
            label-edit := LineEdit {
                enabled: root.can-edit;
                placeholder-text: "Shirt number or name";
                text <=> root.label-text;
                accepted(text) => { root.commit(text); }
                changed has-focus => {
                    if (self.has-focus) {
                        root.begin-edit();
                    } else {
                        root.end-edit(self.text);
                    }
                }
            }
            Button {
                text: "Delete key here";
                enabled: root.can-edit && root.key-here;
                clicked => { root.delete-key(row.id); }

                Tooltip {
                    text: @markdown("Remove this player's key on the frame on screen. Their last key deletes the highlight.");
                }
            }
        }
    }
}

/// A live stroke: its commands, in the content rect's logical pixels, and
/// the colour of the pen it was drawn with.
export struct LiveStroke {
    commands: string,
    ink: color,
    /// The arrowhead's closed triangle, empty when the stroke has none
    /// (BACKLOG #117). Built in Rust from `core::stroke::arrow_head` — the same
    /// function the export's overlay draws from, so the two cannot drift.
    arrow: string,
}

/// One player highlight on the live picture (spec H5), as
/// `src/highlight_view.rs` builds it: the ring's commands and the pill's
/// anchor, both in content-rect logical pixels.
export struct LiveHighlight {
    commands: string,
    ink: color,
    label: string,
    label-ink: color,
    label-x: length,
    label-y: length,
    font-size: length,
    label-pad: length,
    pill-height: length,
}

/// One pass of a live telestration stroke (Phase 6 D5). Its `commands` are in
/// the content rect's logical pixels, which `fit: preserve` takes as they
/// are: it short-circuits before any bounding-box or stroke-width fitting, so
/// no viewbox is needed.
///
/// `fill` stays unset on purpose: a fill on an open polyline fills the area
/// the line encloses.
component StrokePass inherits Path {
    width: 100%;
    height: 100%;
    fit: preserve;
    // Round caps also make a single point (`M x y L x y`) a dot.
    stroke-line-cap: round;
    stroke-line-join: round;
}

/// One live stroke, on the thin dark edge export and preview draw under it
/// (the overlay's `draw_strokes`): the edge, then the line over it, so only
/// the edge's rim shows. The caller sets `commands` and `ink`.
component StrokePath inherits Rectangle {
    in property <string> commands;
    /// The arrowhead's closed triangle; empty draws nothing, so it needs no
    /// `if` (BACKLOG #117).
    in property <string> arrow;
    in property <color> ink;
    /// `core::layout::STROKE_LINE_WIDTH`, a fraction of the picture's height:
    /// the one pen width, handed in from Rust rather than written here, so a
    /// live line is exactly the line export burns in. `root` is the content
    /// rect, by the 100% below.
    in property <float> line-width;
    width: 100%;
    height: 100%;

    // Exactly the overlay's `STROKE_EDGE_RATIO` (a quarter of the line a
    // side, so 1.5 lines across) and `STROKE_EDGE_ALPHA` (black at 80%).
    StrokePass {
        commands: root.commands;
        stroke: #000000cc;
        stroke-width: root.height * root.line-width * 1.5;
    }
    StrokePass {
        commands: root.commands;
        stroke: root.ink;
        stroke-width: root.height * root.line-width;
    }
    // The head is **filled**, where the line is stroked, so it cannot reuse
    // `StrokePass`. One element rather than two passes: Slint fills before it
    // strokes, so the dark outline lands over the fill's own edge and the rim
    // that shows outside is half the stroke — a quarter of a line, which is the
    // overlay's `STROKE_EDGE_RATIO` and the same rim the line carries.
    Path {
        commands: root.arrow;
        width: 100%;
        height: 100%;
        fit: preserve;
        fill: root.ink;
        stroke: #000000cc;
        stroke-width: root.height * root.line-width * 0.5;
    }
}

/// A player highlight's label on the live picture: a pill of the highlight's
/// own colour (spec H4), centred on `anchor-x` and with its top at
/// `anchor-y`.
///
/// **Everything but the width is decided in Rust** — the font, the padding,
/// the pill's height, its y (above the box, or below it where there is no
/// room) and the ink that can be read on it all arrive as properties from
/// `core::highlight`'s shape, which is what the export overlay draws from
/// too. The width is the one thing only a text shaper knows, so it is settled
/// here and the x clamped here, where it is finally known: a ring at either
/// edge keeps its number on the picture instead of half of it. The overlay's
/// pill may come out a pixel or two wider — a different shaper — and that is
/// fine, since the number sits in the same place either way.
component HighlightLabel inherits Rectangle {
    in property <string> label;
    in property <color> ink;
    in property <color> label-ink;
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <length> font-size;
    in property <length> label-pad;
    in property <length> pill-height;
    /// The content rect's width, which is what the pill is kept inside.
    in property <length> content-width;

    visible: root.label != "";
    x: max(0px, min(root.anchor-x - self.width / 2, root.content-width - self.width));
    y: root.anchor-y;
    width: line.width + root.label-pad * 2;
    height: root.pill-height;
    border-radius: self.height / 2;
    background: root.ink;

    line := Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: root.label;
        font-size: root.font-size;
        font-weight: 700;
        color: root.label-ink;
    }
}

/// A row of the export sheet's target list: its tick, what it covers and how
/// long that runs. A click anywhere on the row ticks or unticks it.
component TargetChoice inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> ticked;
    in property <bool> enabled: true;
    callback clicked();

    height: 30px;
    border-radius: 4px;
    background: root.enabled && touch.has-hover ? Palette.selection-background : transparent;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 8px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 15px;
                height: 15px;
                border-radius: 3px;
                border-width: 1px;
                border-color: Palette.border;
                background: root.ticked ? Palette.accent-background : transparent;

                Text {
                    text: root.ticked ? "✓" : "";
                    color: Palette.accent-foreground;
                    font-size: 11px;
                }
            }
        }
        Text {
            text: root.label;
            color: root.enabled ? Palette.foreground : Palette.alternate-foreground;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.detail;
            color: Palette.alternate-foreground;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}

/// What every modal in this app sits on: the window behind dimmed, and a
/// `TouchArea` that swallows the clicks meant for it.
///
/// **Its one child is the sheet, and this column is what caps the sheet's
/// height** (BACKLOG #134). A `Sheet` states its content height as its
/// *preferred* height rather than as `height`, so a layout is the thing that
/// can say "no taller than this": Slint's box layout hands a cell its
/// preferred size while there is room and shrinks it past that the moment
/// there is not (`solve_box_layout`), and the sheet scrolls whatever is left
/// over. A plain `@children` could not -- a sized child of a `Rectangle` takes
/// the size it asks for, window or no window, which is how Export and Cancel
/// came to sit off the bottom of a 700px window.
///
/// `center` on both axes is the centring that child used to get for free, and
/// the padding is the card's own 20px, so a capped sheet still shows the scrim
/// it sits on rather than running into the window's edges.
component Scrim inherits Rectangle {
    background: #000000a0;

    TouchArea { }

    VerticalLayout {
        alignment: center;
        cross-axis-alignment: center;
        padding: 20px;

        @children
    }
}

/// The card every modal in this app is drawn as: a fixed width, a height of
/// whatever it holds **up to the window's**, the house chrome and the heading.
///
/// There are seven of these -- export, the basket, New match, match setup, the
/// match event editor, Keys and the error dialog -- and this is the one shape
/// they are. A sheet sets its width and its title and lays its own body out as
/// children;
/// everything else is here, once.
///
/// **The body scrolls, and that is the whole of BACKLOG #134.** The card asks
/// for its content's height and accepts less: [`Scrim`]'s column is what hands
/// it `min(content, window)`, and what does not fit is scrolled rather than
/// drawn off the bottom of the window. Measured at the declared 1100x700
/// minimum, two of the six sheets did not fit -- the export sheet reopened over
/// a run (823px) and New match with twenty videos (704px) -- and #96's keys
/// sheet is 29 rows.
///
/// **A sheet's own action buttons scroll with it**, because each sheet puts
/// its button row in `@children` like any other content. So Export can be one
/// flick away rather than on screen, which is the trade this takes: a pinned
/// footer would need a second child slot here and an edit to all six sheets,
/// and "the buttons are one flick away" is strictly better than "the buttons
/// are unreachable". The title scrolls with the body for the same kind of
/// reason: keeping it out of the scroll means a second layout here whose
/// preferred height has to be re-derived by hand, where this way the card's
/// natural height stays exactly the `body.preferred-height` it always was and
/// only the cap is new.
component Sheet inherits Rectangle {
    /// The card's width. Wide enough for the widest thing in it, and no
    /// wider: the height follows the content.
    in property <length> card-width;
    /// The heading, in the one size and weight the sheets use. Empty for a
    /// sheet with no heading -- the error dialog, whose text is its own.
    in property <string> title;
    /// The body's row spacing, for the one sheet that wants more air.
    in property <length> body-spacing: 10px;

    width: root.card-width;
    // What the card wants, and the most it may have. Never `height`: an
    // explicit one is fixed in `Scrim`'s layout and could not be capped.
    preferred-height: body.preferred-height;
    max-height: body.preferred-height;
    background: Palette.background;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;

    ScrollView {
        body := VerticalLayout {
            padding: 20px;
            spacing: root.body-spacing;

            if root.title != "": Text {
                text: root.title;
                color: Palette.foreground;
                font-size: 16px;
                font-weight: 600;
            }

            @children
        }
    }
}

/// The export sheet (Phase 8 E8), the **only** export UI: what to render, at
/// what size and quality, and how the run is going. The window opens it; it
/// reports ticks, Export, Cancel and Close.
///
/// A run goes on behind a closed sheet, and reopening it shows where that run
/// has got to: the rows come from the bus's events, not from the sheet.
component ExportSheet inherits Sheet {
    in property <[TargetRow]> targets;
    /// Something is ticked, so there is something to export.
    in property <bool> any-ticked;
    /// The run in progress, one row per target; empty before the first.
    in property <[RunRow]> run;
    /// "Finishes at 3:42 PM", empty until the rate is steady (spec E5).
    in property <string> finish;
    /// A run is going: the targets and the pickers are settled for it.
    in property <bool> exporting;
    /// 720p or 1080p, and Low / Medium / High: the pickers' indices.
    in-out property <int> resolution;
    in-out property <int> quality;
    /// How the scoreboard is carried: 0 Default (the target's own), 1 burned
    /// into the picture, 2 a separate track (spec M1).
    in-out property <int> scoreboard;
    /// Drop the game video's sound and keep the commentary (spec M1). Stored
    /// as a level, so a slider later is this property widening and no format
    /// change; here it is a switch.
    in-out property <bool> mute-source;
    /// Write the chapters: the `chpl` box **inside** the file and the
    /// `.chapters.txt` beside it, which ride one switch because the in-file
    /// half is the one the coach can't see (spec S1).
    in-out property <bool> chapters;
    /// Write the scoreboard as subtitles: the `.srt` beside the file and the
    /// `tx3g` track inside a copy, one switch for the same reason (spec S1).
    in-out property <bool> cues;
    /// The whole match is ticked, and so the run may copy rather than
    /// re-encode. `src/main.rs` owns it, beside the ticks themselves.
    in property <bool> whole-match-ticked;
    /// **This run would copy rather than re-encode**, which both lines under
    /// the picker are about. Only the whole match is ever copied, so its tick
    /// is the first term; the board then has to be going anywhere but into the
    /// picture, which under "Default" depends on the subtitles too — with them
    /// off a copy would carry no board anywhere, so Default burns it in
    /// instead (spec S4). One property rather than the same boolean written
    /// into two `if`s.
    property <bool> would-copy: root.whole-match-ticked
        && (root.scoreboard == 2 || (root.scoreboard == 0 && root.cues));
    callback tick(int, bool);
    callback start();
    callback cancel();
    callback close();

    card-width: 480px;
    title: "Export";

    FieldLabel { text: "What to export"; }
    // A height of its own: a project with many tags scrolls the list
    // rather than growing the sheet past the window.
    ListView {
        height: min(210px, max(30px, root.targets.length * 30px));
        for row[index] in root.targets: TargetChoice {
            label: row.label;
            detail: row.detail;
            ticked: row.ticked;
            enabled: !root.exporting;
            clicked => { root.tick(index, !row.ticked); }
        }
    }

    HorizontalLayout {
        spacing: 16px;

        VerticalLayout {
            spacing: 4px;
            FieldLabel { text: "Resolution"; }
            ComboBox {
                // 2160p is in the project format but not offered (E8).
                model: ["720p", "1080p"];
                enabled: !root.exporting;
                current-index <=> root.resolution;
            }
        }
        VerticalLayout {
            spacing: 4px;
            FieldLabel { text: "Quality"; }
            ComboBox {
                model: ["Low", "Medium", "High"];
                enabled: !root.exporting;
                current-index <=> root.quality;
            }
        }
    }

    // Its own row rather than a third column: "Burned into the picture"
    // doesn't fit a third of this sheet.
    VerticalLayout {
        spacing: 4px;
        FieldLabel { text: "Scoreboard"; }
        ComboBox {
            model: ["Default", "Burned into the picture", "Separate track"];
            enabled: !root.exporting;
            current-index <=> root.scoreboard;
        }
        // The only place the trade is spelled out, and it follows the
        // **effective** mode rather than the picked one: the whole match
        // is copied on Default too, and a coach told nothing has taken
        // the trade without being asked (spec M1, N). `would-copy` is
        // the effective reading, subtitles included.
        if root.would-copy: Text {
            text: "The whole match is copied, not re-encoded: player highlights and pen drawings can't ride a copy.";
            color: Palette.alternate-foreground;
            font-size: 11px;
            wrap: word-wrap;
        }
        // **The one combination where what you asked for and what you get
        // look nothing alike** (spec S4), so it is said before the run
        // rather than found in `exports/`. Deterministic, and that is why
        // it can be stated flatly: *Separate track* chosen **by hand**
        // refuses rather than falling back, where "Default" with the
        // subtitles off burns the board in and so reaches neither line.
        if root.whole-match-ticked && root.scoreboard == 2 && !root.cues: Text {
            text: "This export carries no scoreboard at all: not in the picture, not beside the file, not inside it.";
            color: Palette.alternate-foreground;
            font-size: 11px;
            wrap: word-wrap;
        }
    }

    // **What the run leaves on disk** (spec S1, #78). Their own rows for the
    // picker's reason — a 480px card has no fourth column — and each label
    // says **both** halves the switch governs, because the coach can only
    // see one of them: "Chapters" alone reads as the file beside the video.
    CheckBox {
        text: "Chapters, in the file and as a list beside it";
        enabled: !root.exporting;
        checked <=> root.chapters;

        Tooltip {
            text: @markdown("The chapter marks inside the video and the pasteable `.chapters.txt` beside it. YouTube can't read the ones inside, so the list is how they reach a video anyone watches there.");
        }
    }

    CheckBox {
        text: "Scoreboard subtitles — an .srt beside the file, and a track inside a copy";
        enabled: !root.exporting;
        checked <=> root.cues;

        Tooltip {
            text: @markdown("The score and the match clock as subtitles. With this off the scoreboard appears only where it is burned into the picture.");
        }
    }

    // **Source audio**, which is what this codebase calls the game video
    // throughout, and the commentary is deliberately untouched (spec M1).
    CheckBox {
        text: "Mute source audio";
        enabled: !root.exporting;
        checked <=> root.mute-source;

        Tooltip {
            text: @markdown("Drop the game video's sound. Your commentary is kept -- but a whole match or a goals reel has none, so it comes out silent.");
        }
    }

    if root.run.length > 0: FieldLabel { text: "Run"; }
    if root.run.length > 0: ListView {
        height: min(140px, root.run.length * 28px);
        for row in root.run: HorizontalLayout {
            height: 28px;
            padding-left: 6px;
            padding-right: 6px;
            spacing: 8px;

            Text {
                text: row.label;
                color: Palette.foreground;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            // Only while it renders; the status word stands in otherwise.
            if row.rendering: VerticalLayout {
                alignment: center;
                ProgressIndicator {
                    width: 120px;
                    progress: row.progress;
                }
            }
            Text {
                text: row.status;
                color: Palette.alternate-foreground;
                font-size: 11px;
                vertical-alignment: center;
                horizontal-alignment: right;
                min-width: 64px;
            }
        }
    }
    // The one rendering of the estimate (E5): when the run ends, not how
    // much of it is left.
    if root.finish != "": Text {
        text: root.finish;
        color: Palette.alternate-foreground;
        font-size: 11px;
    }

    HorizontalLayout {
        alignment: end;
        spacing: 8px;

        if root.exporting: Button {
            text: "Cancel export";
            clicked => { root.cancel(); }

            Tooltip {
                text: @markdown("Stop the run. The videos already written are kept.");
            }
        }
        Button {
            text: "Close";
            clicked => { root.close(); }
        }
        if !root.exporting: Button {
            text: "Export";
            primary: true;
            enabled: root.any-ticked;
            clicked => { root.start(); }
        }
    }
}

/// The basket sheet (basket spec U3): the pieces gathered across matches,
/// what the film they make is called, and how its run is going.
///
/// A `Sheet` at 520px -- the setup sheet's width, because the widest thing in
/// it is a row's match beside its clip name -- and **no fifth panel shape**.
///
/// It renders what it is handed and keeps nothing: the pieces are
/// `Event::Basket`'s and the run row is `Event::Export`'s, for the export
/// sheet's own reason -- a sheet holding its own copy can be left standing on
/// a state the bus has moved past.
component BasketSheet inherits Sheet {
    in property <[BasketPieceRow]> pieces;
    /// The run in progress, one row; empty before the first.
    in property <[RunRow]> run;
    /// The one run the app has is **this sheet's**. Without it an ordinary
    /// export going on behind the sheet would be drawn here as though Start
    /// had started it.
    in property <bool> basket-run;
    /// "Finishes at 3:42 PM", empty until the rate is steady.
    in property <string> finish;
    /// A run is going -- this sheet's or another's. The pickers and Start are
    /// settled for it either way, since the bus refuses a second run.
    in property <bool> exporting;
    /// Refusals, and the file a finished run wrote (basket spec C6). The
    /// status bar's notice renders *behind* the scrim, so a sheet with
    /// commands of its own needs a line.
    in property <string> message;
    /// The film's name. Two-way all the way out to the window as every field
    /// in this app is: a `text:` binding breaks the moment it is typed in.
    in-out property <string> name;
    /// 720p or 1080p, and Low / Medium / High: the pickers' indices, the
    /// export sheet's own two.
    in-out property <int> resolution;
    in-out property <int> quality;
    /// Drop each piece's game sound and keep its commentary -- the export
    /// sheet's own switch, remembered in `basket.json` beside the pickers
    /// (spec M3). A basket is clips from several matches, so commentary-only
    /// is its natural film.
    in-out property <bool> mute-source;
    /// A row moved: from this index to that one.
    callback reorder(int, int);
    callback remove(int);
    callback clear();
    callback start();
    callback cancel();
    callback close();

    card-width: 520px;
    title: "Basket";

    if root.pieces.length == 0: Text {
        text: "Nothing gathered yet. Right-click a clip and choose \"Add to basket\" — in as many projects as you like, and they wait here until you press Start.";
        color: Palette.alternate-foreground;
        font-size: 11px;
        wrap: word-wrap;
    }
    // A height of its own, in the house idiom: twenty pieces scroll rather
    // than growing the sheet past the window.
    if root.pieces.length > 0: ListView {
        height: min(280px, root.pieces.length * 30px);
        for piece[index] in root.pieces: Rectangle {
            height: 30px;

            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                spacing: 6px;

                // ↑ and ↓, not a drag: the clip list's `DragArea` /
                // `DropArea` machinery is real, and a five-row modal list
                // does not earn a second copy of it (basket spec U6).
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: "↑";
                        accessible-label: "Move up";
                        enabled: index > 0 && !root.exporting;
                        clicked => { root.reorder(index, index - 1); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: "↓";
                        accessible-label: "Move down";
                        enabled: index < root.pieces.length - 1 && !root.exporting;
                        clicked => { root.reorder(index, index + 1); }
                    }
                }
                Text {
                    text: piece.match-label;
                    // A piece that can't be resolved is the whole row greyed,
                    // not one cell of it.
                    color: piece.problem == "" ? Palette.foreground : Palette.alternate-foreground;
                    font-size: 11px;
                    overflow: elide;
                    vertical-alignment: center;
                    min-width: 120px;
                }
                // The clip, or the short reason there isn't one. A row with
                // a problem has no clip name to lose -- the bus leaves it
                // empty precisely because it could not find the clip -- and
                // the *long* form of the reason, the one that names the
                // folder, is Start's refusal (basket spec V6), which lands on
                // the message line below.
                Text {
                    text: piece.problem == "" ? piece.clip-label : piece.problem;
                    color: piece.problem == "" ? Palette.foreground : Palette.alternate-foreground;
                    font-size: 11px;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: piece.length;
                    color: Palette.alternate-foreground;
                    font-size: 11px;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    min-width: 36px;
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: "×";
                        accessible-label: "Remove";
                        enabled: !root.exporting;
                        clicked => { root.remove(index); }
                    }
                }
            }
        }
    }
    // **What the rows above don't know.** A piece's footage is resolved at
    // Start, not per row: a row is a reference and a length, and building a
    // plan for each one to find its game video would be the sheet doing the
    // run's work every time it opens (basket spec C4, V1). So a row that
    // looks clean can still be refused, and this says where that lands.
    if root.pieces.length > 0: Text {
        text: "Start checks each piece's video and recording; anything missing is reported below.";
        color: Palette.alternate-foreground;
        font-size: 11px;
        wrap: word-wrap;
    }

    // On a row of its own rather than a third column, as the export sheet's
    // Scoreboard picker is: three of these abreast overflow the card.
    VerticalLayout {
        spacing: 4px;
        FieldLabel { text: "Name"; }
        // Named for `tests/ui/text_editing.rs`, which types into it and
        // presses Esc in it: it is the field whose Esc cascade used to need a
        // flag of its own.
        basket-name-edit := LineEdit {
            // What an empty name becomes, so what the coach sees is what they
            // get (basket spec O1).
            placeholder-text: "Basket";
            enabled: !root.exporting;
            text <=> root.name;
        }
    }

    HorizontalLayout {
        spacing: 16px;

        VerticalLayout {
            spacing: 4px;
            FieldLabel { text: "Resolution"; }
            ComboBox {
                // 2160p is in the project format but not offered, as the
                // export sheet has it.
                model: ["720p", "1080p"];
                enabled: !root.exporting;
                current-index <=> root.resolution;
            }
        }
        VerticalLayout {
            spacing: 4px;
            FieldLabel { text: "Quality"; }
            ComboBox {
                model: ["Low", "Medium", "High"];
                enabled: !root.exporting;
                current-index <=> root.quality;
            }
        }
    }

    CheckBox {
        text: "Mute source audio";
        enabled: !root.exporting;
        checked <=> root.mute-source;

        Tooltip {
            text: @markdown("Drop every piece's game sound and keep its commentary.");
        }
    }

    if root.basket-run && root.run.length > 0: FieldLabel { text: "Run"; }
    if root.basket-run && root.run.length > 0: HorizontalLayout {
        height: 28px;
        padding-left: 6px;
        padding-right: 6px;
        spacing: 8px;

        Text {
            text: root.run[0].label;
            color: Palette.foreground;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        // Only while it renders; the status word stands in otherwise.
        if root.run[0].rendering: VerticalLayout {
            alignment: center;
            ProgressIndicator {
                width: 120px;
                progress: root.run[0].progress;
            }
        }
        Text {
            text: root.run[0].status;
            color: Palette.alternate-foreground;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-alignment: right;
            min-width: 64px;
        }
    }
    if root.basket-run && root.finish != "": Text {
        text: root.finish;
        color: Palette.alternate-foreground;
        font-size: 11px;
    }
    if root.message != "": Text {
        text: root.message;
        color: Palette.alternate-foreground;
        font-size: 11px;
        wrap: word-wrap;
    }

    HorizontalLayout {
        alignment: end;
        spacing: 8px;

        // First, and two buttons clear of Start: it is the one control here
        // with no undo.
        Button {
            text: "Clear";
            enabled: root.pieces.length > 0 && !root.exporting;
            clicked => { root.clear(); }

            Tooltip {
                text: @markdown("Empty the basket. There is no undo -- but nothing is lost: every clip is still in its own project.");
            }
        }
        if root.exporting && root.basket-run: Button {
            text: "Cancel export";
            clicked => { root.cancel(); }

            Tooltip {
                text: @markdown("Stop the run. Nothing is written, and the basket is left as it is.");
            }
        }
        Button {
            text: "Close";
            clicked => { root.close(); }
        }
        // Start leaves the basket alone: the coach may re-run at another
        // resolution, or add a ninth piece and run again (basket spec U8).
        // A piece that can't be resolved is not greyed out here -- the
        // refusal names it, which is more use than a dead button.
        if !root.exporting: Button {
            text: "Start";
            primary: true;
            enabled: root.pieces.length > 0;
            clicked => { root.start(); }
        }
    }
}

/// One field of the match setup sheet: its caption, a mark when what's typed
/// isn't something the sheet can save, and the swatch a colour field shows.
///
/// The text is two-way bound all the way out to the window's property: a
/// `text:` binding breaks the moment the user types into it.
component SetupField inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <bool> ok: true;
    /// A colour field shows what its text parses to, beside the caption, and
    /// the swatch is the way in to the picker.
    in property <bool> has-swatch;
    in property <color> swatch;
    in-out property <string> text;
    /// The swatch was clicked: open the picker over this field. It carries
    /// this field's bottom-left corner, in window coordinates, so the sheet
    /// hangs the popup where the click was rather than off a table of which
    /// field is which.
    callback pick(length, length);
    /// The field was **typed into**, as against changed. The New match sheet's
    /// folder name stops being re-derived from the two team names on the first
    /// keystroke, and a `changed text` handler could not tell the two apart: it
    /// would fire when the derivation wrote the field and kill the derivation
    /// on the first letter of a team name. The setup sheet passes nothing.
    callback edited();

    spacing: 2px;

    HorizontalLayout {
        spacing: 4px;
        FieldLabel {
            text: root.label;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if !root.ok: Text {
            text: "✕";
            color: #ff6b6b;
            font-size: 11px;
            vertical-alignment: center;
        }
        if root.has-swatch: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 3px;
                border-width: 1px;
                // Lit on hover: without it the swatch reads as the preview it
                // used to be, and the picker behind it is never found.
                border-color: touch.has-hover ? Palette.foreground : Palette.border;
                background: root.swatch;

                touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.pick(root.absolute-position.x,
                            root.absolute-position.y + root.height);
                    }
                }
                Tooltip { text: @markdown("Pick a colour"); }
            }
        }
    }
    edit := LineEdit {
        placeholder-text: root.placeholder;
        text <=> root.text;
        edited(text) => { root.edited(); }
    }
}

/// The colour picker the setup sheet's swatches open: a row of ready-made kit
/// colours for the coach who doesn't know the club's hex codes, then a hue
/// strip and a saturation/brightness area for anything else. **The hex box is
/// not in here** -- it is the field's own, still in the sheet above, so there
/// is only ever one place an exact code is typed.
///
/// **No colour maths here.** Every colour it draws and every colour it
/// reports goes through `src/color_picker.rs` (`hex-of-hsv`) and
/// `match_panel::parse_hex` (`hex-color`): what the project stores is the hex
/// string, so the picker has to land on exactly those bytes. Slint's own
/// `Colors.hsv` would be a second rounding, and then the swatch, the field
/// and the scoreboard could disagree in the last bit.
component ColorPicker inherits Rectangle {
    in property <[KitColor]> kit-colors;
    /// Where the picker is standing. The hue is held by the sheet rather than
    /// read back out of the hex: grey has none (see `sync-from-text`).
    in property <float> hue;
    in property <float> sat;
    in property <float> val;
    pure callback hex-color(string) -> color;
    pure callback hex-of-hsv(float, float, float) -> string;
    /// A ready-made colour, taken as it stands.
    callback pick(string);
    /// A point in the area or on the strip, as hue / saturation / brightness.
    callback take(float, float, float);

    property <length> swatch-size: 20px;
    /// The strip and the area are as wide as the row of kit colours, so the
    /// three controls line up without a number written twice.
    property <length> span: root.kit-colors.length * (root.swatch-size + 2px) - 2px;

    width: body.preferred-width;
    height: body.preferred-height;
    background: Palette.background;
    border-radius: 6px;
    border-width: 1px;
    border-color: Palette.border;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000099;

    // Swallows whatever misses a control, so the backdrop behind can't close
    // the popup from under the pointer.
    TouchArea { }

    body := VerticalLayout {
        padding: 10px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 2px;
            for kit in root.kit-colors: Rectangle {
                width: root.swatch-size;
                height: root.swatch-size;
                border-radius: 3px;
                // The pen swatches' dark rim, so white and gold hold against
                // the popup behind them.
                border-width: 1px;
                border-color: #00000066;
                background: root.hex-color(kit.hex);

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.pick(kit.hex); }
                }
                Tooltip { text: @markdown("\{kit.name}"); }
            }
        }

        // Saturation across, brightness down, over the strip's hue: the two
        // gradients are the standard pair, white washing out to the right and
        // black coming up from the bottom.
        Rectangle {
            width: root.span;
            height: 110px;
            border-radius: 3px;
            background: root.hex-color(root.hex-of-hsv(root.hue, 1, 1));

            Rectangle {
                border-radius: 3px;
                background: @linear-gradient(90deg, #ffffff 0%, #ffffff00 100%);
            }
            Rectangle {
                border-radius: 3px;
                background: @linear-gradient(180deg, #00000000 0%, #000000 100%);
            }
            Rectangle {
                x: root.sat * parent.width - self.width / 2;
                y: (1 - root.val) * parent.height - self.height / 2;
                width: 12px;
                height: 12px;
                border-radius: self.width / 2;
                border-width: 2px;
                border-color: #ffffff;

                // A dark rim inside the white one, so the marker is visible
                // over the white corner as well as the black one.
                Rectangle {
                    border-radius: self.width / 2;
                    border-width: 1px;
                    border-color: #00000099;
                }
            }
            area := TouchArea {
                mouse-cursor: crosshair;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down
                        && event.button == PointerEventButton.left) {
                        root.take-area();
                    }
                }
                // Only while a button is down; `pressed` is the primary one.
                // The pointer is grabbed on press, so this keeps arriving off
                // the rectangle -- `take-area` clamps to its edge.
                moved => { if (self.pressed) { root.take-area(); } }
            }
        }

        Rectangle {
            width: root.span;
            height: 14px;
            border-radius: 3px;
            background: @linear-gradient(90deg,
                #ff0000 0%, #ffff00 16.7%, #00ff00 33.3%, #00ffff 50%,
                #0000ff 66.7%, #ff00ff 83.3%, #ff0000 100%);

            Rectangle {
                x: root.hue / 360 * parent.width - self.width / 2;
                y: -3px;
                width: 8px;
                height: parent.height + 6px;
                border-radius: 4px;
                border-width: 2px;
                border-color: #ffffff;
            }
            strip := TouchArea {
                mouse-cursor: pointer;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down
                        && event.button == PointerEventButton.left) {
                        root.take-hue();
                    }
                }
                moved => { if (self.pressed) { root.take-hue(); } }
            }
        }
    }

    /// The pointer in the area, as a colour. Clamped, because Slint grabs the
    /// pointer on press: a drag that leaves the rectangle should pin to its
    /// edge rather than run off the end of the scale.
    function take-area() {
        root.take(root.hue,
            Math.min(1, Math.max(0, area.mouse-x / area.width)),
            Math.min(1, Math.max(0, 1 - area.mouse-y / area.height)));
    }

    /// The pointer on the strip, as a hue. Saturation and brightness stay put
    /// -- the strip only turns the colour round.
    function take-hue() {
        root.take(Math.min(360, Math.max(0, strip.mouse-x / strip.width * 360)),
            root.sat, root.val);
    }
}

/// The match setup sheet (Phase 9 S4): both teams with their three colours,
/// the match format, and the back-anchor -- "my video starts after kick-off".
///
/// Each colour is a hex field **and** a swatch that opens [`ColorPicker`]:
/// the exact code for the coach who has it, a kit colour or a drag for
/// everyone else. The field is what the two agree on, so picking writes the
/// hex and typing a hex moves the picker. Nothing here is an undo step: the
/// sheet has Cancel, and the history is the coach's tagging (spec S5).
component MatchSetupSheet inherits Rectangle {
    in-out property <string> home-name;
    in-out property <string> home-primary;
    in-out property <string> home-secondary;
    in-out property <string> home-font;
    in-out property <string> away-name;
    in-out property <string> away-primary;
    in-out property <string> away-secondary;
    in-out property <string> away-font;
    in-out property <string> regulation-periods;
    in-out property <string> regulation-minutes;
    in-out property <string> overtime-periods;
    in-out property <string> overtime-minutes;
    in-out property <bool> back-anchor;
    /// The picker's ready-made colours (`src/color_picker.rs`).
    in property <[KitColor]> kit-colors;
    /// Which colour field the picker is open over -- -1 for closed, else the
    /// order the columns read: home primary, accent, text, then away's.
    ///
    /// **The window owns it**, so its Esc can close the popup before it
    /// closes the sheet, and so `close-match-setup` can't leave a stale one
    /// showing the next time the sheet opens.
    in-out property <int> picker-field;
    /// The window's validators. They take the text so the bindings below
    /// re-evaluate on every keystroke.
    pure callback hex-color(string) -> color;
    /// The picker's two conversions, both Rust's (`src/color_picker.rs`):
    /// there is one hex-to-colour path in this app and this is it.
    pure callback hsv-of-hex(string) -> Hsv;
    pure callback hex-of-hsv(float, float, float) -> string;
    pure callback valid-name(string) -> bool;
    pure callback valid-hex(string) -> bool;
    /// One per numeric field: each knows its own range, which lives in
    /// `match_panel.rs` beside the parse that builds the config, so a field
    /// can't be marked good and then refuse to save.
    pure callback valid-periods(string) -> bool;
    pure callback valid-overtime-periods(string) -> bool;
    pure callback valid-minutes(string) -> bool;
    /// The warning for start/stops the format being typed has no period for,
    /// empty when there are none. The back-anchor goes in because its derived
    /// start takes a period: ticking the box moves the warning.
    pure callback over-cap(string, string, bool) -> string;
    callback save();
    callback cancel();

    /// Every field good. The empty-name rule is the command's (S5); Save is
    /// off here so the coach isn't answered with a dialog on a name that is
    /// only spaces -- which is what the command sees, since the field's text
    /// is trimmed.
    property <bool> can-save:
        root.valid-name(root.home-name) && root.valid-name(root.away-name)
        && root.valid-hex(root.home-primary) && root.valid-hex(root.home-secondary)
        && root.valid-hex(root.home-font) && root.valid-hex(root.away-primary)
        && root.valid-hex(root.away-secondary) && root.valid-hex(root.away-font)
        && root.valid-periods(root.regulation-periods)
        && root.valid-minutes(root.regulation-minutes)
        && root.valid-overtime-periods(root.overtime-periods)
        && root.valid-minutes(root.overtime-minutes);
    property <string> orphaned:
        root.over-cap(root.regulation-periods, root.overtime-periods, root.back-anchor);

    // --- The picker's state ---------------------------------------------
    //
    // Slint has no dynamic alias, so the open field is dispatched by hand,
    // once each way: a binding out and a function in.

    property <string> picker-text:
        root.picker-field == 0 ? root.home-primary
        : root.picker-field == 1 ? root.home-secondary
        : root.picker-field == 2 ? root.home-font
        : root.picker-field == 3 ? root.away-primary
        : root.picker-field == 4 ? root.away-secondary
        : root.away-font;

    function write(hex: string) {
        if (root.picker-field == 0) { root.home-primary = hex; }
        else if (root.picker-field == 1) { root.home-secondary = hex; }
        else if (root.picker-field == 2) { root.home-font = hex; }
        else if (root.picker-field == 3) { root.away-primary = hex; }
        else if (root.picker-field == 4) { root.away-secondary = hex; }
        else if (root.picker-field == 5) { root.away-font = hex; }
    }

    /// Where the picker is standing. Held here rather than read straight off
    /// the field, because the hex cannot say everything: grey has no hue and
    /// black has neither hue nor saturation, so a drag into the white corner
    /// would swing the strip to red and the next drag would come back a
    /// different colour.
    property <float> picker-hue;
    property <float> picker-sat;
    property <float> picker-val;
    property <Hsv> text-hsv: root.hsv-of-hex(root.picker-text);

    /// Pulls the picker onto the field's text. Typing a hex moves it; so
    /// does a kit colour, which is written as text like any other. What the
    /// picker itself just wrote is left alone -- the second test -- so a drag
    /// doesn't fight the hex it produced a moment ago, and opening the popup
    /// on a colour and touching nothing rewrites nothing.
    function sync-from-text() {
        if (root.picker-field >= 0 && root.valid-hex(root.picker-text)
            && root.hex-of-hsv(root.picker-hue, root.picker-sat, root.picker-val)
                != root.picker-text) {
            root.picker-sat = root.text-hsv.sat;
            root.picker-val = root.text-hsv.val;
            if (root.text-hsv.sat > 0 && root.text-hsv.val > 0) {
                root.picker-hue = root.text-hsv.hue;
            }
        }
    }
    changed picker-text => { root.sync-from-text(); }
    changed picker-field => { root.sync-from-text(); }

    /// Where the popup hangs: under the swatch that was clicked, left-aligned
    /// with its field. The click hands them up (`SetupField::pick`), so the
    /// anchor follows the layout and this sheet keeps no table of which field
    /// sits where.
    property <length> anchor-x;
    property <length> anchor-y;

    /// A swatch was clicked: which field it belongs to, and where its own
    /// bottom-left corner is in window coordinates.
    function open-picker(field: int, x: length, y: length) {
        root.anchor-x = x - root.absolute-position.x;
        root.anchor-y = y - root.absolute-position.y + 4px;
        root.picker-field = field;
    }

    // **This wrapper exists for the colour picker alone** -- the popup hangs
    // off it, over the card -- so it has to be as transparent to [`Scrim`]'s
    // cap as the other five sheets, which *are* the `Sheet`. It asks for what
    // the card asks for and accepts less (#134), and the card takes whatever
    // the layout then gives it; `height: card.height` here would be fixed in
    // that layout and would carry the overflow straight back.
    width: card.width;
    preferred-height: card.preferred-height;
    max-height: card.preferred-height;

    card := Sheet {
        height: parent.height;
        card-width: 520px;
        title: "Match setup";

        HorizontalLayout {
            spacing: 16px;

            VerticalLayout {
                spacing: 6px;
                FieldLabel { text: "HOME TEAM"; }
                SetupField {
                    label: "Name";
                    placeholder: "Home";
                    ok: root.valid-name(root.home-name);
                    text <=> root.home-name;
                }
                home-primary := SetupField {
                    label: "Primary";
                    has-swatch: true;
                    swatch: root.hex-color(root.home-primary);
                    ok: root.valid-hex(root.home-primary);
                    placeholder: "#rrggbb";
                    text <=> root.home-primary;
                    pick(x, y) => { root.open-picker(0, x, y); }
                }
                home-accent := SetupField {
                    label: "Accent";
                    has-swatch: true;
                    swatch: root.hex-color(root.home-secondary);
                    ok: root.valid-hex(root.home-secondary);
                    placeholder: "#rrggbb";
                    text <=> root.home-secondary;
                    pick(x, y) => { root.open-picker(1, x, y); }
                }
                home-text := SetupField {
                    label: "Text";
                    has-swatch: true;
                    swatch: root.hex-color(root.home-font);
                    ok: root.valid-hex(root.home-font);
                    placeholder: "#rrggbb";
                    text <=> root.home-font;
                    pick(x, y) => { root.open-picker(2, x, y); }
                }
            }
            VerticalLayout {
                spacing: 6px;
                FieldLabel { text: "AWAY TEAM"; }
                SetupField {
                    label: "Name";
                    placeholder: "Away";
                    ok: root.valid-name(root.away-name);
                    text <=> root.away-name;
                }
                away-primary := SetupField {
                    label: "Primary";
                    has-swatch: true;
                    swatch: root.hex-color(root.away-primary);
                    ok: root.valid-hex(root.away-primary);
                    placeholder: "#rrggbb";
                    text <=> root.away-primary;
                    pick(x, y) => { root.open-picker(3, x, y); }
                }
                away-accent := SetupField {
                    label: "Accent";
                    has-swatch: true;
                    swatch: root.hex-color(root.away-secondary);
                    ok: root.valid-hex(root.away-secondary);
                    placeholder: "#rrggbb";
                    text <=> root.away-secondary;
                    pick(x, y) => { root.open-picker(4, x, y); }
                }
                away-text := SetupField {
                    label: "Text";
                    has-swatch: true;
                    swatch: root.hex-color(root.away-font);
                    ok: root.valid-hex(root.away-font);
                    placeholder: "#rrggbb";
                    text <=> root.away-font;
                    pick(x, y) => { root.open-picker(5, x, y); }
                }
            }
        }

        FieldLabel { text: "FORMAT"; }
        // Two rows of two: four fields abreast don't fit the sheet's width.
        HorizontalLayout {
            spacing: 16px;

            SetupField {
                label: "Periods";
                ok: root.valid-periods(root.regulation-periods);
                text <=> root.regulation-periods;
            }
            SetupField {
                label: "Minutes each";
                ok: root.valid-minutes(root.regulation-minutes);
                text <=> root.regulation-minutes;
            }
        }
        HorizontalLayout {
            spacing: 16px;

            SetupField {
                label: "Overtime periods";
                ok: root.valid-overtime-periods(root.overtime-periods);
                text <=> root.overtime-periods;
            }
            SetupField {
                label: "Minutes each";
                ok: root.valid-minutes(root.overtime-minutes);
                text <=> root.overtime-minutes;
            }
        }

        CheckBox {
            text: "My video starts after kick-off";
            checked <=> root.back-anchor;

            Tooltip {
                text: @markdown("The first period's start is derived, so tagging half-time puts the clock at the right minute. It takes the first period, so a fully-tagged format has one start/stop left over -- kept, but without a period until you untick this.");
            }
        }

        // The records are never dropped -- the cap is on what gets a role --
        // so this is a warning, not a refusal (spec S5).
        if root.orphaned != "": Text {
            text: root.orphaned;
            color: #ffcc00;
            font-size: 11px;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;

            Button {
                text: "Cancel";
                clicked => { root.cancel(); }
            }
            Button {
                text: "Save";
                primary: true;
                enabled: root.can-save;
                clicked => { root.save(); }
            }
        }
    }

    // The picker, over the sheet rather than over the window: a scrim of its
    // own would be a modal on top of a modal, and the coach would have two
    // Escs to get back to the game. The sheet itself is the backdrop -- a
    // click anywhere else closes the popup and nothing behind it moves --
    // which also makes a second click on the same swatch a toggle.
    if root.picker-field >= 0: Rectangle {
        TouchArea {
            clicked => { root.picker-field = -1; }
        }

        ColorPicker {
            // Kept inside the sheet at both ends: the away column's swatches
            // are near the right edge, and the Text row's popup would
            // otherwise hang off the bottom.
            x: Math.min(Math.max(8px, root.anchor-x), root.width - 8px - self.width);
            y: Math.min(Math.max(8px, root.anchor-y), root.height - 8px - self.height);
            kit-colors: root.kit-colors;
            hue: root.picker-hue;
            sat: root.picker-sat;
            val: root.picker-val;
            hex-color(text) => { return root.hex-color(text); }
            hex-of-hsv(hue, sat, val) => { return root.hex-of-hsv(hue, sat, val); }
            // Both land in the field, which is what the sheet saves: there is
            // no colour held anywhere the hex box can't see.
            pick(hex) => { root.write(hex); }
            take(hue, sat, val) => {
                root.picker-hue = hue;
                root.picker-sat = sat;
                root.picker-val = val;
                root.write(root.hex-of-hsv(hue, sat, val));
            }
        }
    }
}

/// The match event editor (spec P1): the project's events, one retypable line
/// each, and a box that takes a block of the same lines pasted from the
/// coach's notes. Both hold the same text in the same grammar
/// (`core::match_entry`), read by the same parse, so there is no second way to
/// say a thing.
///
/// A `Sheet` at 640px: the widest thing in it is an echo line's sentence, not
/// a table. Nothing is staged -- each committed row and each Add is a bus
/// command and an undo step -- so its one button is Done, and there is no
/// Cancel (spec P5) and no add control (T7).
component MatchEditorSheet inherits Sheet {
    in property <[MatchEditorRow]> rows;
    /// The selected row's id, empty for none. The window owns it, so an event
    /// that goes takes the selection with it.
    in property <string> selected;
    // Selecting another row destroys the field under this one, and Slint does
    // not promise a focus-change callback from an element it has destroyed --
    // so `line-focused` would stick true and `src/main.rs` would never rebuild
    // the rows again. (The window's shortcuts need no such guard: they read
    // Slint's own `TextInputInterface.text-input-focused`, which `TextInput`
    // clears in its `deinit`.)
    changed selected => { root.line-focused = false; }
    /// The selected row's line, two-way all the way out to the window as every
    /// field in this app is: a `text:` binding breaks the moment it's typed in.
    in-out property <string> line;
    /// The paste box's block. A window property too, so it survives Go and the
    /// sheet closing (spec F2).
    in-out property <string> paste;
    /// "1 · Half 1", …: which video a line with no number of its own means.
    in property <[string]> sources;
    in-out property <int> default-source;
    /// The last refusal (spec C5). The status bar's notice line renders
    /// *behind* the scrim, so a sheet with commands of its own needs a line.
    in property <string> message;
    /// The **row's** field has focus: the one state in which the rows above
    /// must not be rebuilt (spec T3, `src/main.rs`). Out and up, and cleared
    /// by `close-match-editor()`: this element is destroyed when the sheet
    /// closes, and Slint promises no focus-change callback from an item it
    /// has destroyed.
    in-out property <bool> line-focused;

    /// A row's line, as the bus will read it -- `bus::editor_line`, the very
    /// call the command makes, cap and all, so a line marked good is never
    /// refused.
    pure callback valid-line(string, string) -> bool;
    /// The paste box's verdicts. It takes the text, the picker and the
    /// project's revision so the binding re-evaluates as any of them change:
    /// it is `pure` but reads the project, and without the revision a row
    /// deleted with its `×` would leave the echo standing on the answer it
    /// gave before (the tag field's suggestions and the setup sheet's
    /// validators are the same shape).
    pure callback check-paste(string, int, int) -> PasteEcho;
    /// The project changed, so every echo above has to be read again.
    in property <int> revision;
    callback select(string);
    /// A row's line committed: nothing is sent until it parses.
    callback commit(string, string);
    callback seek(string);
    callback remove(string);
    callback add();
    callback close();

    property <PasteEcho> echo: root.check-paste(root.paste, root.default-source, root.revision);

    /// Enter and losing focus both commit, as the inspector's fields do. A
    /// line that doesn't parse is marked and goes nowhere (spec T5).
    ///
    /// **Enter therefore commits twice**: the window drops focus on the
    /// commit (spec T4) and the focus loss commits the same line again. The
    /// second lands on the record the first already moved, reads back to the
    /// same event, and the bus drops it -- no save, no undo step, no publish
    /// (`bus::scoreboard::edit_match_event`).
    ///
    /// The selection test is what makes a *late* focus loss safe: the field
    /// lives inside the row loop, so selecting another row destroys it, and a
    /// focus-change it fires on the way out would otherwise carry the new
    /// row's line to the old row's id.
    function commit-line(id: string, text: string) {
        if (id == root.selected && root.valid-line(id, text)) {
            root.commit(id, text);
        }
    }

    card-width: 640px;
    title: "Match events";

    if root.rows.length == 0: Text {
        text: "Nothing tagged yet. Paste a block below, or tag with Z, X and V while the game video plays.";
        color: Palette.alternate-foreground;
        font-size: 11px;
        wrap: word-wrap;
    }
    // A height of its own, as the panel's list has: a long match scrolls
    // rather than growing the sheet past the window. The selected row
    // carries a field under it, which is a line and a half.
    if root.rows.length > 0: ListView {
        // 168px is the Match panel's own cap, and the three scrolling
        // lists here are capped together so the sheet still fits a
        // 700px window with a long match and a long echo in it.
        height: min(168px, root.rows.length * 28px + (root.selected == "" ? 0px : 48px));
        for row in root.rows: VerticalLayout {
            Rectangle {
                height: 28px;
                border-radius: 4px;
                background: row.id == root.selected ? Palette.selection-background : transparent;

                // The whole row selects; the buttons in front take their
                // own clicks.
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.select(row.id); }
                }

                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    spacing: 6px;

                    Text {
                        text: row.where-text;
                        color: Palette.alternate-foreground;
                        font-family: "monospace";
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: row.label;
                        color: row.role-less ? Palette.alternate-foreground : Palette.foreground;
                        font-size: 11px;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: "→";
                            accessible-label: "Seek";
                            clicked => { root.seek(row.id); }

                            Tooltip {
                                text: @markdown("Play the game video from here. The picture is behind this sheet, so it closes.");
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: "×";
                            accessible-label: "Delete";
                            clicked => { root.remove(row.id); }

                            Tooltip {
                                text: @markdown("Delete this event (undoable)");
                            }
                        }
                    }
                }
            }

            // The selected row's one control: the event as a line of the
            // paste box's grammar, retyped whole (spec T2). No combo box
            // for the video, none for the kind: a kind is a word and a
            // video is a number, and both are in the line.
            if row.id == root.selected: HorizontalLayout {
                padding-top: 4px;
                padding-bottom: 8px;
                spacing: 4px;

                line-edit := LineEdit {
                    horizontal-stretch: 1;
                    text <=> root.line;
                    accepted(text) => { root.commit-line(row.id, text); }
                    changed has-focus => {
                        root.line-focused = self.has-focus;
                        if (!self.has-focus) {
                            root.commit-line(row.id, self.text);
                        }
                    }
                }
                if !root.valid-line(row.id, root.line): VerticalLayout {
                    alignment: center;
                    Text {
                        text: "✕";
                        color: #ff6b6b;
                        font-size: 11px;
                    }
                }
            }
        }
    }

    HorizontalLayout {
        spacing: 8px;
        FieldLabel {
            text: "Paste events";
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: "Lines with no number are:";
            color: Palette.alternate-foreground;
            font-size: 11px;
            vertical-alignment: center;
        }
        ComboBox {
            width: 160px;
            model: root.sources;
            // Two-way: a one-way binding onto `current-index` is dropped
            // the first time the popup opens, and the readout then lies.
            current-index <=> root.default-source;
        }
    }
    paste-edit := TextEdit {
        // Six lines of a block that may well be twenty: it scrolls, as
        // the lists either side of it do.
        height: 120px;
        placeholder-text: "2 14:05 away goal";
        text <=> root.paste;
    }
    Text {
        text: "One event per line: an optional video number, a time with a colon, then what happened — \"home\", \"away\", \"period\". # starts a comment.";
        color: Palette.alternate-foreground;
        font-size: 11px;
        wrap: word-wrap;
    }

    // **Each line wraps rather than elides.** The kick-off refusal is a
    // sentence explaining why a restart is not a period boundary, and
    // eliding it hides the one thing the line is for. So this list has a
    // height of its own rather than one counted in rows: how tall a row
    // is depends on its sentence, and it scrolls.
    if root.echo.lines.length > 0: ListView {
        height: 120px;
        for line in root.echo.lines: HorizontalLayout {
            padding-left: 4px;
            padding-top: 2px;
            padding-bottom: 2px;
            spacing: 6px;

            Text {
                text: line.glyph;
                color: Palette.alternate-foreground;
                font-size: 11px;
                vertical-alignment: top;
            }
            Text {
                text: line.text;
                color: Palette.foreground;
                font-size: 11px;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
    }

    HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.echo.summary;
            color: Palette.alternate-foreground;
            font-size: 11px;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Button {
            text: root.echo.button;
            enabled: root.echo.adding > 0;
            clicked => { root.add(); }

            Tooltip {
                text: @markdown("Add every line marked ✓, in one undo step. The rest stay in the box.");
            }
        }
    }

    // The sheet's own notice line (spec C5): a refused command says so
    // here, since the status bar is behind the scrim.
    if root.message != "": Text {
        text: root.message;
        color: #ffcc00;
        font-size: 11px;
        wrap: word-wrap;
    }

    HorizontalLayout {
        alignment: end;
        Button {
            text: "Done";
            primary: true;
            clicked => { root.close(); }

            Tooltip {
                text: @markdown("Close the editor. Every edit is already saved, and undoable with Ctrl+Z.");
            }
        }
    }
}

/// The New match sheet (new match spec S1): the two teams, where projects go,
/// the folder this match will get, and the videos in the order they will be
/// stored.
///
/// **It `inherits Sheet`**, as export, the basket and the match editor do. The
/// draft wrapped it in a `Rectangle` instead, copying `MatchSetupSheet`'s
/// exception -- but that exception exists only because a `ColorPicker` hangs
/// over that card as an absolutely-positioned sibling, and this sheet has none.
///
/// **It extracts nothing from `MatchSetupSheet`** (spec S2): with no colours in
/// here there is no shared column to lift out, so a shipped sheet is left
/// alone.
///
/// **The folder name is not derived here.** Its text is two-way bound all the
/// way out to the window, as every field in this app is, so a `text:` binding
/// would break the moment it is typed into; the window re-derives it
/// imperatively from the two team names until [`edited`] says the coach has
/// taken it over. Everything else -- the three validators and the path line --
/// is a pure callback or a concatenation, and each validator is the same call
/// Create will make, so a field cannot read good and then fail to save.
component NewMatchSheet inherits Sheet {
    in-out property <string> home-name;
    in-out property <string> away-name;
    in-out property <string> projects-dir;
    in-out property <string> folder-name;
    /// The one line under the projects folder, and only on the weakest tier:
    /// a hint on every field is a hint on none (spec I0).
    in property <string> provenance;
    /// `<n>. <file name>`, already numbered and in the order the command will
    /// store them. Read-only: the sidebar is what reorders sources, and two
    /// orderings of one list in two places is duplication this codebase pays
    /// for later (spec I6). No durations and no aspect either -- that means
    /// `probe`, which blocks for up to ten seconds a file on the UI thread
    /// (spec S4).
    in property <[string]> videos;
    /// Create was pressed and the sheet is waiting for `ProjectOpened`, which
    /// is the one thing that closes it (spec C5). An `Event::Error` re-enables
    /// it, because the alternative is a dead button after a refused Create and
    /// a coach who has to Cancel and re-pick every video.
    in property <bool> creating;
    /// Whether a team name is one the bus will accept. **Not `!= ""`**: the
    /// rule trims, and an untrimmed comparison here marked a field of one space
    /// good, enabled Create and then sent nothing — leaving the button dead
    /// until the coach cancelled and re-picked every video. It is the same call
    /// Create makes (spec S5), which is only true because it is Rust's.
    pure callback team-named(string) -> bool;
    pure callback valid-folder-name(string) -> bool;
    pure callback valid-projects-dir(string) -> bool;
    /// Whether `<projects folder>/<folder name>` already holds a project. A
    /// courtesy, not the guarantee: the guarantee is the bus's, which cannot
    /// race (spec S5). Pure in Slint's sense — it is read from a binding — and a
    /// `try_exists` of one path, which is the cheapest thing in this sheet.
    pure callback target-taken(string, string) -> bool;
    callback swap();
    callback choose();
    callback create();
    callback cancel();
    /// The folder-name field was typed into: stop re-deriving it.
    callback folder-edited();

    card-width: 560px;
    title: "New match";

    property <bool> home-ok: root.team-named(root.home-name);
    property <bool> away-ok: root.team-named(root.away-name);
    property <bool> folder-ok: root.valid-folder-name(root.folder-name);
    property <bool> dir-ok: root.valid-projects-dir(root.projects-dir);
    property <bool> taken: root.dir-ok && root.folder-ok
        && root.target-taken(root.projects-dir, root.folder-name);

    HorizontalLayout {
        spacing: 8px;

        home := SetupField {
            label: "Home team";
            placeholder: "Your club";
            ok: root.home-ok;
            text <=> root.home-name;
            horizontal-stretch: 1;
        }
        // Which team was at home is a fact about where the match was played,
        // which is in no file and in no folder name -- so the guess goes in
        // `away` and this is one click either way (spec S3). Watching the
        // folder name flip is the fastest way to see which way round it wants
        // to be.
        VerticalLayout {
            alignment: end;
            Button {
                text: "⇄";
                accessible-label: "Swap the teams";
                enabled: !root.creating;
                clicked => { root.swap(); }
                Tooltip { text: @markdown("Swap home and away"); }
            }
        }
        away := SetupField {
            label: "Away team";
            placeholder: "Opponent";
            ok: root.away-ok;
            text <=> root.away-name;
            horizontal-stretch: 1;
        }
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: stretch;

        dir := SetupField {
            label: "Projects folder";
            placeholder: "Where projects go";
            ok: root.dir-ok;
            text <=> root.projects-dir;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: end;
            Button {
                text: "Choose…";
                enabled: !root.creating;
                clicked => { root.choose(); }
            }
        }
    }
    if root.provenance != "": Text {
        text: root.provenance;
        color: Palette.alternate-foreground;
        font-size: 11px;
        wrap: word-wrap;
    }

    folder := SetupField {
        label: "Folder name";
        placeholder: "date-home-away";
        ok: root.folder-ok && !root.taken;
        text <=> root.folder-name;
        edited => { root.folder-edited(); }
    }
    // The whole preview, and the reason there is no date field and no project
    // name field (spec N1): the coach reads the path and sees both the date and
    // what it does.
    Text {
        text: root.projects-dir + "/" + root.folder-name + "/";
        color: Palette.alternate-foreground;
        font-size: 11px;
        wrap: word-wrap;
    }
    if root.taken: Text {
        text: "That folder already holds a project. Change the folder name, or open that project instead.";
        color: #ffcc00;
        font-size: 11px;
        wrap: word-wrap;
    }

    FieldLabel { text: root.videos.length == 1 ? "1 video" : root.videos.length + " videos"; }
    // A check that the halves are the right way round, and nothing more.
    VerticalLayout {
        spacing: 2px;
        for line in root.videos: Text {
            text: line;
            color: Palette.foreground;
            font-size: 11px;
            overflow: elide;
        }
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: end;

        Button {
            text: "Cancel";
            clicked => { root.cancel(); }
        }
        Button {
            text: "Create";
            primary: true;
            enabled: !root.creating && root.home-ok && root.away-ok && root.folder-ok && root.dir-ok
                && !root.taken && root.videos.length > 0;
            clicked => { root.create(); }

            Tooltip {
                text: @markdown("Make the folder, name the project after both teams, and open it. The footage stays where it is.");
            }
        }
    }
}

/// One row of the Keys sheet (#96, spec D2), built by `keymap::Keymap::listing`
/// from the same table the matcher reads -- so a listed row is a row the
/// matcher holds and the list cannot go stale.
export struct KeyRow {
    /// What the action does: "Play or pause".
    what: string,
    /// Every key it answers to, joined -- "shift+LeftArrow, shift+a" -- or an
    /// em dash for an action bound to nothing, which `Keymap` decides and this
    /// sheet only shows.
    keys: string,
    /// When it fires, in prose. **Not a machine-readable guard**: in this app a
    /// bound key is swallowed whether or not its gate passes, so there is no
    /// `when` clause to read it from -- `keymap.rs`'s header has the whole
    /// reason.
    fires: string,
    /// The name the row is stored under -- "openProject" -- which is what
    /// *Set...* and the unbind carry back to Rust (#96 task 5). The row's
    /// identity, so nothing matches on the words in `what`.
    action: string,
    /// Whether it answers to any key at all, which is what the ✕ is enabled by.
    /// **Not `keys != "—"`**: the em dash is `keymap.rs`'s spelling of nothing
    /// and no sheet's business.
    bound: bool,
}

/// One line of the Keys sheet's table -- an action's row, the column heading
/// and a reserved key's row alike, so the three read as one table.
///
/// **Fixed column widths, elided rather than wrapped.** The first two are wide
/// enough for the longest thing `keymap.rs` puts in them ("Go to the previous
/// match event", "shift+LeftArrow, shift+a") and the third takes what is left;
/// eliding is what keeps them aligned. The height is a **floor** rather than a
/// fixed value, because an action's row carries buttons and a fixed height
/// would squeeze them: it used to be fixed so that the row list's own scroll
/// cap could be `rows * height`, and #134 took that cap away.
///
/// **A row's controls are its children, not properties of this component**
/// (#96 task 5), which is the whole of what keeps them off the column heading
/// and the six reserved rows: those instantiate the same component and pass
/// nothing. The columns still line up, because all three are left-aligned and
/// what the buttons move is only the prose column's far end.
component KeyLine inherits HorizontalLayout {
    in property <string> what;
    in property <string> keys;
    in property <string> fires;
    /// The column heading, which is this same line so the columns cannot drift
    /// apart.
    in property <bool> heading;

    spacing: 12px;
    min-height: 22px;
    // **The row read as one line**, which is both what a reader of a table
    // wants and what `tests/ui/keys_sheet.rs` finds it by: the three cells in
    // the order the columns are in, so a crossed wire reads back crossed.
    accessible-role: text;
    accessible-label: root.what + " — " + root.keys + " — " + root.fires;

    Text {
        text: root.what;
        width: 200px;
        color: root.heading ? Palette.alternate-foreground : Palette.foreground;
        font-size: 12px;
        font-weight: root.heading ? 600 : 400;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        text: root.keys;
        width: 170px;
        color: root.heading ? Palette.alternate-foreground : Palette.foreground;
        font-size: 12px;
        font-weight: root.heading ? 600 : 400;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        text: root.fires;
        horizontal-stretch: 1;
        color: Palette.alternate-foreground;
        font-size: 11px;
        font-weight: root.heading ? 600 : 400;
        vertical-alignment: center;
        overflow: elide;
    }

    @children
}

/// The Keys sheet (#96): every key the app binds, in one list the coach can
/// read and change. `F1` opens it, and so does the button beside `Fit`.
///
/// **Each action's row carries *Set...* and ✕** (task 5). *Set...* arms the
/// capture -- the next key the coach presses becomes that action's, taken off
/// whatever held it -- and ✕ leaves the row answering to nothing. The capture
/// itself is not here and cannot be: the window's shortcuts run in the capture
/// phase, *ahead* of whatever has focus, so a `FocusScope` in this sheet would
/// never see a key the keymap binds. It is a layer at the top of
/// `handle-key` instead, armed by the property this sets.
///
/// **The reserved keys' six rows are written here, not taken from the table**
/// (spec G4). Escape, Tab, Shift+Tab, Return, Home and End are deliberately not
/// `keymap::Action` variants -- Escape is a key with a position rather than a
/// job, Tab and Return are the platform's, and Home and End do nothing -- so
/// `listing()` has no row for them and `Binding`, `overrides()` and the rebind
/// would each have to filter them back out again if it had. Their words belong
/// where their behaviour is instead: the three this window handles are
/// `handle-key`'s "three reserved keys, ahead of the table" block, in this file.
/// `Binding::reserved` is the same five, and it is what refuses a capture that
/// lands on one.
component KeysSheet inherits Sheet {
    in property <[KeyRow]> rows;
    /// The action a capture is armed for, by its stored name, two-way out to
    /// the window -- which is where the capture happens. Empty when none is.
    in-out property <string> capturing;
    /// What the capture is waiting for, and what a rebind took from where.
    ///
    /// **Its own line rather than the status bar's**, which renders *behind*
    /// the scrim: the basket sheet's own note says why it has one, and this is
    /// the same reason. Written from both sides -- this sheet says what it is
    /// waiting for, Rust says what happened.
    in-out property <string> message;
    /// Take every key off an action, by its stored name.
    callback unbind(string);
    callback close();

    card-width: 840px;
    title: "Keys";

    // Outside the scroll area, so it stays put. The first two columns are a
    // fixed width in `KeyLine`, so the scroll bar's bite out of the rows below
    // moves only the third column's far end, which has nothing in it.
    KeyLine {
        what: "What it does";
        keys: "Keys";
        fires: "When it fires";
        heading: true;
    }

    // **No scroll view of its own, and no cap** (#134). Task 4 put the rows in
    // a 520px `ScrollView` because `Sheet` was `height: body.preferred-height`
    // and could not be capped, so a 29-row card hung off the bottom of a 700px
    // window. `Sheet` now states `preferred-height`/`max-height` and scrolls
    // its own body, which caps this card at the window for free -- and a
    // second scroll view inside that one would show the coach 520px of rows in
    // the middle of a 1200px card and scroll in two places at once.
    VerticalLayout {
        spacing: 2px;

        for row in root.rows: KeyLine {
            what: row.what;
            keys: row.keys;
            fires: row.fires;

            // **Set... arms the capture; the window harvests the key.** The
            // message is set here rather than in Rust because this is where
            // the words for the row are -- Rust is handed the name, not the
            // prose.
            Button {
                text: "Set…";
                enabled: root.capturing == "";
                clicked => {
                    root.capturing = row.action;
                    root.message = "Press the key for “" + row.what
                        + "” — or Escape to leave it alone.";
                }

                Tooltip {
                    text: @markdown("Press a new key for this");
                }
            }
            Button {
                text: "✕";
                // Nothing to take away, and the coach is told which rows those
                // are by the em dash in the column beside it.
                enabled: row.bound && root.capturing == "";
                clicked => { root.unbind(row.action); }

                Tooltip {
                    text: @markdown("Leave this with no key at all");
                }
            }
        }

        // The six that are not actions, under their own heading so the
        // em dash in the keys column above reads as "nothing bound yet"
        // and these read as "nothing you can bind".
        FieldLabel {
            text: "Reserved — not rebindable";
            height: 24px;
            vertical-alignment: bottom;
        }
        KeyLine {
            what: "Back out";
            keys: "Escape";
            fires: "Whatever is innermost: a sheet, the tool, a take, the selection";
        }
        KeyLine {
            what: "Move the focus on";
            keys: "Tab";
            fires: "Any time";
        }
        KeyLine {
            what: "Move the focus back";
            keys: "Shift+Tab";
            fires: "Any time";
        }
        KeyLine {
            what: "Confirm the message";
            keys: "Return";
            fires: "While a message is on screen";
        }
        KeyLine {
            what: "Nothing";
            keys: "Home";
            fires: "Swallowed, so a touched slider cannot take it";
        }
        KeyLine {
            what: "Nothing";
            keys: "End";
            fires: "Swallowed, so a touched slider cannot take it";
        }
    }

    if root.message != "": Text {
        text: root.message;
        color: Palette.alternate-foreground;
        font-size: 11px;
        wrap: word-wrap;
    }

    HorizontalLayout {
        alignment: end;

        Button {
            text: "Close";
            primary: true;
            enabled: root.capturing == "";
            clicked => { root.close(); }
        }
    }
}

export component AppWindow inherits Window {
    title: "pundit";
    // Every control fits at this size. The window opens at the size it last
    // closed at, which Rust sets from the app's state file, and at a roomier
    // one the first time.
    //
    // Named properties in front of the reserved ones: `min-width` and
    // `min-height` are layout properties with no generated getter, and the fit
    // (spec W6) has to compare its target against this floor itself. The
    // alternative was a fourth copy of the pair in Rust.
    out property <length> min-window-width: 1100px;
    out property <length> min-window-height: 700px;
    min-width: root.min-window-width;
    min-height: root.min-window-height;

    // --- The side columns' widths (#87, spec W4) ---

    /// The narrowest each column may be laid out at: today's widths. The
    /// inspector's 280px is **measured** — the "One action, not two" note in
    /// `TranscriptRow` records a fourth control in that row running 76px past
    /// this column at the window's 1100x700 minimum, so 280 is the width the
    /// row was fitted to. The sidebar's 240px is **not measured**: it is
    /// today's width, asserted by analogy with the Clips rows' name-plus-
    /// duration line, and nothing has been shown to need it. The panels grow
    /// from here and never shrink, so no row has to be re-verified against a
    /// width nobody asked for.
    out property <length> sidebar-min: 240px;
    out property <length> inspector-min: 280px;
    /// At the window's own 1100px floor the columns and the splitters leave the
    /// player 568px, so this is slack rather than a constraint — but it is what
    /// the layout reconciles the columns against when their stored widths do
    /// not fit.
    out property <length> player-min: 320px;
    /// What the coach dragged the columns to, restored from `state.json`. Raw:
    /// a width from a wider screen, or a hand-edited file, arrives here
    /// unchecked and the layout is what bounds it (the table above the
    /// sidebar's constraints).
    in-out property <length> sidebar-width: root.sidebar-min;
    in-out property <length> inspector-width: root.inspector-min;
    /// What the layout gave each column once it had reconciled the pair above
    /// with the window's width. The effective width is a different number from
    /// the stored one whenever the bound is active, and it is the one anything
    /// outside the layout has to work from — the pointer follows the column
    /// the coach can see, and only this can show the bound holding.
    out property <length> sidebar-width-now: sidebar-column.width;
    out property <length> inspector-width-now: inspector-column.width;
    /// A splitter drag ended, however it ended. No argument: the two width
    /// properties above are already the widths to keep by the time this fires,
    /// and one of them has just been overwritten with what the layout settled
    /// on — a single argument could only carry one column anyway.
    callback panels-released();

    background: Palette.background;
    forward-focus: keys;

    // --- Video (set by the renderer bridge in `src/video.rs`) ---

    /// The newest video frame (a borrowed GL texture).
    in property <image> frame;
    /// Display size of `frame`, from the negotiated caps (pixel aspect ratio
    /// included), so the picture is never stretched. Only its shape matters.
    in property <float> frame-width: 16;
    in property <float> frame-height: 9;
    /// The camera, live, while recording (set by `src/video.rs`), in square
    /// pixels. Drawn where the export puts the webcam inset, so what the
    /// coach sees is what viewers will.
    in property <image> self-view;
    /// Recording (or starting) with the camera's frames arriving. Cleared by
    /// `src/main.rs` when they stop, so a self-view that failed or stalled
    /// is hidden rather than frozen. An avatar take has no frames and stays
    /// up for the whole of it (avatar G2).
    in property <bool> self-view-shown;
    /// How loud the coach is right now, `0..=1`, smoothed: the avatar's size
    /// follows it (avatar G2). **1 outside an avatar take**, where it places
    /// the camera's inset exactly as it always was.
    in property <float> self-view-level: 1.0;
    /// This take's inset is the project's avatar, not the camera (avatar G2).
    /// It picks the placement rule: an avatar is drawn in its own, smaller
    /// box (`core::layout::avatar_self_view_rect`).
    in property <bool> self-view-avatar;
    /// Where this take's inset will land: the coach's sticky preference, which
    /// is what `Project::add_recorded_clip` seeds the new clip from (#88 spec
    /// I6).
    ///
    /// **The preference and never the selected clip's fields.** There is no
    /// clip during a take -- `finish_recording` builds it afterwards -- so
    /// "pick before" can only be a preference, and binding this to the clip
    /// under the coach's cursor would show the self-view somewhere the
    /// recording is not going to put it. Written by `start_self_view`, beside
    /// `self-view-avatar`, from the same snapshot.
    ///
    /// **Both carry their default explicitly**, because a Slint enum has no
    /// `#[default]` and falls to its **first** variant: `InsetSize`'s is
    /// `small`, so a window nothing had fed would place the self-view one step
    /// narrower than every inset the app has ever drawn. Spelled out, the pair
    /// reads as `core::project::InsetPlacement::default()`.
    in property <InsetSize> self-view-size: InsetSize.medium;
    in property <InsetCorner> self-view-corner: InsetCorner.bottom-right;
    /// Where the inset lands on the picture (`core::layout::
    /// pip_rect_over_picture`, sized by `core::avatar::avatar_rect`), from
    /// the content rect, the inset's aspect, the level, which kind of take
    /// it is and where that take's inset goes. Pure, like `place-picture`.
    pure callback place-self-view(PictureRect, float, float, bool, InsetSize, InsetCorner) -> PictureRect;

    // --- Zoom (spec D9; the state and the math are on the Rust side) ---

    in property <ZoomState> zoom: { scale: 1 };
    /// Core's `SNAP_NOTCHES`, for the indicator's ticks.
    in property <[float]> zoom-notches;
    out property <length> player-width: player.width;
    out property <length> player-height: player.height;
    /// The content rect: the letterboxed picture at 1×, which the drawing
    /// area is sized to and strokes are normalized against (Phase 6 D2).
    /// Zero before the first layout, or with nothing loaded.
    out property <length> content-width: player.content.width;
    out property <length> content-height: player.content.height;
    /// Where the live self-view lands on the picture, which the image below
    /// takes its whole rect from.
    ///
    /// **A named property on the window rather than a local one on the image**,
    /// for the reason `content-width` above is one: it is the only thing a
    /// headless test can read, and reading it is what evaluates the binding —
    /// the image is positioned absolutely, so nothing else in a window that
    /// never renders would (`tests/self_view_placement.rs`).
    out property <PictureRect> self-view-rect: root.place-self-view(player.content, root.self-view.width / root.self-view.height, root.self-view-level, root.self-view-avatar, root.self-view-size, root.self-view-corner);
    /// The picture's rect at `zoom`. Pure, so the binding that calls it is
    /// re-evaluated whenever an argument changes.
    pure callback place-picture(ZoomState, float, float, length, length) -> PictureRect;
    /// A scroll over the player at (x, y): pan, or zoom with Ctrl.
    callback zoom-scroll(length, length, length, length, bool, bool);
    /// The primary button went down over the player at (x, y) ...
    callback zoom-press(length, length);
    /// ... and, still down, the pointer moved to (x, y).
    callback zoom-drag(length, length);

    // --- Fit the window to the footage (spec W1) ---

    /// There is black to take off: the player's shape differs from the
    /// frame's and the fit would land on a window this one can hold. One
    /// answer from Rust, `can-play` folded into it, so the offer and the
    /// action can never disagree about whether there is anything to do.
    in property <bool> can-fit;
    /// Shrink the window to the footage's shape. Never grows it and never
    /// re-fits the picture: the window closes up around the picture already
    /// on screen, and the bars are what goes.
    callback fit-window();

    // --- Project state (from bus events) ---

    in property <bool> has-project;
    /// The project-name field's text.
    in-out property <string> project-name;
    /// The name the field returns to when it loses focus: the project's, or
    /// a rename just sent.
    in property <string> saved-project-name;
    changed saved-project-name => {
        // Never over a name being typed: leaving the field shows it.
        if (!name-edit.has-focus) {
            root.project-name = self.saved-project-name;
        }
    }
    in property <[SourceRow]> sources;
    /// The first missing source, or -1.
    in property <int> missing-index: -1;
    in property <string> missing-name;
    in property <bool> playing;
    /// The game video's speed, 1 to 32 (spec S), from the bus.
    in property <float> scan-speed: 1;
    /// Sources, none missing: play, seek and scrub are possible.
    in property <bool> can-play;

    // --- Transport ---

    /// Concat-timeline length, seconds.
    in property <float> total-seconds;
    /// The scrubber's value, concat seconds. Set by the 30 Hz timer except
    /// while `scrubbing`.
    in-out property <float> position-seconds;
    /// A scrub is under way, from its press to its end, however it ends
    /// (see `scrubber.slint`).
    out property <bool> scrubbing: scrubber.scrubbing;
    /// `current / total`.
    in property <string> readout: "0:00 / 0:00";
    /// Linear 0..1.
    in-out property <float> volume: 1;

    // --- Recording (Phase 4 R11) ---

    in property <RecordingPhase> recording-phase;
    /// Not idle. Greys out everything the bus refuses while recording (R6's
    /// guard): the source and clip lists, Open Project, rename, the scrubber
    /// and the Devices button.
    out property <bool> recording: root.recording-phase != RecordingPhase.idle;
    /// Time since the recording's t0, already formatted.
    in property <string> recording-elapsed: "0:00";
    /// The microphone's peak as a fraction of the level bar, 0..1.
    in property <float> level;
    /// A level has arrived during this recording.
    in property <bool> level-seen;
    /// The Clips list: the project's clips, or only those tagged
    /// `tag-filter`.
    in property <[ClipRow]> clips;
    /// All the project's clips, filtered or not.
    in property <int> clip-count;
    /// The Slates list, in `(video, in point)` order — empty for every project
    /// that has never marked one, which is what hides the section.
    in property <[SlateRow]> slates;
    /// The selected slate's id, empty for none. UI state only, cleared on
    /// project open and when its slate leaves the project.
    in-out property <string> selected-slate;
    changed selected-slate => {
        if (self.selected-slate == "") {
            keys.focus();
        }
        root.show-slate();
    }
    /// The selected slate's marked range on the scrubber's concat scale
    /// (spec S6), `to <= from` for nothing to draw.
    ///
    /// **Pushed by Rust, not derived here.** The `slates` rows carry a
    /// formatted range for reading, not seconds, and the mapping a span needs
    /// is `project.abs_seconds(source_index, …)` — the selection alone does
    /// not say which video it is on. `show-slate` above sets it on every
    /// selection change, and the project-changed path sets it again, which is
    /// what moves it when a mark is re-set under an unchanged selection.
    in property <float> slate-span-from;
    in property <float> slate-span-to;
    /// The selected slate's name and tags, two-way as the inspector's fields
    /// are: a `text:` binding breaks the first time it is typed in.
    in-out property <string> slate-name;
    in-out property <string> slate-tags;
    /// Which slate the fields are editing, so a commit names it even after the
    /// selection has moved on -- `editing-clip-id`'s rule, which exists
    /// because `for` reuses its rows by index.
    in-out property <string> editing-slate-id;
    /// The themed pass's tag filter (BACKLOG #120). **Not the window's
    /// `tag-filter`**, which the bus writes on `Event::Select` to un-hide a
    /// newly selected clip — that write would clear this one mid-pass.
    in-out property <string> slate-tag-filter;
    changed slate-tag-filter => { root.filter-slates(); }
    /// The export sheet would have a row: a clip, or a goal for the reel
    /// (spec R1). A project of goals and no clips can export its reel.
    in property <bool> can-export;
    /// The selected clip's id, empty for none (Phase 3 C7). UI state only:
    /// `src/main.rs` sets it on the bus's `Select`, and clears it on project
    /// open and when its clip leaves the project.
    in-out property <string> selected-clip;
    changed selected-clip => {
        // Its clip is gone: off a field the inspector is hiding.
        if (self.selected-clip == "") {
            keys.focus();
        }
        root.show-clip();
    }
    /// The inspector's fields (C7), set imperatively by `show-clip`: a
    /// `text:` or `checked:` binding breaks once the user types or clicks.
    in-out property <string> clip-name;
    in-out property <string> clip-tags;
    in-out property <string> clip-notes;
    in-out property <string> clip-transcript;
    in-out property <bool> clip-show-pip;
    /// The selected clip's inset size and corner (#88 spec I7), as indices
    /// into the inspector's two pickers -- which is where the reasoning for an
    /// index rather than `InsetSize` / `InsetCorner` lives, and where the two
    /// defaults below are explained.
    in-out property <int> clip-inset-size-index: 1;
    in-out property <int> clip-inset-corner-index: 0;
    /// The selected clip's inset is the avatar, not a camera (avatar G3):
    /// one word of the inspector's checkbox.
    in property <bool> clip-avatar;
    /// The selected clip's transcription and the line that describes it
    /// (Phase 10 S5). Both are written by `src/main.rs` from
    /// `Event::Transcription` -- and, unlike the fields above, they keep
    /// following it while a field is being edited.
    in property <TranscriptState> transcript-state;
    in property <string> transcript-status;
    /// The speech models on offer and which is chosen (Phase 10 S3): a
    /// machine-wide setting, written once at start-up from `state.json` and
    /// thereafter only by the picker, so it follows no event.
    in property <[string]> transcript-models;
    in-out property <int> transcript-model;
    in property <bool> transcript-model-enabled;
    /// The download the Transcribe button starts first, if the chosen model
    /// isn't on disk; empty otherwise (Phase 11 S3). Written by `src/main.rs`
    /// with the rest of the row.
    in property <string> transcribe-download;
    /// The clip an inspector field is editing, set when one gains focus and
    /// cleared when the last one loses it. Commits go to it, not to the
    /// selection, which a row click has already moved by the time a field's
    /// focus-loss handler runs. `show-clip` leaves the fields alone while
    /// it's set.
    in-out property <string> editing-clip-id;
    /// The tag overview's rows, alphabetical.
    in property <[TagRow]> tag-rows;
    /// Show only the clips with this tag; empty for all (C8). UI state only.
    in-out property <string> tag-filter;
    changed tag-filter => { root.filter-changed(); }
    /// The Devices popover's lists, "System default" first. Empty while
    /// they're being looked up.
    in property <[DeviceRow]> cameras;
    in property <[DeviceRow]> mics;
    /// The Recent popover's rows, newest first, filled on open (recents P2).
    in property <[RecentRow]> recent-rows;
    /// Every row is dimmed, which Slint cannot work out from the model itself
    /// — so it is computed in Rust. It is the difference between "no projects"
    /// and "the drive those projects are on isn't mounted" (recents P5).
    in property <bool> recents-none-resolved;
    /// The popover's Inset section: the project's avatar image, its file name
    /// (empty for none), and whether that file has gone missing (avatar G1).
    in property <image> avatar-thumb;
    in property <string> avatar-name;
    in property <bool> avatar-missing;

    // --- Drawing on the picture (Phase 6 D1, D5, D6) ---

    /// Only while recording, never `starting`: `recording` is the broader
    /// "not idle".
    out property <bool> can-draw: root.recording-phase == RecordingPhase.recording;
    /// A finished drawing clears itself 5 s after the pen lifts. UI state;
    /// `src/main.rs` reads it at pen-up.
    in-out property <bool> auto-clear: true;
    /// The live overlay: one stroke still on screen per row, its commands in
    /// content-rect logical pixels. `src/main.rs` rebuilds it only when
    /// something changes (D5) — Slint re-parses a `Path` on every set.
    in property <[LiveStroke]> live-paths;
    /// The pen's width, as a fraction of the picture's height
    /// (`core::layout::STROKE_LINE_WIDTH`): the live stroke layer and the
    /// highlight rings are drawn with it, so there is one pen width and Rust
    /// owns it. Set once, at startup.
    in property <float> stroke-line-width;
    /// The player highlights showing on the picture now (spec H5), likewise
    /// in content-rect pixels and likewise rebuilt only when they change.
    /// They belong to the **footage**, not to a clip, so they show while
    /// scanning as well as while recording.
    in property <[LiveHighlight]> live-highlights;

    /// The scoreboard over the scan picture (spec S3), already rasterized by
    /// `media`'s overlay — the same code the export burns in — so there is no
    /// second drawing of the board to keep honest. It is drawn at the content
    /// rect's top-left corner, where the export puts it, at the logical size
    /// below: the image is in device pixels, so it stays crisp on a scaled
    /// display. An empty image, and a zero width, draw nothing.
    in property <image> scoreboard;
    in property <length> scoreboard-width;
    in property <length> scoreboard-height;

    // --- The H tool and the Highlights panel (spec H3) ---

    /// The tool is on. UI state: `H` toggles it and Esc leaves it.
    in-out property <bool> highlight-tool;
    /// ... and there is a picture to use it on. The touch area, the panel's
    /// hint and the swatch recolour all key off this, so a preview or an
    /// unloaded project can't leave a live tool behind. `highlight-tool`
    /// itself is left alone, so closing a preview gives the tool back.
    out property <bool> in-highlight-tool: root.highlight-tool && root.can-play && !root.previewing;
    /// Every highlight on the footage, in stored order.
    in property <[HighlightRow]> highlight-rows;
    /// The selected one's id, empty for none: a drag on its ring selects it,
    /// as does a click on its row.
    in-out property <string> selected-highlight;
    /// Its label, two-way down to the field; the window owns the value.
    in-out property <string> highlight-label;
    /// Which highlight the label field is editing, so a commit names it even
    /// after the selection has moved on -- `editing-clip-id`'s rule.
    in-out property <string> editing-highlight-id;
    /// The frame on screen carries one of the selected highlight's keys, so
    /// "Delete key here" has something to remove. From the 30 Hz tick.
    in property <bool> highlight-key-here;
    /// The stroke under the pen, likewise; empty when nothing is being drawn.
    in property <string> drawing-path;
    /// The arrowhead under the pen, so a Shift-drag shows its head as it is
    /// drawn rather than only once it is logged (BACKLOG #117).
    in property <string> drawing-arrow;
    /// ... and its colour, the pen's when it went down.
    in property <color> drawing-ink;
    /// The pens' colours, in the swatch row's order (`drawing::Pen::ALL`),
    /// and which one new strokes are drawn with. `src/main.rs` owns the
    /// choice and remembers it across sessions.
    in property <[color]> pen-colors;
    in property <int> pen-index;
    /// Which panel sections are open (BACKLOG #113), from `state.json`. One
    /// property each rather than a struct, because `MatchPanel` takes only its
    /// own and Slint binds a property, not a field of one.
    in property <bool> match-expanded: true;
    in property <bool> project-expanded: true;
    in property <bool> sources-expanded: true;
    /// Which of the two pen widths is chosen (BACKLOG #116), an index into the
    /// control's order. `int` for `pen-index`'s reason.
    in property <int> pen-width-index;

    // --- Export (Phase 8 E8): the sheet is the only export UI ---

    /// The sheet is up. UI state: the Export… button and the clip menu's
    /// "Export video…" open it, its own buttons and Esc close it.
    in-out property <bool> export-sheet-open;
    /// Its target list, in the order it shows them: All clips, each tag, then
    /// the clip the sheet was opened on. `src/main.rs` holds the targets these
    /// rows stand for, and owns the ticks.
    in property <[TargetRow]> export-targets;
    in property <bool> export-any-ticked;
    /// The pickers, seeded from the project's preferences when the sheet opens
    /// and persisted by the bus when a run starts (spec E4).
    in-out property <int> export-resolution;
    in-out property <int> export-quality;
    in-out property <int> export-scoreboard;
    in-out property <bool> export-mute-source;
    /// The two output switches: what the run leaves on disk (spec S1, #78).
    in-out property <bool> export-chapters;
    in-out property <bool> export-cues;
    /// Whether the whole-match row is ticked, which is the first term of both
    /// explanatory lines under the Scoreboard picker — only the whole match is
    /// ever copied, and both lines are about a copy.
    in property <bool> export-whole-match-ticked;
    /// The run in progress, and when it finishes; both from the bus's events,
    /// so a closed sheet reopens on the run it left.
    in property <[RunRow]> export-run;
    in property <string> export-finish;
    /// A run is going. Greys out Record, a preview and "Export video…", all of
    /// which the bus refuses while one is.
    in property <bool> exporting;

    // --- The basket (basket spec U): one film, pieces from several matches ---

    /// The sheet is up. UI state: the Basket… button opens it, its own buttons
    /// and Esc close it.
    in-out property <bool> basket-sheet-open;

    // --- New match (new match spec S1) ---
    //
    // The two names, the projects folder and the folder name are two-way, as
    // every field in this app is. The date, the provenance line and the video
    // list are the prefill's and read-only; `folder-dirty` and `creating` are
    // the sheet's own state, cleared by `close-new-match`.
    in-out property <bool> new-match-sheet-open;
    in-out property <string> new-match-home-name;
    in-out property <string> new-match-away-name;
    in-out property <string> new-match-projects-dir;
    in-out property <string> new-match-folder-name;
    /// `YYYY-MM-DD`, or empty where nothing was found. There is no date field:
    /// it goes into the folder name, where its consequence is visible (N1).
    in-out property <string> new-match-date;
    in-out property <string> new-match-provenance;
    in-out property <[string]> new-match-videos;
    /// The coach has typed in the folder field, so it is theirs from now on.
    /// **Set only by that field's own `edited`** -- never by a
    /// `changed new-match-folder-name` handler, which would self-trigger when
    /// the derivation writes the field and so kill the derivation on the first
    /// keystroke of a team name.
    property <bool> new-match-folder-dirty;
    /// In-out because the `Event::Error` arms clear it: Create disables on
    /// the click and only an error or a close re-enables it (spec S5).
    in-out property <bool> new-match-creating;
    changed new-match-home-name => { root.derive-new-match-folder(); }
    changed new-match-away-name => { root.derive-new-match-folder(); }

    /// Opens the video picker, which is what opens the sheet (spec E2).
    callback new-match();
    callback create-match();
    callback choose-projects-dir();
    pure callback team-named(string) -> bool;
    pure callback valid-folder-name(string) -> bool;
    pure callback valid-projects-dir(string) -> bool;
    pure callback target-taken(string, string) -> bool;
    /// `<date>-<home>-<away>` as one slug: the **joined** string, so the `-`
    /// collapse absorbs a blank team name or an absent date and the 64-byte cut
    /// applies to the whole name.
    pure callback new-match-folder(string, string, string) -> string;
    /// The pieces waiting, whole, from the bus's `Basket` event — which
    /// arrives at startup and on every change, so **the badge's count is right
    /// with the sheet closed and with no project open**, which is the point of
    /// the feature.
    in property <[BasketPieceRow]> basket-pieces;
    /// The film's name and the two pickers. They follow the bus's event while
    /// this sheet is **closed** — so what it opens on is the basket's — and are
    /// the sheet's own while it is up: re-seeding the name under the coach's
    /// hands is the one thing a field must never do.
    in-out property <string> basket-name;
    in-out property <int> basket-resolution;
    in-out property <int> basket-quality;
    in-out property <bool> basket-mute-source;
    /// The run in progress is the basket's, not an ordinary export's, so the
    /// sheet draws it as its own.
    in property <bool> basket-run;
    /// The sheet's own message line (basket spec C6): a refusal, or the file a
    /// finished run wrote. The status bar's notice can't stand in for it —
    /// that one renders behind the scrim.
    in-out property <string> basket-message;

    // --- Preview (Phase 7 P6) ---

    /// The clip on screen instead of the game video, empty with none, and its
    /// name for the indicator. Set from the bus's `Preview` event.
    in property <string> previewing-clip;
    in property <string> previewing-name;
    out property <bool> previewing: root.previewing-clip != "";
    /// Opening one is refused while recording or exporting (P5), and needs
    /// something to play.
    out property <bool> can-preview: root.can-play && !root.recording && !root.exporting;

    // --- Match (Phase 9 S4): the panel, the three tag keys, the setup sheet ---

    /// The project has teams: the scoreboard is drawn, and the panel shows a
    /// score and clock rather than the way in to the sheet.
    in property <bool> match-configured;
    /// The live line and clock, rendered by `src/main.rs` from the scan
    /// anchor on the tick. Frozen while a preview is open (S4).
    in property <string> match-score;
    in property <string> match-clock;
    /// Every tagged event in match order.
    in property <[MatchRow]> match-rows;
    /// The Match list's height in lines: a row each, and a second for a
    /// goal's reel span.
    in property <int> match-list-lines;
    /// A tick on the scrubber per match event (spec C1), on the concat
    /// timeline's scale.
    in property <[Mark]> match-marks;
    /// Every period of the format is tagged, so the bus would refuse another
    /// start/stop: the action is off and the panel says why (S5).
    in property <bool> match-at-cap;
    /// The one gate on tagging, shared by the three keys and the panel's
    /// buttons: while scanning or recording, never while previewing or during
    /// a recording's start-up.
    out property <bool> can-tag:
        root.can-play && !root.previewing && root.recording-phase != RecordingPhase.starting;
    /// The setup sheet is up. UI state: the panel's button opens it, its own
    /// buttons and Esc close it.
    in-out property <bool> match-sheet-open;
    /// Which of the setup sheet's six colour fields the picker is open over,
    /// -1 for none. Up here rather than inside the sheet so Esc closes the
    /// popup before the sheet (`handle-key`), and so a sheet that closes with
    /// the popup up doesn't reopen with it still showing.
    in-out property <int> match-picker-field: -1;
    /// The picker's ready-made kit colours, from `src/color_picker.rs`.
    in property <[KitColor]> kit-colors;
    /// Its fields, seeded from the project when it opens and read back on
    /// Save (`src/main.rs`). Two-way bound down to the fields, since a
    /// `text:` or `checked:` binding breaks once the user edits it.
    in-out property <string> match-home-name;
    in-out property <string> match-home-primary;
    in-out property <string> match-home-secondary;
    in-out property <string> match-home-font;
    in-out property <string> match-away-name;
    in-out property <string> match-away-primary;
    in-out property <string> match-away-secondary;
    in-out property <string> match-away-font;
    in-out property <string> match-regulation-periods;
    in-out property <string> match-regulation-minutes;
    in-out property <string> match-overtime-periods;
    in-out property <string> match-overtime-minutes;
    in-out property <bool> match-back-anchor;

    // --- The match event editor (spec P1) ---

    /// The editor sheet is up. UI state: the panel's button opens it, Done
    /// and Esc close it.
    in-out property <bool> match-editor-open;
    /// Its rows, seeded when it opens and rebuilt on every project change
    /// except while the row's field has focus (spec T3) -- `src/main.rs`
    /// owns that rule.
    in property <[MatchEditorRow]> match-editor-rows;
    /// The selected row, and that row's event as a line. Two-way down to the
    /// field, and re-seeded from the record on every rebuild.
    in-out property <string> match-editor-selected;
    in-out property <string> match-editor-line;
    /// The paste box's block and its default-video picker. The block lives
    /// here rather than in the sheet so it survives Go and closing (spec F2);
    /// the picker resets to the first video on every open.
    in-out property <string> match-editor-paste;
    in-out property <int> match-editor-source;
    in property <[string]> match-editor-sources;
    /// The sheet's own notice line (spec C5), which the status bar's can't
    /// stand in for: that one renders behind the scrim. Cleared when the
    /// sheet closes and when the next command goes out.
    in-out property <string> match-editor-message;
    /// The **row's** field has focus (see the sheet): the one state in which
    /// `src/main.rs` must not rebuild the rows. Set by the sheet and cleared
    /// when it closes, since the binding goes with the element.
    in-out property <bool> match-editor-line-focused;
    /// Bumped by `src/main.rs` on every project change: the sheet's echoes
    /// are read from the project through `pure` callbacks, and this is what
    /// tells their bindings to ask again.
    in-out property <int> project-revision;

    /// The latest notice (a device fallback, an unclean stop, an export
    /// done), shown in the transport bar without blocking; empty hides it.
    in property <string> notice;

    /// The error dialog's message; empty hides it.
    in-out property <string> error-message;
    /// J, L and the speed button (spec S1, S2): only while scanning.
    property <bool> can-scan-fast: root.playing && !root.recording && !root.previewing && root.can-play;
    /// A text field has focus: every shortcut yields to it (C6), the sheets'
    /// fields included -- without the editor's, Esc inside its paste box
    /// closes the sheet on the first press and throws away a half-typed block
    /// (spec P3).
    ///
    /// **Slint's own property, not a list of this window's fields.**
    /// `TextInput` sets it on focus-in and clears it on focus-out *and on
    /// deinit* (`i-slint-core-1.18.0/items/text.rs:1234`, `:1257`, `:839`), so
    /// there is nothing a new field can be left out of and nothing a field
    /// destroyed while focused can leave switched off. It replaces a
    /// seven-term disjunction of every field's focus -- that, the **thirteen**
    /// properties that existed only to feed it, three `<=>` wires and three
    /// hand-clears in the `close-*` functions below all went with it -- and
    /// with them the two bugs the list cost: #130 (the slate tag filter
    /// shipped as a bare `LineEdit` nobody added, so every letter typed into
    /// it fired its shortcut and `corner` was untypeable) and #123 (the gate
    /// that list repeated drifted apart from the section's own `if`). One
    /// expression has no list to join and nothing to drift from.
    property <bool> text-editing: TextInputInterface.text-input-focused;

    /// **What this key means, asked of the one table** (BACKLOG #96): the
    /// event's text and its three modifiers in, a [`KeyAction`] out.
    ///
    /// Four scalars rather than the `KeyEvent`, because `KeyEvent` is not in
    /// `slint`'s public API -- and because `repeat` is read by the *gates*,
    /// which stay here.
    ///
    /// **Not `pure`:** nothing binds on it, and the answer changes when the
    /// coach rebinds a key.
    callback action-for(string, bool, bool, bool) -> KeyAction;

    /// **Every action and the keys it answers to**, in `Action::ALL`'s order:
    /// `keymap::Keymap::listing`, set beside `action-for` in `key_action.rs`'s
    /// `wire_keys` and from nowhere else, so the list and the lookup are the
    /// same table read twice.
    in property <[KeyRow]> key-rows;
    /// The Keys sheet is up. UI state: `F1` and the Keys button open it, its
    /// Close button and Esc close it.
    in-out property <bool> keys-sheet-open;
    /// **A capture is armed for this action**, by the name `keymap.rs` stores
    /// it under; empty when none is (#96 task 5). While it is set the whole
    /// keymap is inactive and the next key the coach presses is the answer.
    ///
    /// **It lives on the window rather than in the sheet because the capture
    /// has to.** Shortcuts are dispatched window-to-focus-item *before* the
    /// focused element, so a `FocusScope` inside the sheet would never see a
    /// key the table binds -- the window would have swallowed it first.
    ///
    /// Escape is the only outcome this file decides; every other key goes to
    /// `bind-key` and **Rust clears this**, because whether what was pressed is
    /// a key at all is `keymap.rs`'s to answer and a bare modifier has to leave
    /// the capture armed.
    in-out property <string> capturing-action;
    /// The Keys sheet's own line: what a capture is waiting for, and what a
    /// rebind took from where. The status bar's notice renders *behind* the
    /// scrim, so a sheet with commands of its own needs one.
    in-out property <string> keys-message;
    /// A captured key, for the action named: its text and the three modifiers,
    /// which Rust reads as a `Binding`, stores and hands back as a new table.
    callback bind-key(string, string, bool, bool, bool);
    /// Take every key off the action named.
    callback unbind-key(string);

    callback open-project();
    callback add-source();
    callback relink-source(int);
    callback remove-source(int);
    callback move-source(int, int);
    callback rename-project(string);
    callback toggle-play();
    /// Skip by this many seconds (negative is backwards).
    callback skip(float);
    /// `,` and `.`: one frame back or forward, while paused.
    callback step-frame(bool);
    /// `J`, `L` and the speed button: a speed slower or faster, while
    /// scanning.
    callback step-scan-speed(ScanStep);
    callback scrub-move(float);
    callback scrub-release(float);
    /// A wheel over the scrubber: the scroll's deltas and whether Shift was
    /// held. It skips rather than seeking — see `wheel.rs`.
    callback scrub-scroll(length, length, bool);
    /// R, Record or Stop: the bus starts a recording when idle, else stops
    /// (or aborts) it.
    ///
    /// **It carries the selected range, and the bus decides what to do with
    /// it** (BACKLOG #120): with one, R is that range's take — seeking to its
    /// in point and stopping the footage at its out — and the clip carries the
    /// `slate_id` that marks it shot, which is what makes the themed pass two
    /// keys (spec T5). Empty for a plain take.
    ///
    /// **Why the window does not choose between this and `shoot-slate`:** the
    /// phase it would branch on lags the bus's, and a second R inside a take's
    /// start-up is a cancel the bus already honours — a `shoot-slate` sent
    /// there is refused by the recording guard, so the key would do nothing.
    /// The *mode* is still visible, which is the slates spec's §S6 objection
    /// answered: the highlighted row, and the word on the Record button.
    callback toggle-recording(string);
    /// Esc: stop (or abort) the recording.
    callback stop-recording();
    /// The Devices popover opened: look the devices up.
    callback list-devices();
    /// The Recent popover opened: fill `recent-rows` (recents P2). Named after
    /// `list-devices`, which is the same shape — the rows are read on open, so
    /// a project renamed or deleted since last time shows as it is now.
    callback list-recents();
    /// A row of the Recent popover was picked: its folder (recents O1).
    callback open-recent(string);
    /// A row of the popover's camera or microphone list was picked: its
    /// `node-name`, empty for the system default.
    callback choose-camera(string);
    callback choose-mic(string);
    /// The popover's Choose… and Remove for the avatar image: pick a PNG or a
    /// JPEG to copy into the project, or drop the one it has.
    callback choose-avatar();
    callback remove-avatar();
    /// Slates, by id. `mark-in` and `mark-out` take no argument: the bus is
    /// given the displayed frame's video and source time by `main.rs`, which
    /// is the only place that knows what is on screen.
    callback mark-in();
    callback mark-out();
    callback shoot-slate(string);
    callback delete-slate(string);
    /// Park the game video on a slate's first frame (BACKLOG #104), the clip
    /// row's "Jump to clip start".
    callback jump-to-slate(string);
    /// Watch the marked range: the jump, then play, then the stop at the out
    /// point (spec P2). The row's double-click, as a clip row's double-click
    /// is its jump.
    callback preview-slate(string);
    callback edit-slate-field(SlateField, string);
    /// Move the selected slate's in or out point to the playhead (BACKLOG
    /// #119). No position argument: Rust reads the same heading position `i`
    /// and `o` do, so a re-mark lands where a fresh mark would.
    callback set-slate-mark(SlateMark);
    /// The slates' tag filter changed: rebuild the list (BACKLOG #120).
    callback filter-slates();
    /// Focus a slate field, for `tests/slate_fields.rs`: both failures that
    /// test pins are about a *focused* field, and tabbing to one depends on
    /// the whole window's focus order.
    public function focus-slate-name() { slate-name-edit.focus(); }
    public function focus-slate-tags() { slate-tags-edit.focus(); }
    /// The clip inspector's tag field, for the test that pins Tab and Esc in
    /// the shared `TagField` from both of its two sites.
    public function focus-clip-tags() { inspector.focus-tags(); }
    /// Seeds the two fields from the selected slate, as `show-clip` does for
    /// the inspector.
    callback show-slate();
    /// Clips (Phase 3 C5), by id; `move-clip` takes list indices.
    callback jump-to-clip(string);
    callback delete-clip(string);
    callback move-clip(int, int);
    callback sort-clips();
    /// Open the export sheet on the selection, with everything else ticked
    /// (the Export… button) ...
    callback open-export();
    /// ... or on this clip alone, ticked (the clip menu's "Export video…").
    callback export-clip(string);
    /// The target row at this index was ticked or unticked.
    callback tick-target(int, bool);
    /// Export what's ticked, at the pickers' resolution and quality.
    callback start-export();
    callback cancel-export();
    /// The basket (basket spec C1). `open-basket` also asks the bus for it, so
    /// the rows are resolved against their projects as the sheet opens.
    callback open-basket();
    /// The clip menu's "Add to basket", on the row it was opened on.
    callback add-to-basket(string);
    callback remove-basket-piece(int);
    callback move-basket-piece(int, int);
    callback clear-basket();
    /// Render the basket as one film, under the name and pickers as they
    /// stand — which become the basket's either way.
    callback start-basket();
    /// Preview the clip with this id, in place of the game video, and close
    /// the one open (P5).
    callback open-preview(string);
    callback close-preview();
    /// Match events (Phase 9 S4), by the event's id where they name one. The
    /// tag's position is the readout's, taken in `src/main.rs` at the input
    /// event, as the bus contract requires.
    callback tag-match-event(MatchTag);
    callback seek-match-event(string);
    callback delete-match-event(string);
    /// A goal row's reel buttons (R3). The scan position is taken in
    /// `src/main.rs` at the click, as a tag's is.
    callback reel-trim(string, ReelTrim);
    /// `]` (true) or `[`: the next or previous chapter (spec C1).
    callback jump-chapter(bool);
    /// Seed the editor's rows from the project and open it.
    callback open-match-editor();
    /// A row was clicked: seed its field with that event as a line.
    callback select-match-event(string);
    /// Esc in the row's field: put the selected event's line back in it,
    /// undoing whatever was typed (spec P3).
    callback reseed-match-line();
    /// A row's field committed: the event's id and the line typed into it.
    callback edit-match-event(string, string);
    /// Add every line of the paste box that will add, as one undo step, and
    /// leave the rest in the box (spec B5).
    callback add-match-events();
    /// Whether a row's line parses, asked of the record it names: the field's
    /// ✕ and the commit share it (spec T5).
    pure callback valid-match-line(string, string) -> bool;
    /// The paste box's block, read back line by line, against the picker's
    /// default video. The third argument is `project-revision`, which is
    /// what makes a `pure` callback that reads the project re-run when it
    /// changes.
    pure callback check-paste(string, int, int) -> PasteEcho;
    /// Seed the setup sheet's fields from the project and open it; the sheet
    /// is opened nowhere else, so the fields are never stale.
    callback open-match-setup();
    /// Save the setup sheet's fields as the project's scoreboard.
    callback save-match-setup();
    /// A colour field's text as a colour, and the sheet's validators, which
    /// take their text so the bindings re-evaluate as it's typed.
    pure callback hex-color(string) -> color;
    pure callback valid-name(string) -> bool;
    pure callback valid-hex(string) -> bool;
    /// The picker's two conversions, both `src/color_picker.rs`'s: the hex
    /// string is what the project stores, so there is one path to a colour in
    /// this app and these go through it.
    pure callback hsv-of-hex(string) -> Hsv;
    pure callback hex-of-hsv(float, float, float) -> string;
    pure callback valid-periods(string) -> bool;
    pure callback valid-overtime-periods(string) -> bool;
    pure callback valid-minutes(string) -> bool;
    /// The sheet's warning for start/stops the format being typed has no
    /// period for, empty when there are none. The back-anchor is an argument
    /// because its derived start takes one of those periods.
    pure callback match-over-cap(string, string, bool) -> string;
    callback undo();
    callback redo();
    /// An inspector field's commit for clip `id`.
    callback edit-clip(string, ClipField, string);
    callback set-show-pip(string, bool);
    /// Clip `id`'s inset size or corner, by index into the picker's model
    /// (#88 spec I7). Each also makes the choice the next recording's, by the
    /// write-back in `Bus::edit_clip`.
    callback set-inset-size(string, int);
    callback set-inset-corner(string, int);
    /// Queue clip `id`'s commentary for transcription (Phase 10 S6).
    callback transcribe(string);
    /// Stop the transcription running and drop the queue behind it.
    callback cancel-transcription();
    /// Run this speech model from now on, by index into `transcript-models`.
    callback set-transcribe-model(int);
    /// Render the inspector's fields from the selected clip, unless one is
    /// being edited.
    callback show-clip();
    /// `tag-filter` changed: list the clips it lets through.
    callback filter-changed();
    pure callback suggest-tags(string) -> [string];
    pure callback take-suggestion(string, string) -> string;
    callback volume-changed(float);
    callback volume-released(float);
    /// Zoom keys (spec D9): `1`/`Ctrl+0` reset; `2`/`3` step the scale about
    /// the pointer at (x, y) when it's over the player (the bool).
    callback zoom-reset();
    callback zoom-step(float, bool, length, length);
    /// Drawing (Phase 6 D2): the pen went down at (x, y) over the picture,
    /// moved with it down, and came up. Content-rect relative, and the last
    /// two may be outside it: Slint grabs the pointer on press.
    /// The pen went down. The third argument is **Shift at pen-down**, which
    /// makes the stroke an arrow (BACKLOG #117) — read here rather than in Rust
    /// because only the event carries it, and captured once because Shift
    /// released mid-drag must not un-arrow a gesture the coach began as one.
    callback draw-press(length, length, bool);
    callback draw-move(length, length);
    callback draw-release(length, length);
    /// The grab was taken away mid-stroke (see the drawing area): whatever is
    /// under the pen is dropped, unlogged.
    callback draw-cancel();
    /// The H tool (spec H3): a press over the picture, and the release that
    /// makes the box a key. Content-rect relative, like the pen's, and the
    /// release may be outside it: Slint grabs the pointer on press.
    callback highlight-press(length, length);
    callback highlight-release(length, length);
    /// The grab was taken away mid-drag: the box is dropped.
    callback highlight-cancel();
    /// The Highlights panel's rows.
    callback select-highlight(string);
    callback delete-highlight(string);
    /// "Delete key here": the selected highlight's key on the frame on screen.
    callback delete-highlight-key(string);
    /// The label field committed with Enter, or lost focus, which commits
    /// too. Gaining focus is the window's own business: it only notes which
    /// highlight the field is on.
    callback commit-highlight-label(string);
    callback end-highlight-label(string);
    /// Clear: the button, or C.
    callback clear-drawings();
    /// A swatch was clicked: draw with the pen at this index from now on.
    callback pick-pen(int);
    /// A section's header was clicked (BACKLOG #113): its name, which Rust
    /// turns into the one `Folds` field. A string rather than three callbacks,
    /// so a new foldable section needs no new plumbing.
    callback toggle-fold(string);
    /// A pen width was picked (BACKLOG #116), by index into the control's
    /// order. It changes the next stroke, never one already drawn.
    callback pick-pen-width(int);
    /// Drag-to-reorder payload: a row index of the named list ("sources" or
    /// "clips") to and from `data-transfer`; -1 when it's another list's.
    pure callback drag-payload(string, int) -> data-transfer;
    pure callback dropped-index(string, data-transfer) -> int;

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    /// Closes the setup sheet, however it was closed, and puts focus back on
    /// the window so the shortcuts work again. The colour picker goes with
    /// it: the sheet that held it is about to be destroyed, and reopening on
    /// a popup over last time's field would be a surprise.
    function close-match-setup() {
        root.match-picker-field = -1;
        root.match-sheet-open = false;
        keys.focus();
    }

    /// Closes the editor, however it was closed. It clears `line-focused` by
    /// hand: the sheet that sets it is about to be destroyed, and a row's
    /// field that had focus would otherwise leave `src/main.rs` believing the
    /// rows must not be rebuilt. (Nothing clears `text-editing` here: it is
    /// Slint's own, and `keys.focus()` below takes the focus off the field.)
    /// The message goes with it (spec C5); the paste box's text stays.
    function close-match-editor() {
        root.match-editor-line-focused = false;
        root.match-editor-message = "";
        root.match-editor-open = false;
        keys.focus();
    }

    /// Closes the basket sheet, however it was closed. The message goes with
    /// it (basket spec C6); the pieces are the bus's and stay.
    function close-basket() {
        root.basket-message = "";
        root.basket-sheet-open = false;
        keys.focus();
    }

    /// Closes the New match sheet, however it was closed -- Cancel, Esc or the
    /// `ProjectOpened` that says the project exists (spec C5).
    ///
    /// **`creating` and the dirty flag go with it**: without that, the next
    /// New match… would open with a dead Create button, and a folder name that
    /// no longer follows the teams being typed into it.
    public function close-new-match() {
        // Every `ProjectOpened` calls this, including the startup restore and a
        // plain `Open Project…`, and it ends in `keys.focus()` — so without this
        // guard an unrelated open steals focus for a sheet that was never up.
        if (!root.new-match-sheet-open) {
            return;
        }
        root.new-match-creating = false;
        root.new-match-folder-dirty = false;
        root.new-match-sheet-open = false;
        keys.focus();
    }

    /// Re-derives the folder name from the date and the two team names, unless
    /// the coach has taken the field over (spec N1). Imperative, on
    /// `saved-project-name`'s pattern above, because `SetupField`'s text is
    /// two-way bound all the way out here: a `text:` binding on it breaks the
    /// moment the field is typed into.
    public function derive-new-match-folder() {
        if (!root.new-match-folder-dirty) {
            root.new-match-folder-name = root.new-match-folder(root.new-match-date,
                root.new-match-home-name, root.new-match-away-name);
        }
    }

    /// ⇄: exchanges the two names, and the folder name follows them.
    function swap-new-match-teams() {
        let held = root.new-match-home-name;
        root.new-match-home-name = root.new-match-away-name;
        root.new-match-away-name = held;
        root.derive-new-match-folder();
    }

    /// One of the three match tag keys (S4), under the gate the panel's
    /// buttons share -- the cap included, which only the start/stop has: the
    /// bus refuses a tag there, and that refusal is a backstop, not something
    /// to walk into from the keyboard mid-recording. A held key must not
    /// insert a goal per repeat, and the key is swallowed either way, as `c`
    /// and `r` are.
    function tag-key(kind: MatchTag, event: KeyEvent, pressed: bool) -> EventResult {
        if (pressed && !event.repeat && root.can-tag
            && !(kind == MatchTag.start-stop && root.match-at-cap)) {
            root.tag-match-event(kind);
        }
        return accept;
    }

    /// Spec D10: every shortcut, ahead of whichever child has focus, so a
    /// touched slider never turns arrows into volume or scrub steps. Called
    /// for releases too (`pressed` false), which are swallowed for the same
    /// keys: a slider fires `released` on an arrow key's release.
    function handle-key(event: KeyEvent, pressed: bool) -> EventResult {
        if (root.error-message != "") {
            // Modal: nothing reaches the window behind the dialog.
            if (pressed && (event.text == Key.Return || event.text == Key.Escape)) {
                root.error-message = "";
            }
            return accept;
        }
        // **A capture is the innermost modal there is** (#96 task 5): armed
        // from a row's *Set...*, it makes the whole keymap inactive and the
        // next key the coach presses that row's. Ahead of the Keys sheet it is
        // run from, because the sheet below swallows every key and would
        // swallow the answer.
        //
        // **Escape is the only key decided here.** It cancels, and needs no
        // round trip. Everything else -- a letter, a named key, a modifier
        // pressed on the way to one -- goes to Rust, which owns
        // `capturing-action` from then on: only `keymap.rs` can say whether a
        // press is a key to bind, and a bare Ctrl has to leave the capture
        // armed for the key the coach is reaching for.
        //
        // Releases are swallowed and harvest nothing: the press is the answer,
        // and its release would otherwise fall through to the table and fire
        // whatever the new key used to do.
        if (root.capturing-action != "") {
            if (pressed && !event.repeat) {
                if (event.text == Key.Escape) {
                    root.capturing-action = "";
                    root.keys-message = "";
                } else {
                    root.bind-key(root.capturing-action, event.text,
                        event.modifiers.control, event.modifiers.shift,
                        event.modifiers.alt);
                }
            }
            return accept;
        }
        // The Keys sheet is modal too, and it is the export sheet's shape
        // exactly: Esc closes it and every other key is swallowed -- `F1`
        // included, so the key that opens it cannot also reopen it from
        // underneath itself.
        //
        // **No `text-editing` term, because it has no field** (#96): its rows
        // carry buttons rather than fields, and a capture is the layer above
        // rather than a focused input. Tested here, third, because that mirrors
        // the sheet stack's z-order -- this sheet is drawn over every other and
        // under the error dialog alone, and the capture is over all of them.
        if (root.keys-sheet-open) {
            if (pressed && event.text == Key.Escape) {
                root.keys-sheet-open = false;
            }
            return accept;
        }
        // The export sheet is modal over the window's shortcuts: Esc closes
        // it, and a run it started goes on behind it.
        if (root.export-sheet-open) {
            if (pressed && event.text == Key.Escape) {
                root.export-sheet-open = false;
            }
            return accept;
        }
        // The basket sheet is modal too, and it has a field of its own. Esc
        // closes it from *outside* the name field; inside one it leaves the
        // field first and the next Esc closes, which is the editor's shape.
        // The cascade is live because `text-editing` is Slint's own
        // `text-input-focused` and so covers the name field without being
        // told about it; against a constant the test below would be always
        // true (or always false) and the cascade dead code. The `reject` is
        // also what delivers Ctrl+V to the field.
        if (root.basket-sheet-open) {
            if (pressed && event.text == Key.Escape && !root.text-editing) {
                root.close-basket();
                return accept;
            }
            return reject;
        }
        // The New match sheet is modal too, and it takes the basket's shape
        // rather than the setup sheet's: Esc closes it from *outside* a field;
        // inside one it leaves the field first and the next Esc closes. That is
        // the more expensive sheet to reopen -- the setup sheet costs one click
        // on a shipped project, this one costs re-walking the file picker and
        // re-picking every video (spec S6). The guard is live for the reason
        // the basket's is: `text-editing` is Slint's own, so it covers these
        // four fields without being told about them. The `reject` is also
        // what delivers Ctrl+V into the path field.
        if (root.new-match-sheet-open) {
            if (pressed && event.text == Key.Escape && !root.text-editing) {
                root.close-new-match();
                return accept;
            }
            return reject;
        }
        // The match setup sheet is modal too, and it has fields of its own:
        // Esc closes it, and everything else goes to whatever in it has
        // focus. Ahead of the Esc cascade and the tag keys, so neither fires
        // behind it.
        //
        // An open colour picker takes the first Esc: it is the innermost
        // thing on screen, and a coach who opened it to look at the kit
        // colours should not lose the whole setup to one key.
        if (root.match-sheet-open) {
            if (pressed && event.text == Key.Escape) {
                if (root.match-picker-field >= 0) {
                    root.match-picker-field = -1;
                } else {
                    root.close-match-setup();
                }
                return accept;
            }
            return reject;
        }
        // The editor is modal too, and it has fields of its own -- but
        // unlike the setup sheet's, they are not re-seeded from the project
        // every time it opens: a half-typed paste is not something to throw
        // away on one Esc. So Esc only closes the sheet from *outside* a
        // field; inside one it leaves the field first, and the next Esc
        // closes (spec P3). The `reject` is also what delivers Ctrl+V to the
        // paste box, since the Ctrl branch below is never reached from in
        // here.
        if (root.match-editor-open) {
            if (pressed && event.text == Key.Escape) {
                // **Esc in a row's field cancels**, which everywhere else in
                // this app is what Esc means. Leaving the field commits it
                // (the cascade below), so the line has to go back to what
                // the row was seeded with *first*; the commit that follows
                // then edits nothing.
                if (root.match-editor-line-focused) {
                    root.reseed-match-line();
                    keys.focus();
                    return accept;
                }
                if (!root.text-editing) {
                    root.close-match-editor();
                    return accept;
                }
            }
            return reject;
        }
        // The field gets them all, Esc included: it bubbles back to
        // `key-pressed` below.
        if (root.text-editing) {
            return reject;
        }
        // **The three reserved keys, ahead of the table** (spec G4). Home and
        // End do nothing and are swallowed anyway, because a touched slider
        // would otherwise take them; Escape is the one key with a position
        // rather than a job -- back out of the innermost thing on screen --
        // and one of its seven jobs is Slint's own popover dismissal, after
        // both dispatch phases, where nothing written here runs. None of the
        // three is a `keymap::Action`, and they are tested ahead of the lookup
        // so that a hand-edited `state.json` claiming one cannot leave a sheet
        // unleavable.
        if (event.text == Key.Home || event.text == Key.End) {
            return accept;
        }
        // Esc cascade (C6, P6, H3): the dialog above, then the H tool, then
        // the recording, then the preview, then the selection.
        //
        // **The tool goes before the recording** (H3): in it the first Esc
        // deselects and the next leaves the tool, so a coach ringing a
        // player during a paused take never stops the take with it.
        if (event.text == Key.Escape) {
            if (pressed) {
                if (root.in-highlight-tool) {
                    if (root.selected-highlight != "") {
                        root.selected-highlight = "";
                    } else {
                        root.highlight-tool = false;
                    }
                } else if (root.recording) {
                    root.stop-recording();
                } else if (root.previewing) {
                    root.close-preview();
                } else {
                    // **Both lists' selections, not the clips' alone**: a
                    // slate row stopped toggling when it gained a
                    // double-click (BACKLOG #104), so Esc is now the only way
                    // out of a slate selection, and "the selection" in a
                    // panel with two lists means whichever one is set. Each
                    // row's own list has a selection of at most one, so there
                    // is nothing to order here.
                    root.selected-clip = "";
                    root.selected-slate = "";
                }
            }
            return accept;
        }
        // **One lookup, and it is the whole of what a key *is*** (BACKLOG
        // #96). Every binding lives in `keymap.rs`, read once at startup and
        // asked here; what is left in this function is what each action
        // *does* and the gate on doing it, which are Slint's because the
        // things they touch are (`highlight-tool`, `selected-clip`, the
        // zoom's hover arguments). The branches below are in the table's own
        // order, so the two can be read side by side.
        //
        // **Asked before any `pressed` test, and that is load-bearing.**
        // `handle-key` runs for releases too (`capture-key-released` below),
        // and a bound key is swallowed on the way up as well as down: a
        // slider fires `released` on an arrow key's release. A lookup behind
        // `if (pressed)` would reject every release and hand it to a touched
        // volume slider, which is the one way to get this re-keying wrong.
        //
        // **And every `accept` below stays outside its guard**, for the other
        // half of the same reason (spec D10): a gate that suppressed the
        // *match* would send the key to the focused child in exactly the case
        // the gate refuses it. That is also why the table carries no `when`
        // clause -- the gates are here, in the branch, and nowhere else.
        let act = root.action-for(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt);
        // Not while recording, which the bus refuses.
        if (act == KeyAction.open-project) {
            if (pressed && !root.recording) {
                root.open-project();
            }
            return accept;
        }
        if (act == KeyAction.undo) {
            if (pressed && !root.recording) {
                root.undo();
            }
            return accept;
        }
        if (act == KeyAction.redo) {
            if (pressed && !root.recording) {
                root.redo();
            }
            return accept;
        }
        // Clear the drawings (D6). A held C would clear over and over, which
        // does nothing but log.
        if (act == KeyAction.clear-drawings) {
            if (pressed && !event.repeat && root.can-draw) {
                root.clear-drawings();
            }
            return accept;
        }
        // The in and out of a range, the editing convention. Gated on
        // `can-tag` like the three tags below -- the same "there is a frame on
        // screen and it is the game's" test -- and on `!event.repeat`, or a
        // held key marks a slate per repeat.
        if (act == KeyAction.mark-in) {
            if (pressed && !event.repeat && root.can-tag) {
                root.mark-in();
            }
            return accept;
        }
        if (act == KeyAction.mark-out) {
            if (pressed && !event.repeat && root.can-tag) {
                root.mark-out();
            }
            return accept;
        }
        // The three match tags (S4): direct keys, since this port has them
        // free -- no event mode, so no second gate on the zoom keys and no
        // extra layer in the Esc cascade.
        if (act == KeyAction.tag-home-goal) {
            return root.tag-key(MatchTag.home-goal, event, pressed);
        }
        if (act == KeyAction.tag-away-goal) {
            return root.tag-key(MatchTag.away-goal, event, pressed);
        }
        if (act == KeyAction.tag-period) {
            return root.tag-key(MatchTag.start-stop, event, pressed);
        }
        // The H tool (spec H3), under the tag keys' gate: like them it works
        // while a recording is paused, because a highlight belongs to the
        // footage rather than to the take. It toggles, so a held key would
        // toggle straight back.
        if (act == KeyAction.highlight-tool) {
            if (pressed && !event.repeat && root.can-tag) {
                root.highlight-tool = !root.highlight-tool;
            }
            return accept;
        }
        // Record and play both toggle, so an auto-repeat would toggle
        // straight back.
        if (act == KeyAction.toggle-recording) {
            if (pressed && !event.repeat) {
                root.toggle-recording(root.selected-slate);
            }
            return accept;
        }
        if (act == KeyAction.delete-clip) {
            if (pressed && !root.recording && root.selected-clip != "") {
                root.delete-clip(root.selected-clip);
            }
            return accept;
        }
        if (act == KeyAction.toggle-play) {
            if (pressed && !event.repeat) {
                root.toggle-play();
            }
            return accept;
        }
        // **The far skip is its own pair of actions** (spec G2), not a Shift
        // read inside the near one: a modifier consulted in the body is a
        // binding the sheet cannot list and the coach cannot move. The cost,
        // named: Shift+letter now fires nothing of its own, so Shift+R no
        // longer records.
        if (act == KeyAction.skip-back) {
            if (pressed) {
                root.skip(-3);
            }
            return accept;
        }
        if (act == KeyAction.skip-forward) {
            if (pressed) {
                root.skip(3);
            }
            return accept;
        }
        if (act == KeyAction.skip-back-far) {
            if (pressed) {
                root.skip(-10);
            }
            return accept;
        }
        if (act == KeyAction.skip-forward-far) {
            if (pressed) {
                root.skip(10);
            }
            return accept;
        }
        // One frame while paused; the bus refuses it while playing. Held, it
        // repeats, as the skips do.
        if (act == KeyAction.step-back) {
            if (pressed && !root.recording && !root.previewing && root.can-play) {
                root.step-frame(false);
            }
            return accept;
        }
        if (act == KeyAction.step-forward) {
            if (pressed && !root.recording && !root.previewing && root.can-play) {
                root.step-frame(true);
            }
            return accept;
        }
        // The next or previous match event (C1), with a Match row's seek
        // gate: the seek is a scrub release, which the bus refuses while
        // recording, and it belongs to the game video behind a preview.
        if (act == KeyAction.prev-event) {
            if (pressed && !root.recording && !root.previewing && root.can-play) {
                root.jump-chapter(false);
            }
            return accept;
        }
        if (act == KeyAction.next-event) {
            if (pressed && !root.recording && !root.previewing && root.can-play) {
                root.jump-chapter(true);
            }
            return accept;
        }
        // Faster or slower while scanning (spec S1): up to 32x, down to 1x.
        // Not while recording or previewing, which are 1x.
        if (act == KeyAction.scan-slower) {
            if (pressed && !event.repeat && root.can-scan-fast) {
                root.step-scan-speed(ScanStep.slower);
            }
            return accept;
        }
        if (act == KeyAction.scan-faster) {
            if (pressed && !event.repeat && root.can-scan-fast) {
                root.step-scan-speed(ScanStep.faster);
            }
            return accept;
        }
        // Fit the window to the footage (spec W1, W3). Beside the zoom
        // actions below, which is the company it keeps: it changes what the
        // picture is drawn in, not what is played. Gated on `can-fit` alone --
        // Rust folds `can-play` and the frame's shape into it -- and on
        // `!event.repeat`, since a held key would ask the window manager to
        // resize per repeat and only the first would have anything to take
        // off.
        if (act == KeyAction.fit-window) {
            if (pressed && !event.repeat && root.can-fit) {
                root.fit-window();
            }
            return accept;
        }
        // Not while previewing: the picture is at identity zoom then (P6), so
        // a change would only show once it closes.
        if (act == KeyAction.zoom-reset) {
            if (pressed && !root.previewing) {
                root.zoom-reset();
            }
            return accept;
        }
        if (act == KeyAction.zoom-out) {
            if (pressed && !root.previewing) {
                root.zoom-step(-0.25, zoom-area.has-hover, zoom-area.mouse-x, zoom-area.mouse-y);
            }
            return accept;
        }
        if (act == KeyAction.zoom-in) {
            if (pressed && !root.previewing) {
                root.zoom-step(0.25, zoom-area.has-hover, zoom-area.mouse-x, zoom-area.mouse-y);
            }
            return accept;
        }
        // The Keys sheet (#96): what every key does, including this one. No
        // gate -- it reads a table the window always has -- and no
        // `keys.focus()`, because the `text-editing` layer above has already
        // rejected the key if a field had focus. The Keys button beside `Fit`
        // is the same door for the coach who never presses F1.
        if (act == KeyAction.show-keys) {
            if (pressed) {
                root.keys-sheet-open = true;
            }
            return accept;
        }
        // The Recent popover from the keyboard (#96 task 5). **The one row in
        // the table that ships bound to nothing** -- no letter was worth
        // taking for it when `Recent ▾` is a click away -- so this branch is
        // unreachable until a coach binds it, and it exists so that binding it
        // gets the popover rather than a dead key.
        //
        // `keys.focus()` before `show()`, for the button's own reason:
        // `show_popup` takes the window's focus item, so a half-typed clip
        // name or editor row would commit as a side effect of opening this.
        // Gated as the button is: the bus refuses a project switch mid-take.
        if (act == KeyAction.show-recents) {
            if (pressed && !event.repeat && !root.recording && !root.previewing) {
                keys.focus();
                root.list-recents();
                recent-popup.show();
            }
            return accept;
        }
        // **The fall-through is `reject`, and that is the Ctrl branch this
        // chain replaced.** Its only job once the table compares the three
        // modifiers exactly was to deliver every *other* Ctrl combo to
        // whatever has focus -- Ctrl+V into a field, Ctrl+A to select all --
        // which is what landing here does. Every one of the 29 actions now has
        // a branch above it.
        reject
    }

    keys := FocusScope {
        capture-key-pressed(event) => {
            root.handle-key(event, true)
        }
        capture-key-released(event) => {
            root.handle-key(event, false)
        }
        // Esc a field didn't take leaves it, which commits it (C6). The only
        // way out of the notes field by keyboard.
        key-pressed(event) => {
            if (root.text-editing && event.text == Key.Escape) {
                keys.focus();
                return accept;
            }
            reject
        }

        VerticalLayout {
            HorizontalLayout {
                // --- Sidebar ---
                sidebar-column := Rectangle {
                    // The stored width is stated as what this column wants and
                    // will accept; the layout is what reconciles it with the
                    // window and the other two. The obvious alternative —
                    // `width: clamp(stored, own-min, root.width - other -
                    // player-min)` — is measurably wrong. At a 1100px window
                    // with the two splitters and stored `(sidebar 100,
                    // inspector 700)`:
                    //
                    //     form                sidebar  inspector  player
                    //     clamp on `width`    240      540        308
                    //     layout constraints  240      528        320
                    //
                    // 308 is under `player-min`: each column's clamp works out
                    // its headroom from the other's *raw* property, and neither
                    // knows the splitters are in the layout too. At
                    // `(400, 400)` it is 380/380/328 against 384/384/320; at
                    // the defaults the two agree (240/280/568). The constraint
                    // form also never reads `root.width`, so it cannot close a
                    // binding loop from inside a child whose width feeds it.
                    min-width: root.sidebar-min;
                    preferred-width: max(root.sidebar-min, root.sidebar-width);
                    max-width: max(root.sidebar-min, root.sidebar-width);
                    horizontal-stretch: 0;
                    background: Palette.alternate-background;

                    // Empty space: off any field (C6), which Slint doesn't do
                    // on a click.
                    TouchArea {
                        clicked => { keys.focus(); }
                    }

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        FoldHeader {
                            title: "Project";
                            expanded: root.project-expanded;
                            // Folded, the header is the project's name, which
                            // is the whole of what this section says.
                            summary: root.saved-project-name;
                            toggled => {
                                keys.focus();
                                root.toggle-fold("project");
                            }
                        }

                        // **`visible`, not `if`.** A fold that *removed* this
                        // would take a focused `LineEdit` out from under the
                        // coach mid-edit, which is the bug `0172fdd` fixed for
                        // the slate fields: typing was lost and every shortcut
                        // went dead. Dropping focus in `toggled` above is the
                        // other half — together they mean a half-typed rename
                        // is committed-or-reverted by the field's own
                        // `has-focus` rule before it goes.
                        name-edit := LineEdit {
                            visible: root.project-expanded;
                            height: root.project-expanded ? self.preferred-height : 0px;
                            enabled: root.has-project && !root.recording;
                            placeholder-text: root.has-project ? "" : "No project";
                            text <=> root.project-name;
                            accepted(name) => {
                                root.rename-project(name);
                                keys.focus();
                            }
                            // Accepting or leaving the field shows the saved
                            // name, so an empty, unchanged or abandoned edit
                            // doesn't linger.
                            changed has-focus => {
                                if (!self.has-focus) {
                                    root.project-name = root.saved-project-name;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            FoldHeader {
                                title: "Sources";
                                expanded: root.sources-expanded;
                                // **Folded must not hide a problem**: a coach
                                // could otherwise export against a source they
                                // never saw was gone. The count is the one
                                // thing the header has to carry.
                                summary: root.missing-index >= 0
                                    ? "1 missing" : root.sources.length + " videos";
                                summary-warns: root.missing-index >= 0;
                                toggled => {
                                    keys.focus();
                                    root.toggle-fold("sources");
                                }
                            }
                            // Adding the second half's video is the one thing a
                            // coach does to Sources after setup, so it stays
                            // reachable folded.
                            if !root.sources-expanded: Button {
                                text: "+";
                                enabled: root.has-project && !root.recording;
                                clicked => { keys.focus(); root.add-source(); }

                                Tooltip {
                                    text: @markdown("Add a source video");
                                }
                            }
                        }

                        if root.sources-expanded: ListView {
                            for source[index] in root.sources: Rectangle {
                                height: 48px;
                                background: drop.has-drag ? Palette.selection-background : transparent;
                                border-radius: 4px;

                                drop := DropArea {
                                    enabled: !root.recording;
                                    can-drop(event) => {
                                        root.dropped-index("sources", event.data) >= 0 ? DragAction.move : DragAction.none
                                    }
                                    dropped(event) => {
                                        root.move-source(root.dropped-index("sources", event.data), index);
                                        DragAction.move
                                    }

                                    DragArea {
                                        enabled: !root.recording;
                                        allow-move: true;
                                        data: root.drag-payload("sources", index);

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 2px;
                                            spacing: 6px;

                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 2px;

                                                Text {
                                                    text: source.name;
                                                    color: Palette.foreground;
                                                    overflow: elide;
                                                }

                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    Text {
                                                        text: source.duration;
                                                        color: Palette.alternate-foreground;
                                                        font-size: 11px;
                                                    }
                                                    if source.missing: Text {
                                                        text: "Missing";
                                                        color: #ff6b6b;
                                                        font-size: 11px;
                                                    }
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                Button {
                                                    text: "×";
                                                    accessible-label: "Remove";
                                                    enabled: !source.referenced && !root.recording;
                                                    clicked => {
                                                        root.remove-source(index);
                                                    }

                                                    Tooltip {
                                                        text: source.referenced
                                                            ? @markdown("Used by a clip, a match event, a highlight or a slate. Delete those first.")
                                                            : @markdown("Remove from the project");
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Slates: ranges marked while watching, waiting for
                        // their commentary. **Hidden entirely when there are
                        // none**, which is every project that has never marked
                        // one -- a third list in a 240 px column would
                        // otherwise shrink the clip list on every project for
                        // a feature not in use. Capped in height for the same
                        // reason.
                        //
                        // **Or whenever a tag filter is set** (BACKLOG #123),
                        // including when it matches nothing. `slates` is the
                        // *filtered* list -- #120's filter changed what this
                        // gate reads without changing the gate -- so the count
                        // alone took the filter field away along with the rows
                        // and stranded the filter with no way to clear it. And
                        // typing a tag passes through "matches nothing" on the
                        // first letter, so that was every use of it, not an
                        // edge case. The original reason survives untouched:
                        // a project that has never marked a slate has no
                        // filter either, so it still shows nothing.
                        if root.slates.length > 0 || root.slate-tag-filter != "": VerticalLayout {
                            spacing: 6px;

                            HorizontalLayout {
                                spacing: 6px;

                                Text {
                                    text: "Slates";
                                    color: Palette.alternate-foreground;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                // The themed pass's filter (BACKLOG #120): "all
                                // these clips are corner kicks". **Its own
                                // property, not the window's `tag-filter`** —
                                // that one is *written by the bus* on
                                // `Event::Select` to un-hide a newly selected
                                // clip, which would clear this one mid-pass.
                                // **It joins nothing** (#130). This field
                                // shipped as a bare `LineEdit` that was never
                                // added to the window's list of focused
                                // fields, so every letter typed into it fired
                                // its shortcut instead -- `i` and `o` marking
                                // a slate in and out, and `corner` untypeable.
                                // `text-editing` is Slint's own
                                // `TextInputInterface.text-input-focused`
                                // now, so there is no list to be left out of.
                                // Named for `tests/ui/text_editing.rs`.
                                slate-filter-edit := LineEdit {
                                    placeholder-text: "Filter by tag";
                                    text <=> root.slate-tag-filter;
                                    horizontal-stretch: 1;
                                }
                                // Clearing is one press, not a select-all: the
                                // field is narrow in a 240 px column and the
                                // filter is a thing the coach turns *off* as
                                // often as on, between one theme and the next.
                                Button {
                                    text: "✕";
                                    enabled: root.slate-tag-filter != "";
                                    clicked => {
                                        root.slate-tag-filter = "";
                                        keys.focus();
                                    }

                                    Tooltip {
                                        text: @markdown("Clear the tag filter");
                                    }
                                }
                            }

                            // Why the list is empty, rather than a blank panel
                            // that reads as "your slates are gone" (#123). Only
                            // reachable with a filter set: with none, the
                            // section above is hidden entirely.
                            if root.slates.length == 0: Text {
                                text: "No slates tagged " + root.slate-tag-filter;
                                color: Palette.alternate-foreground;
                                font-size: 11px;
                                wrap: word-wrap;
                            }

                            if root.slates.length > 0: ListView {
                                height: min(root.slates.length * 30px + 4px, 124px);

                                    for slate[index] in root.slates: Rectangle {
                                        height: 30px;
                                        border-radius: 4px;
                                        background: slate.id == root.selected-slate
                                            ? Palette.selection-background
                                            : transparent;

                                        TouchArea {
                                            enabled: !root.recording;
                                            // **Selects, never toggles**
                                            // (BACKLOG #104): a double-click
                                            // delivers two clicks first, so a
                                            // toggle would preview the range
                                            // and leave the row deselected --
                                            // and the span on the scrubber is
                                            // the *selected* slate's (spec
                                            // S6), so the arm and the span
                                            // would then disagree. Esc clears
                                            // it, as it does a clip's.
                                            clicked => {
                                                root.selected-slate = slate.id;
                                                // Off any field, so the keys
                                                // work -- the clip row's rule.
                                                keys.focus();
                                            }
                                            // The click above has already
                                            // selected this row, which is
                                            // what keeps the arm and the
                                            // span in step — see the
                                            // menu's Preview item.
                                            //
                                            // The preview's gate is a guard
                                            // here rather than on the
                                            // `enabled` above, which also
                                            // governs the click: selecting a
                                            // range while a clip preview is
                                            // open is harmless, and arming
                                            // one is not — the arm would
                                            // never be spent and `J`/`L`
                                            // would stay refused until the
                                            // next take.
                                            double-clicked => {
                                                if (!root.previewing) {
                                                    root.preview-slate(slate.id);
                                                }
                                            }
                                        }

                                        // The clip row's menu, over what a
                                        // slate has (BACKLOG #127): *Add to
                                        // basket* wants a recording and
                                        // *Export video…* a clip, and *Jump
                                        // to slate end* is dropped rather
                                        // than deferred — the span on the
                                        // scrubber (spec S6) and a preview
                                        // that stops there are two ways to
                                        // see where a range ends, where #104
                                        // had none.
                                        //
                                        // Named so a test can find the row's
                                        // own menu: a `LineEdit` carries a
                                        // `ContextMenuArea` of its own, so
                                        // the type name alone finds six of
                                        // them in this window.
                                        slate-menu := ContextMenuArea {
                                            enabled: !root.recording;
                                            Menu {
                                                MenuItem {
                                                    title: "Jump to slate start";
                                                    activated => { root.jump-to-slate(slate.id); }
                                                }
                                                // **Both of these select the
                                                // row first, and that is the
                                                // rule rather than a
                                                // convenience.** Each *arms*
                                                // the range — Record through
                                                // the take, Preview through
                                                // the stop at the out point
                                                // — and the span drawn on the
                                                // scrubber is the *selected*
                                                // slate's (spec S6), so a
                                                // menu acting on a row that
                                                // is not selected would leave
                                                // the arm and the span naming
                                                // different ranges: the
                                                // footage would stop at a
                                                // mark nothing on screen
                                                // shows. It is also the
                                                // cursor the themed pass
                                                // advances from (#120), and
                                                // moving it is right for the
                                                // same reason — the range the
                                                // coach just shot or watched
                                                // is the one to carry on
                                                // from. Every other way into
                                                // either action already does
                                                // this: the row's own click,
                                                // the editor's Record button
                                                // and `R` all read the
                                                // selection.
                                                MenuItem {
                                                    title: "Preview slate";
                                                    // A clip preview holds
                                                    // the picture, and
                                                    // `slate-out-reached`
                                                    // refuses to fire while
                                                    // one is open — an arm
                                                    // set here would never be
                                                    // spent, and `J`/`L` stay
                                                    // refused while it is.
                                                    enabled: !root.previewing;
                                                    activated => {
                                                        root.selected-slate = slate.id;
                                                        root.preview-slate(slate.id);
                                                    }
                                                }
                                                MenuItem {
                                                    title: "Record";
                                                    // The editor's own Record
                                                    // button's gate: the bus
                                                    // refuses a take with a
                                                    // preview open
                                                    // (`can-record`), so grey
                                                    // it rather than earn the
                                                    // notice.
                                                    enabled: !root.previewing;
                                                    activated => {
                                                        root.selected-slate = slate.id;
                                                        root.shoot-slate(slate.id);
                                                    }
                                                }
                                                MenuItem {
                                                    title: "Delete slate";
                                                    activated => { root.delete-slate(slate.id); }
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            padding-top: 4px;
                                            spacing: 4px;

                                            HorizontalLayout {
                                                spacing: 6px;

                                                Text {
                                                    text: slate.range;
                                                    color: root.recording
                                                        ? Palette.alternate-foreground
                                                        : Palette.foreground;
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: slate.video;
                                                    color: Palette.alternate-foreground;
                                                    font-size: 11px;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                    horizontal-stretch: 1;
                                                }
                                                Text {
                                                    text: slate.name;
                                                    color: Palette.alternate-foreground;
                                                    font-size: 11px;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                }
                                                if slate.shot: Text {
                                                    text: "●";
                                                    color: Palette.alternate-foreground;
                                                    font-size: 11px;
                                                    vertical-alignment: center;

                                                    Tooltip {
                                                        text: @markdown("A clip was recorded from this slate");
                                                    }
                                                }
                                            }

                                        }
                                    }
                            }
                        }

                        // **The fields live outside the list**, hidden
                        // rather than removed, which is the inspector's
                        // rule and exists for two reasons that both bite
                        // here. A field inside the `for` is destroyed
                        // whenever the model is rebuilt -- every project
                        // change, including the save its own commit
                        // triggers -- and Slint fires no focus-lost
                        // callback for an item it has destroyed, so the
                        // typing is dropped on the floor: no
                        // `edit-slate-field`, no save, and no way to tell
                        // from the panel that the name was never taken.
                        // (It used to leave every shortcut dead too,
                        // because the window's gate was a list of these
                        // fields' focus. It is Slint's own
                        // `text-input-focused` now, which `TextInput`
                        // clears in its `deinit`, so that half is gone;
                        // the lost edit is reason enough on its own.)
                        VerticalLayout {
                            visible: root.selected-slate != "";
                            spacing: 4px;

                            slate-name-edit := LineEdit {
                                placeholder-text: "Name";
                                text <=> root.slate-name;
                                enabled: !root.recording;
                                // The slate the field opened on, not
                                // whatever is selected when focus leaves.
                                changed has-focus => {
                                    if (self.has-focus) {
                                        root.editing-slate-id = root.selected-slate;
                                    } else {
                                        root.edit-slate-field(SlateField.name, self.text);
                                        root.editing-slate-id = "";
                                    }
                                }
                                accepted => { root.edit-slate-field(SlateField.name, self.text); }
                            }
                            HorizontalLayout {
                                spacing: 6px;

                                // The clip inspector's picker, which is the
                                // same field over the same vocabulary --
                                // `tag_vocabulary` has always been clips ∪
                                // slates, so a tag typed on a clip
                                // autocompletes here and back (BACKLOG #105).
                                // Its suggestions are drawn at the column's
                                // level; see the bottom of `sidebar-column`.
                                slate-tags-edit := TagField {
                                    placeholder-text: "Tags, comma separated";
                                    text <=> root.slate-tags;
                                    enabled: !root.recording;
                                    horizontal-stretch: 1;
                                    suggest(text) => { return root.suggest-tags(text); }
                                    splice(text, tag) => { return root.take-suggestion(text, tag); }
                                    focus-moved(focused, text) => {
                                        if (focused) {
                                            root.editing-slate-id = root.selected-slate;
                                        } else {
                                            root.edit-slate-field(SlateField.tags, text);
                                            root.editing-slate-id = "";
                                        }
                                    }
                                    committed(text) => { root.edit-slate-field(SlateField.tags, text); }
                                }
                            // Re-mark from the playhead (BACKLOG #119).
                            // **Buttons, not `i`/`o`**: those match `"i" || "I"`
                            // on purpose so a shifted press still marks, and the
                            // slates spec's §S6 already settled that one key
                            // cannot both create and re-time.
                            Button {
                                text: "Set in";
                                enabled: !root.recording && !root.previewing;
                                clicked => {
                                    keys.focus();
                                    root.set-slate-mark(SlateMark.in-point);
                                }

                                Tooltip {
                                    text: @markdown("Move this slate's **in** point to the playhead");
                                }
                            }
                            Button {
                                text: "Set out";
                                enabled: !root.recording && !root.previewing;
                                clicked => {
                                    keys.focus();
                                    root.set-slate-mark(SlateMark.out-point);
                                }

                                Tooltip {
                                    text: @markdown("Move this slate's **out** point to the playhead");
                                }
                            }
                            Button {
                                text: "Record";
                                enabled: !root.recording && !root.previewing;
                                clicked => { root.shoot-slate(root.selected-slate); }

                                // What the pass is: two presses a range, and
                                // the list walks itself (BACKLOG #120). The
                                // still frame is deliberate — `start-recording`
                                // pauses and the log seeds a pause at record
                                // time 0 — so the coach is told where the
                                // second press goes rather than left to find
                                // a take that records a frozen picture.
                                Tooltip {
                                    text: @markdown("Record this range (R), then **Space** to play it. Stopping moves on to the next range with this tag");
                                }
                            }
                        }
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            Text {
                                text: "Clips";
                                color: Palette.alternate-foreground;
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: "Sort by position";
                                enabled: root.clip-count >= 2 && !root.recording;
                                clicked => { root.sort-clips(); }

                                Tooltip {
                                    text: @markdown("Order the clips by where they start in the match");
                                }
                            }
                        }

                        // The overview's filter (C8), cleared by a click.
                        if root.tag-filter != "": Rectangle {
                            height: 26px;
                            border-radius: 13px;
                            background: chip-touch.has-hover ? Palette.selection-background : Palette.control-background;

                            chip-touch := TouchArea {
                                clicked => { root.tag-filter = ""; }
                            }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;

                                Text {
                                    text: "Filtered: " + root.tag-filter;
                                    color: Palette.foreground;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: "✕";
                                    color: Palette.alternate-foreground;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        if root.tag-filter != "" && root.clips.length == 0: Text {
                            text: "No clips tagged '" + root.tag-filter + "'";
                            color: Palette.alternate-foreground;
                            wrap: word-wrap;
                        }

                        // Phase 3 C9. A click selects (never toggles: a
                        // double-click is two clicks first), a double-click
                        // jumps, a right-click opens the row's own menu without
                        // selecting, and a drag reorders. All off while
                        // recording, which the bus refuses. No drag while
                        // filtered: a filtered row's index isn't its place in
                        // the full order.
                        ListView {
                            for clip[index] in root.clips: Rectangle {
                                height: 28px;
                                border-radius: 4px;
                                background: clip-drop.has-drag || clip.id == root.selected-clip
                                    ? Palette.selection-background
                                    : transparent;

                                clip-drop := DropArea {
                                    enabled: !root.recording && root.tag-filter == "";
                                    can-drop(event) => {
                                        root.dropped-index("clips", event.data) >= 0 ? DragAction.move : DragAction.none
                                    }
                                    dropped(event) => {
                                        root.move-clip(root.dropped-index("clips", event.data), index);
                                        DragAction.move
                                    }

                                    DragArea {
                                        enabled: !root.recording && root.tag-filter == "";
                                        allow-move: true;
                                        data: root.drag-payload("clips", index);

                                        TouchArea {
                                            enabled: !root.recording;
                                            clicked => {
                                                root.selected-clip = clip.id;
                                                // Off any field, so the keys work.
                                                keys.focus();
                                            }
                                            double-clicked => {
                                                root.jump-to-clip(clip.id);
                                            }
                                        }

                                        ContextMenuArea {
                                            enabled: !root.recording;
                                            Menu {
                                                MenuItem {
                                                    title: "Jump to clip start";
                                                    activated => { root.jump-to-clip(clip.id); }
                                                }
                                                MenuItem {
                                                    title: "Preview clip";
                                                    enabled: root.can-preview;
                                                    activated => { root.open-preview(clip.id); }
                                                }
                                                MenuItem {
                                                    title: "Export video…";
                                                    enabled: !root.exporting && !root.previewing;
                                                    activated => { root.export-clip(clip.id); }
                                                }
                                                // Beside its nearest neighbour
                                                // in meaning. Nothing is
                                                // rendered, so it needs no
                                                // gate beyond the menu's own
                                                // `enabled: !root.recording`
                                                // (basket spec U1).
                                                MenuItem {
                                                    title: "Add to basket";
                                                    activated => { root.add-to-basket(clip.id); }
                                                }
                                                MenuItem {
                                                    title: "Delete clip";
                                                    activated => { root.delete-clip(clip.id); }
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 8px;

                                            Text {
                                                text: clip.name;
                                                color: root.recording ? Palette.alternate-foreground : Palette.foreground;
                                                overflow: elide;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                            }
                                            Text {
                                                text: clip.duration;
                                                color: Palette.alternate-foreground;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // The slate tag field's suggestions (BACKLOG #105).
                    //
                    // **At the column's level, not beside the field**, which
                    // is the one thing this half of the picker costs that the
                    // inspector's did not. Slint draws in declaration order:
                    // the fields sit above the Clips header and the clip list
                    // in the column's layout, so a list declared there would
                    // be drawn under both of them -- the header's `Button` and
                    // the `ListView` paint opaque backgrounds, so most of it
                    // would simply not be there. Here it is the last child of
                    // the column, and the column is a `Rectangle` rather than a
                    // layout, so it claims no cell, is drawn over everything
                    // and takes its own clicks.
                    //
                    // The two `absolute-position` subtractions are what the
                    // field's own `x`/`y` cannot give: it is three layouts deep
                    // and they are relative to its own row. The match setup
                    // sheet's colour picker anchors the same way.
                    if slate-tags-edit.suggesting: TagSuggestions {
                        x: slate-tags-edit.absolute-position.x - parent.absolute-position.x;
                        y: slate-tags-edit.absolute-position.y - parent.absolute-position.y
                            + slate-tags-edit.height + 2px;
                        width: slate-tags-edit.width;
                        suggestions: slate-tags-edit.suggestions;
                        take(tag) => { slate-tags-edit.take(tag); }
                    }
                }

                // The grip between the sidebar and the player. It sits in this
                // layout rather than over it, so its 6px are chrome, which the
                // fit's `window - player` subtraction absorbs without being
                // told about it (spec W2).
                //
                // `width-now` is the column's **laid-out** width, and that is
                // the one line of this wiring the component cannot get right
                // for itself (spec W5): handed the raw `sidebar-width`, a drag
                // begun while the bound was active would anchor on a value off
                // in the distance and move nothing until the pointer had
                // dragged it back into range.
                Splitter {
                    width-now: root.sidebar-width-now;
                    // The sidebar is to the *left* of this grip, so rightward
                    // motion widens it. The inspector's grip runs the other
                    // way, and the pair is only right against the order this
                    // layout is written in.
                    panel-on-the-right: false;
                    moved(w) => { root.sidebar-width = w; }
                    released => {
                        // Store the width the coach can see, not the one the
                        // pointer asked for (spec W5). The bound is not what
                        // makes this necessary — it is safe for any value, and
                        // the next drag anchors on `sidebar-width-now` rather
                        // than on this property. What it stops is a width
                        // coming back from the dead: drag the sidebar wide in a
                        // window too narrow for it and the layout gives 528
                        // while the raw value says 700, and a later, wider
                        // window would restore the 700 the coach dragged away
                        // from.
                        root.sidebar-width = root.sidebar-width-now;
                        root.panels-released();
                    }
                }

                // --- Player area: black, the picture fitted, zoomed and
                // panned (spec D9) ---
                player := Rectangle {
                    // The one item in this row that takes the slack, and the
                    // floor the columns are reconciled against when their
                    // stored widths ask for more than the window has.
                    min-width: root.player-min;
                    horizontal-stretch: 1;
                    /// The zoom the picture is drawn at: identity while
                    /// previewing (P6), since the preview's texture already
                    /// has the coach's zoom baked in and the scan-time
                    /// transform would apply it twice. The window's `zoom` is
                    /// left alone, so closing the preview restores the view.
                    property <ZoomState> shown-zoom: root.previewing ? { scale: 1, pan-x: 0, pan-y: 0 } : root.zoom;
                    property <PictureRect> picture: root.place-picture(self.shown-zoom, root.frame-width, root.frame-height, self.width, self.height);
                    // The letterboxed rect at 1×. The zoomed picture is clipped
                    // to it, not to the whole player area, so the view is
                    // exactly the crop export produces (spec D9: one
                    // `Zoom::transform`) and the letterbox bars stay black at
                    // any zoom. Phase 6 strokes are normalized to this rect too.
                    property <PictureRect> content: root.place-picture({ scale: 1, pan-x: 0, pan-y: 0 }, root.frame-width, root.frame-height, self.width, self.height);

                    background: black;
                    clip: true;

                    // Off any field (C6), with nothing to zoom; `zoom-area`
                    // does it otherwise.
                    TouchArea {
                        clicked => { keys.focus(); }
                    }

                    Rectangle {
                        x: player.content.x;
                        y: player.content.y;
                        width: player.content.width;
                        height: player.content.height;
                        clip: true;

                        // Drawn at 1× size and scaled up by a transform, rather
                        // than sized to `picture`: Skia rounds a translate-only
                        // image's origin to whole pixels, so a slow pan would
                        // step 1 px at a time. With a scale in the transform it
                        // moves smoothly. (At 1× nothing pans, so the rounding
                        // left there is harmless.) Same rect either way.
                        // Coordinates are relative to the content rect.
                        Image {
                            source: root.frame;
                            x: player.picture.x - player.content.x;
                            y: player.picture.y - player.content.y;
                            width: player.picture.width / player.shown-zoom.scale;
                            height: player.picture.height / player.shown-zoom.scale;
                            transform-origin: { x: 0, y: 0 };
                            transform-scale: player.shown-zoom.scale;
                            image-fit: fill;
                        }
                    }

                    // The live self-view -- the camera, or the project's
                    // avatar breathing with the voice -- where the export's
                    // inset goes: over the picture, under the drawings (the
                    // export's layer order), placed on the content rect so
                    // the zoom doesn't move it. Outside the content clip,
                    // since on a picture that isn't 16:9 the inset reaches
                    // into the bars, as it does in the export. It takes no
                    // input: a drag that starts on it draws, as the stroke
                    // lands over the inset in the export too.
                    if root.self-view-shown: Image {
                        x: root.self-view-rect.x;
                        y: root.self-view-rect.y;
                        width: root.self-view-rect.width;
                        height: root.self-view-rect.height;
                        source: root.self-view;
                        image-fit: fill;
                    }

                    Rectangle {
                        x: player.content.x;
                        y: player.content.y;
                        width: player.content.width;
                        height: player.content.height;
                        clip: true;

                        // The live telestration layer (D5) and the player
                        // highlights (H5), above the picture and clipped with
                        // it. Strokes are drawn where they were made, on the
                        // zoomed picture as seen, so they don't move with the
                        // zoom; a ring is placed in the footage, so it does.
                        //
                        // Hidden while previewing (P6): the preview's texture
                        // already has the clip's drawings and its rings
                        // rasterized into it, and whatever is still on screen
                        // from scanning belongs to the game video, not to the
                        // clip.
                        if !root.previewing: Rectangle {
                            // The player highlights (H5), **under** the
                            // drawings, which is the layer order export
                            // burns in. Every pill goes over every ring, so
                            // one player's number is never cut in half by the
                            // next player's ring.
                            for ring in root.live-highlights: StrokePath {
                                commands: ring.commands;
                                ink: ring.ink;
                                line-width: root.stroke-line-width;
                            }
                            for ring in root.live-highlights: HighlightLabel {
                                label: ring.label;
                                ink: ring.ink;
                                label-ink: ring.label-ink;
                                anchor-x: ring.label-x;
                                anchor-y: ring.label-y;
                                font-size: ring.font-size;
                                label-pad: ring.label-pad;
                                pill-height: ring.pill-height;
                                content-width: parent.width;
                            }
                            for stroke in root.live-paths: StrokePath {
                                commands: stroke.commands;
                                arrow: stroke.arrow;
                                ink: stroke.ink;
                                line-width: root.stroke-line-width;
                            }
                            // The one under the pen. An empty `commands` draws
                            // nothing, so it needs no `if`.
                            StrokePath {
                                commands: root.drawing-path;
                                arrow: root.drawing-arrow;
                                ink: root.drawing-ink;
                                line-width: root.stroke-line-width;
                            }
                        }
                    }

                    // The scoreboard the export burns in, shown while scanning
                    // (spec S3). Over the drawings and the rings, which is the
                    // export's layer order, and placed on the content rect
                    // rather than the picture, so the zoom doesn't move it —
                    // in the export it is chrome on the output frame. Hidden
                    // while previewing, where the clip's own texture already
                    // carries its board.
                    if root.scoreboard-width > 0 && !root.previewing: Image {
                        x: player.content.x;
                        y: player.content.y;
                        width: root.scoreboard-width;
                        height: root.scoreboard-height;
                        source: root.scoreboard;
                        image-fit: fill;
                    }

                    zoom-area := TouchArea {
                        // Only over a picture: the empty-state cards cover it
                        // otherwise. Off while previewing, which is at
                        // identity zoom (P6).
                        enabled: root.can-play && !root.previewing;
                        // A plain wheel over the picture scrubs, exactly as it
                        // does over the scrubber (the coach, 2026-09-25): the
                        // picture is where the eyes are while scanning, and
                        // reaching for the strip to move three seconds is a
                        // detour. Ctrl+wheel still zooms and a drag still pans,
                        // so taking the plain wheel strands nothing.
                        scroll-event(event) => {
                            if (event.modifiers.control) {
                                root.zoom-scroll(self.mouse-x, self.mouse-y, event.delta-x, event.delta-y, true, event.modifiers.shift);
                            } else {
                                root.scrub-scroll(event.delta-x, event.delta-y, event.modifiers.shift);
                            }
                            accept
                        }
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                keys.focus();
                            }
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                root.zoom-press(self.mouse-x, self.mouse-y);
                            }
                        }
                        // Only while a button is down; `pressed` is the primary one.
                        moved => {
                            if (self.pressed) {
                                root.zoom-drag(self.mouse-x, self.mouse-y);
                            }
                        }
                    }

                    ZoomIndicator {
                        x: (parent.width - self.width) / 2;
                        y: 12px;
                        // Identity while previewing, where it hides itself.
                        scale: player.shown-zoom.scale;
                        notches: root.zoom-notches;
                    }

                    // New is the common case and opening an old one the
                    // exception, so New match… is the primary action here
                    // (spec E1). Gated exactly as the toolbar's is.
                    if !root.has-project: EmptyCard {
                        title: "Start a match";
                        message: "Pick the game's video files and pundit makes the folder, names the project after both teams and sets the teams up. The footage stays where it is. Already have a project? Open its folder — the project file (project.json) lives inside it.";
                        action: "New match…";
                        secondary: "Open Project…";
                        enabled: !root.recording && !root.previewing;
                        clicked => { root.new-match(); }
                        secondary-clicked => { root.open-project(); }
                    }
                    if root.has-project && root.sources.length == 0: EmptyCard {
                        title: "No source video added";
                        message: "Add the match video you want to scan. Several videos (for example two halves) play as one timeline.";
                        action: "Add Source Video…";
                        clicked => { root.add-source(); }
                    }
                    if root.has-project && root.sources.length > 0 && root.missing-index >= 0: EmptyCard {
                        title: "Source video is missing: " + root.missing-name;
                        message: "This video can't be found. It may have been moved, renamed or deleted. Pick its current location to continue.";
                        action: "Relink…";
                        // The bus refuses it while recording (R6's guard).
                        enabled: !root.recording;
                        clicked => { root.relink-source(root.missing-index); }
                    }

                    // --- Drawing (Phase 6 D1) ---
                    // The player's last child but the H tool's: Slint visits
                    // children front to back and a TouchArea grabs the
                    // pointer on press, so declared any earlier the presses
                    // would go to `zoom-area` and pan instead. Sized to the
                    // content rect, so a press in the letterbox bars still
                    // pans, and `mouse-x/y` are already content-relative.
                    //
                    // It accepts no scroll event, so wheels fall through to
                    // `zoom-area` behind it and pan and Ctrl-zoom keep
                    // working. Disabled it forwards everything and shows no
                    // cursor of its own.
                    TouchArea {
                        x: player.content.x;
                        y: player.content.y;
                        width: player.content.width;
                        height: player.content.height;
                        enabled: root.can-draw;
                        mouse-cursor: crosshair;
                        pointer-event(event) => {
                            // Slint drops the grab and sends a cancel when a
                            // grabbing area sees an exit or is disabled
                            // mid-stroke — the recording stopping, say. It
                            // carries `button: other`, so it has to come
                            // before the test below, or the stroke would be
                            // left on screen and never logged.
                            if (event.kind == PointerEventKind.cancel) {
                                root.draw-cancel();
                                return;
                            }
                            if (event.button != PointerEventButton.left) {
                                return;
                            }
                            if (event.kind == PointerEventKind.down) {
                                keys.focus();
                                root.draw-press(self.mouse-x, self.mouse-y, event.modifiers.shift);
                            }
                            if (event.kind == PointerEventKind.up) {
                                root.draw-release(self.mouse-x, self.mouse-y);
                            }
                        }
                        // Only while a button is down; `pressed` is the
                        // primary one. The pointer is grabbed on press, so
                        // this keeps arriving off the picture; the stroke
                        // clamps to the edge.
                        moved => {
                            if (self.pressed) {
                                root.draw-move(self.mouse-x, self.mouse-y);
                            }
                        }
                    }

                    // --- The H tool (spec H3) ---
                    // After the drawing area, so in the tool a press rings a
                    // player rather than drawing one over. On the content
                    // rect like it, so `mouse-x/y` are already the pixels
                    // `drag_rect` maps through the zoom, and a drag in the
                    // letterbox bars still pans.
                    highlight-area := TouchArea {
                        x: player.content.x;
                        y: player.content.y;
                        width: player.content.width;
                        height: player.content.height;
                        enabled: root.in-highlight-tool;
                        mouse-cursor: crosshair;
                        pointer-event(event) => {
                            // As the drawing area's: a cancel carries
                            // `button: other`, so it comes first.
                            if (event.kind == PointerEventKind.cancel) {
                                root.highlight-cancel();
                                return;
                            }
                            if (event.button != PointerEventButton.left) {
                                return;
                            }
                            if (event.kind == PointerEventKind.down) {
                                keys.focus();
                                root.highlight-press(self.mouse-x, self.mouse-y);
                            }
                            if (event.kind == PointerEventKind.up) {
                                root.highlight-release(self.mouse-x, self.mouse-y);
                            }
                        }
                    }

                    // The box under the pointer, in the pen's colour: what
                    // the key will hold. Only while the picture is paused,
                    // which is the only time a drag places anything (H3);
                    // clamped to the content rect, since the pointer is
                    // grabbed and `drag_rect` clamps the same way.
                    if highlight-area.pressed && !root.playing: Rectangle {
                        property <length> left: max(0px, min(highlight-area.pressed-x, highlight-area.mouse-x));
                        property <length> top: max(0px, min(highlight-area.pressed-y, highlight-area.mouse-y));
                        x: player.content.x + self.left;
                        y: player.content.y + self.top;
                        width: max(0px, min(player.content.width, max(highlight-area.pressed-x, highlight-area.mouse-x)) - self.left);
                        height: max(0px, min(player.content.height, max(highlight-area.pressed-y, highlight-area.mouse-y)) - self.top);
                        border-width: 1px;
                        border-color: root.pen-colors[root.pen-index];
                        background: #ffffff1a;
                    }
                }

                // The sidebar's grip the other way round: the inspector is to
                // the *right* of this one, so it widens as the pointer goes
                // left. The comment above the first one carries the rest.
                Splitter {
                    width-now: root.inspector-width-now;
                    panel-on-the-right: true;
                    moved(w) => { root.inspector-width = w; }
                    released => {
                        // The sidebar's write-back, for the reason given there.
                        root.inspector-width = root.inspector-width-now;
                        root.panels-released();
                    }
                }

                // --- Inspector: the selected clip, else the tag overview
                // (C7, C8) -- with the Match panel under it (Phase 9 S4) ---
                inspector-column := Rectangle {
                    // The sidebar's constraints mirrored; the table above them
                    // is why this is not a `clamp` on `width`.
                    min-width: root.inspector-min;
                    preferred-width: max(root.inspector-min, root.inspector-width);
                    max-width: max(root.inspector-min, root.inspector-width);
                    horizontal-stretch: 0;
                    background: Palette.alternate-background;

                    // Empty space: off any field (C6).
                    TouchArea {
                        clicked => { keys.focus(); }
                    }

                    // Scrolls rather than push the transport bar off the
                    // window: a selected clip's fields over the Match panel
                    // are taller than a 700px window has room for. With room
                    // to spare, the layout fills the column and Notes takes
                    // the slack, as before. Clicks fall through it to the
                    // TouchArea behind: it pans only on the wheel.
                    ScrollView {
                        VerticalLayout {
                            // The clip inspector, or the tag overview with
                            // nothing selected; the Match panel is always under
                            // it, since a match is the project's, not a clip's.
                            Rectangle {
                                vertical-stretch: 1;
                                // Only a shown inspector holds the column
                                // open: hidden, its fields would still claim
                                // their height over the tag overview and
                                // scroll the Match panel for nothing.
                                min-height: inspector.visible ? inspector.min-height : 0;

                                // Hidden rather than removed, so `editing` always binds.
                                inspector := Inspector {
                                    visible: root.selected-clip != "";
                                    enabled: !root.recording;
                                    name-text <=> root.clip-name;
                                    tags-text <=> root.clip-tags;
                                    notes-text <=> root.clip-notes;
                                    transcript-text <=> root.clip-transcript;
                                    transcript-state: root.transcript-state;
                                    transcript-status: root.transcript-status;
                                    transcript-models: root.transcript-models;
                                    transcript-model <=> root.transcript-model;
                                    transcript-model-enabled: root.transcript-model-enabled;
                                    transcribe-download: root.transcribe-download;
                                    show-pip <=> root.clip-show-pip;
                                    inset-size-index <=> root.clip-inset-size-index;
                                    inset-corner-index <=> root.clip-inset-corner-index;
                                    avatar: root.clip-avatar;
                                    avatar-missing: root.avatar-missing;
                                    begin-edit => { root.editing-clip-id = root.selected-clip; }
                                    commit(field, text) => { root.edit-clip(root.editing-clip-id, field, text); }
                                    end-edit(field, text) => {
                                        let id = root.editing-clip-id;
                                        // Unless focus moved to another field, which
                                        // goes on editing the same clip.
                                        if (!self.editing) {
                                            root.editing-clip-id = "";
                                        }
                                        root.edit-clip(id, field, text);
                                    }
                                    can-preview: root.can-preview;
                                    previewing: root.previewing && root.previewing-clip == root.selected-clip;
                                    // The selection, since a click doesn't take focus
                                    // from a field.
                                    pip-toggled(on) => { root.set-show-pip(root.selected-clip, on); }
                                    // Off the fields first, as the speech
                                    // model's picker below is: the popup takes
                                    // focus from a field being edited, and the
                                    // window's shortcuts must come back.
                                    inset-size-chosen(index) => {
                                        keys.focus();
                                        root.set-inset-size(root.selected-clip, index);
                                    }
                                    inset-corner-chosen(index) => {
                                        keys.focus();
                                        root.set-inset-corner(root.selected-clip, index);
                                    }
                                    // Off the fields first, as the Preview button
                                    // does: a click doesn't move focus, and the
                                    // machine's write is refused a re-render while
                                    // a field holds one.
                                    transcribe-clicked => {
                                        keys.focus();
                                        root.transcribe(root.selected-clip);
                                    }
                                    cancel-transcribe-clicked => {
                                        keys.focus();
                                        root.cancel-transcription();
                                    }
                                    // Off the fields as its siblings are: the
                                    // popup takes focus from a field being
                                    // edited, and the window's shortcuts must
                                    // come back afterwards.
                                    transcript-model-chosen(index) => {
                                        keys.focus();
                                        root.set-transcribe-model(index);
                                    }
                                    preview-clicked => {
                                        keys.focus();
                                        if (self.previewing) {
                                            root.close-preview();
                                        } else {
                                            root.open-preview(root.selected-clip);
                                        }
                                    }
                                    suggest-tags(text) => { return root.suggest-tags(text); }
                                    take-suggestion(text, tag) => { return root.take-suggestion(text, tag); }
                                }
                                if root.selected-clip == "": TagOverview {
                                    rows: root.tag-rows;
                                    clip-count: root.clip-count;
                                    filter <=> root.tag-filter;
                                }
                            }

                            MatchPanel {
                                expanded: root.match-expanded;
                                toggle-fold => {
                                    keys.focus();
                                    root.toggle-fold("match");
                                }
                                configured: root.match-configured;
                                score: root.match-score;
                                clock: root.match-clock;
                                rows: root.match-rows;
                                lines: root.match-list-lines;
                                can-tag: root.can-tag;
                                at-cap: root.match-at-cap;
                                // The bus refuses a scrub and an edit while
                                // recording, and neither belongs to the game
                                // video behind a preview.
                                // It also gates the editor's button: an
                                // event points at a video, and `can-play` is
                                // false until the project has one (spec P4).
                                can-edit: root.can-play && !root.recording && !root.previewing;
                                // Off any field first, as every other button
                                // does: a click doesn't take focus from one, and
                                // the tag keys have to keep working after it.
                                tag(kind) => {
                                    keys.focus();
                                    root.tag-match-event(kind);
                                }
                                seek(id) => {
                                    keys.focus();
                                    root.seek-match-event(id);
                                }
                                remove(id) => {
                                    keys.focus();
                                    root.delete-match-event(id);
                                }
                                trim(id, trim) => {
                                    keys.focus();
                                    root.reel-trim(id, trim);
                                }
                                setup => {
                                    keys.focus();
                                    root.open-match-setup();
                                }
                                edit-events => {
                                    keys.focus();
                                    root.open-match-editor();
                                }
                            }

                            highlights := HighlightsPanel {
                                rows: root.highlight-rows;
                                selected: root.selected-highlight;
                                tool-on: root.in-highlight-tool;
                                key-here: root.highlight-key-here;
                                label-text <=> root.highlight-label;
                                // The bus refuses every highlight edit but a
                                // key while recording (H3), and none of them
                                // belongs to the game video behind a preview.
                                can-edit: root.can-play && !root.recording && !root.previewing;
                                // Off any field first, as the Match panel's
                                // buttons do.
                                select(id) => {
                                    keys.focus();
                                    root.select-highlight(id);
                                }
                                remove(id) => {
                                    keys.focus();
                                    root.delete-highlight(id);
                                }
                                delete-key(id) => {
                                    keys.focus();
                                    root.delete-highlight-key(id);
                                }
                                begin-edit => { root.editing-highlight-id = root.selected-highlight; }
                                commit(text) => { root.commit-highlight-label(text); }
                                end-edit(text) => {
                                    root.end-highlight-label(text);
                                    root.editing-highlight-id = "";
                                }
                            }
                        }
                    }
                }
            }

            // --- Transport bar: the scrubber on a row of its own, full width,
            // with the controls under it ---
            Rectangle {
                background: Palette.alternate-background;

                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;

                    scrubber := Scrubber {
                        // Something to play, and not recording.
                        enabled: root.can-play && !root.recording;
                        // The wheel sends a skip, which the bus allows while
                        // recording, so it outlives the drag's gate. Gated
                        // like the frame step otherwise: something to play,
                        // and the game video in front, not a preview.
                        wheel-enabled: root.can-play && !root.previewing;
                        maximum: max(root.total-seconds, 0.001);
                        // The concat timeline's: a preview's scale is its
                        // clip's, where they would mean nothing.
                        marks: root.previewing ? [] : root.match-marks;
                        // Dropped in a preview for the same reason the marks
                        // are: these are concat seconds and a preview's scale
                        // is its clip's.
                        slate-span-from: root.previewing ? 0 : root.slate-span-from;
                        slate-span-to: root.previewing ? 0 : root.slate-span-to;
                        value <=> root.position-seconds;
                        moved(value) => { root.scrub-move(value); }
                        released(value) => { root.scrub-release(value); }
                        scrolled(dx, dy, shift) => { root.scrub-scroll(dx, dy, shift); }
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        Button {
                            text: "New match…";
                            enabled: !root.recording;
                            clicked => { root.new-match(); }

                            Tooltip {
                                text: @markdown("Pick a game's video files. pundit makes the folder and names the project.");
                            }
                        }
                        Button {
                            text: "Open Project…";
                            enabled: !root.recording && !root.previewing;
                            clicked => { root.open-project(); }
                        }
                        // **The popup is the button's SIBLING, not its child**:
                        // no style's `Button` has a `@children` slot, so
                        // nesting it fails with "'Button' cannot have
                        // children". `Tooltip` nests only because it is a
                        // builtin flagged `@can_be_declared_without_children_slot`.
                        //
                        // The wrapper holds nothing but the button, so `x: 0`
                        // anchors where the button is — `devices-popup`'s
                        // right-anchored `parent.width - self.width` would be
                        // ~1000px wrong at this end of the row. **It costs no
                        // layout, and the reason is one pass, not three:**
                        // `lower_popups` removes the popup from its parent's
                        // `children` outright and sets `has_popup_child`
                        // (`lower_popups.rs`), so by the time `lower_layouts`
                        // runs there is nothing of it left to constrain
                        // anything. (An earlier version of this comment also
                        // cited `lower_layout` and `optimize_useless_rectangles`
                        // for special-casing that flag. They do — but one is
                        // inside the `Row`-in-a-`GridLayout` arm and the other
                        // only ever visits Rectangles, so neither applies to a
                        // `HorizontalLayout`. Decorative citations make a
                        // comment look better verified than it is.)
                        // A HorizontalLayout rather than a Rectangle, which
                        // would take stretch and not propagate the button's
                        // minimum.
                        HorizontalLayout {
                            Button {
                                text: "Recent ▾";
                                enabled: !root.recording && !root.previewing;
                                // `keys.focus()` BEFORE `show()`: `show_popup`
                                // takes the window's focus item, so a
                                // half-typed clip name or editor row would
                                // commit as a side effect of opening this.
                                clicked => {
                                    keys.focus();
                                    root.list-recents();
                                    recent-popup.show();
                                }

                                Tooltip {
                                    text: @markdown("Switch to a project you had open recently");
                                }
                            }
                            // Above the button's own end, over the player.
                            recent-popup := PopupWindow {
                                x: 0;
                                y: -self.height - 8px;
                                width: 300px;

                                Rectangle {
                                    background: Palette.background;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Palette.border;

                                    VerticalLayout {
                                        padding: 12px;

                                        RecentList {
                                            rows: root.recent-rows;
                                            none-resolved: root.recents-none-resolved;
                                            chosen(folder) => { root.open-recent(folder); }
                                        }
                                    }
                                }
                            }
                        }
                        Button {
                            text: "Add Source Video…";
                            enabled: root.has-project && !root.recording;
                            clicked => { root.add-source(); }
                        }
                        Button {
                            text: root.playing ? "Pause" : "Play";
                            enabled: root.can-play;
                            min-width: 72px;
                            clicked => { root.toggle-play(); }
                        }
                        // Cycles up, and back to 1x after 32x.
                        Button {
                            text: root.scan-speed + "×";
                            enabled: root.can-scan-fast;
                            min-width: 48px;
                            clicked => {
                                root.step-scan-speed(ScanStep.cycle);
                            }

                            Tooltip {
                                text: @markdown("Speed while playing (J slower, L faster)");
                            }
                        }
                        Button {
                            // **"Record range" is the mode, said out loud**
                            // (BACKLOG #120, spec T5): with a range selected,
                            // this button and `R` shoot it — seeking to its
                            // in point and stopping the footage at its out —
                            // rather than starting a take where the playhead
                            // is. The word is what keeps that off the list of
                            // things a coach discovers by surprise.
                            text: root.recording
                                ? "Stop"
                                : root.selected-slate != "" ? "Record range" : "Record";
                            enabled: (root.can-play && !root.exporting && !root.previewing) || root.recording;
                            min-width: 72px;
                            // Off any field first: a click doesn't take focus
                            // from one, and a field disabled while it has
                            // focus would keep blocking the recording keys.
                            clicked => {
                                keys.focus();
                                root.toggle-recording(root.selected-slate);
                            }

                            Tooltip {
                                text: root.recording
                                    ? @markdown("Stop recording (R or Esc)")
                                    : root.exporting
                                        ? @markdown("Not while exporting")
                                        : root.previewing
                                            ? @markdown("Not while previewing a clip")
                                            : root.selected-slate != ""
                                                ? @markdown("Record the selected range (R), then **Space** to play it. Esc clears the selection to record freely")
                                                : @markdown("Record (R)");
                            }
                        }
                        // The stretch item, right-aligned: it holds the
                        // controls either side of it apart.
                        Text {
                            text: root.readout;
                            color: Palette.foreground;
                            vertical-alignment: center;
                            min-width: 130px;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: "Volume";
                            color: Palette.alternate-foreground;
                            vertical-alignment: center;
                        }
                        // Named for `tests/ui/keys.rs`, which clicks it to
                        // prove an arrow never reaches a touched slider --
                        // the one control in this window that answers one.
                        volume-slider := Slider {
                            width: 100px;
                            minimum: 0;
                            maximum: 1;
                            value <=> root.volume;
                            changed(value) => { root.volume-changed(value); }
                            released(value) => { root.volume-released(value); }
                        }
                        Button {
                            text: "Export…";
                            // Still on while a run is going: the sheet is
                            // where one is watched and cancelled from.
                            enabled: root.has-project && root.can-export && !root.recording && !root.previewing;
                            clicked => {
                                keys.focus();
                                root.open-export();
                            }

                            Tooltip {
                                text: @markdown("Export clips, the goals reel, or the whole match, as videos");
                            }
                        }
                        // The badge, and the answer to "is a basket waiting":
                        // the count is the stored list's, so it is right the
                        // moment the app starts and survives every project
                        // switch. **No `has-project`** -- a basket can be
                        // started with none, and being in project B and seeing
                        // that four pieces are waiting is the whole point
                        // (basket spec U2). Still on while a run is going: the
                        // sheet is where one is watched and cancelled from.
                        Button {
                            text: root.basket-pieces.length > 0
                                ? "Basket (" + root.basket-pieces.length + ")…"
                                : "Basket…";
                            enabled: root.basket-pieces.length > 0 && !root.recording
                                && !root.previewing;
                            clicked => {
                                keys.focus();
                                root.open-basket();
                            }

                            Tooltip {
                                text: @markdown("Make one video of the clips gathered from any number of matches");
                            }
                        }
                        Button {
                            text: "Devices…";
                            enabled: root.has-project && !root.recording;
                            clicked => {
                                root.list-devices();
                                devices-popup.show();
                            }
                        }
                    }

                    // Drawing's row, with the recording's status and the
                    // notice line: at the window's 1100px minimum, sharing
                    // the transport's row pushed Export and Devices off its
                    // end and left the notice no width at all.
                    HorizontalLayout {
                        spacing: 8px;

                        // Drawing's controls (D6). Always mounted, and
                        // only disabled off a recording: mounting them with
                        // the recording would change the player's height,
                        // and with it the content rect strokes are
                        // normalized against. macOS learned this one.
                        //
                        // The pens first, and never disabled: the coach picks
                        // one before a recording as well as during it. The
                        // chosen one has a ring round it.
                        HorizontalLayout {
                            spacing: 2px;
                            alignment: center;
                            // Layouts stretch by default; only the notice may.
                            horizontal-stretch: 0;

                            for ink[index] in root.pen-colors: VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    border-radius: self.width / 2;
                                    border-width: 2px;
                                    border-color: index == root.pen-index ? Palette.foreground : transparent;

                                    Rectangle {
                                        width: 14px;
                                        height: 14px;
                                        border-radius: self.width / 2;
                                        background: ink;
                                        // The strokes' own dark edge, so white
                                        // and yellow hold on a light theme.
                                        border-width: 1px;
                                        border-color: #00000066;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            keys.focus();
                                            root.pick-pen(index);
                                        }
                                    }
                                }
                            }
                        }
                        // How thick the pen draws (BACKLOG #116: "current plus
                        // one thicker option"). Two dots at the widths
                        // themselves rather than a label, because the choice is
                        // about how a line looks — and on the swatch row's own
                        // shape, since it is the same kind of pick.
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;

                            HorizontalLayout {
                                spacing: 4px;

                                for dot[index] in [6px, 12px]: VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 22px;
                                        height: 22px;
                                        border-radius: self.width / 2;
                                        border-width: 2px;
                                        border-color: index == root.pen-width-index
                                            ? Palette.foreground : transparent;

                                        Rectangle {
                                            width: dot;
                                            height: dot;
                                            border-radius: self.width / 2;
                                            background: root.pen-colors[root.pen-index];
                                            border-width: 1px;
                                            border-color: #00000066;
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                keys.focus();
                                                root.pick-pen-width(index);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            CheckBox {
                                text: "Auto-clear";
                                enabled: root.can-draw;
                                checked <=> root.auto-clear;
                            }
                        }
                        Button {
                            text: "Clear";
                            enabled: root.can-draw;
                            clicked => {
                                keys.focus();
                                root.clear-drawings();
                            }

                            Tooltip {
                                text: @markdown("Clear the drawings (C)");
                            }
                        }
                        // Fit the window to the footage (spec W3). **This row,
                        // not the transport's above:** at the window's 1100px
                        // minimum that one is already exactly full, and the
                        // only give in it is the position readout, which clips
                        // rather than elides.
                        Button {
                            text: "Fit";
                            // `enabled`, never `if`: a button that appeared
                            // and vanished as the window was dragged would
                            // reflow this row under the coach's cursor. A
                            // disabled Button keeps its Tooltip, so the
                            // greying explains itself the way Record's does.
                            enabled: root.can-fit;
                            clicked => {
                                keys.focus();
                                root.fit-window();
                            }

                            Tooltip {
                                text: root.can-fit
                                    ? @markdown("Shrink the window to the footage's shape, losing the black bars (F)")
                                    // Not "there is no black to take off": this
                                    // is also the wording with no footage on
                                    // screen, where that would be a lie.
                                    : @markdown("Nothing to fit");
                            }
                        }
                        // What every key does (#96). **This row, and for
                        // `Fit`'s reason above:** the transport row has no
                        // room. The spec and the plan both asked for this
                        // button beside `Recent ▾` up there and both left
                        // that row's budget unmeasured. Measured 2026-10-08
                        // with an `ElementHandle` probe (not kept as a test:
                        // it would pin the headless backend's font metrics):
                        // at the window's own 1100px floor that row's buttons
                        // run from x=8 to **x=1199**, so `Devices…` ends
                        // 99px past the window's right edge before anything
                        // is added. Here there is room to spare — `Fit` ends
                        // at 268.
                        //
                        // Never disabled: it is a list the window always has,
                        // and a coach who cannot find a key is exactly the
                        // coach in the state that would grey it out.
                        Button {
                            text: "Keys";
                            // Off any field first, as every button in this
                            // window does: a click does not take focus from
                            // one by itself, and this sheet's Esc layer is
                            // ahead of the `text-editing` one, so a field
                            // left focused would keep the first Esc.
                            clicked => {
                                keys.focus();
                                root.keys-sheet-open = true;
                            }

                            Tooltip {
                                text: @markdown("Every key this app binds, and what it does (F1)");
                            }
                        }
                        // The H tool is a mode, so it says so (spec H3): the
                        // pen swatches beside it are what a new ring is
                        // coloured with, and the panel below lists them.
                        if root.in-highlight-tool: Text {
                            text: "Highlight tool — drag a box around a player (Esc to leave)";
                            color: Palette.foreground;
                            font-size: 11px;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }
                        if root.recording-phase == RecordingPhase.starting: Text {
                            text: "Preparing recording…";
                            color: Palette.alternate-foreground;
                            vertical-alignment: center;
                        }
                        if root.recording-phase == RecordingPhase.recording: HorizontalLayout {
                            spacing: 6px;
                            horizontal-stretch: 0;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 10px;
                                    height: 10px;
                                    border-radius: 5px;
                                    background: #ff3b30;
                                }
                            }
                            Text {
                                text: "Recording";
                                color: Palette.foreground;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.recording-elapsed;
                                color: Palette.foreground;
                                font-family: "monospace";
                                vertical-alignment: center;
                                min-width: 48px;
                            }
                            if !root.level-seen: Text {
                                text: "Waiting for audio…";
                                color: Palette.alternate-foreground;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            if root.level-seen: VerticalLayout {
                                alignment: center;
                                // The mic's peak over −60…0 dBFS.
                                Rectangle {
                                    width: 90px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: #ffffff26;

                                    Rectangle {
                                        x: 0;
                                        width: parent.width * root.level;
                                        border-radius: 3px;
                                        background: root.level > 0.95 ? #ff3b30 : #34c759;
                                    }
                                }
                            }
                        }
                        // Its own item, so a notice can't overwrite it (P6).
                        // The transport above drives the preview while it's
                        // up, over the clip's own duration.
                        if root.previewing: HorizontalLayout {
                            spacing: 6px;
                            horizontal-stretch: 0;

                            Text {
                                text: "Previewing " + root.previewing-name;
                                color: Palette.foreground;
                                font-size: 11px;
                                overflow: elide;
                                vertical-alignment: center;
                                max-width: 200px;
                            }
                            Button {
                                text: "Close";
                                clicked => {
                                    keys.focus();
                                    root.close-preview();
                                }

                                Tooltip {
                                    text: @markdown("Close the preview and go back to the game video (Esc)");
                                }
                            }
                        }
                        // The one stretch item: it takes the row's slack, and
                        // elides rather than squeeze the controls.
                        Text {
                            text: root.notice;
                            color: #ffcc00;
                            font-size: 11px;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            min-width: 0;
                        }
                    }
                }

                // The Devices popover: above the bar's right end, over the player.
                devices-popup := PopupWindow {
                    x: parent.width - self.width - 8px;
                    y: -self.height - 8px;
                    width: 300px;

                    Rectangle {
                        background: Palette.background;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Palette.border;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 12px;

                            DeviceList {
                                title: "Camera";
                                rows: root.cameras;
                                chosen(node-name) => { root.choose-camera(node-name); }
                            }
                            DeviceList {
                                title: "Microphone";
                                rows: root.mics;
                                chosen(node-name) => { root.choose-mic(node-name); }
                            }
                            InsetSection {
                                thumb: root.avatar-thumb;
                                name: root.avatar-name;
                                missing: root.avatar-missing;
                                choose() => { root.choose-avatar(); }
                                remove() => { root.remove-avatar(); }
                            }
                        }
                    }
                }
            }
        }

        // --- Export sheet: modal over the whole window (E8) ---
        if root.export-sheet-open: Scrim {
            ExportSheet {
                targets: root.export-targets;
                any-ticked: root.export-any-ticked;
                run: root.export-run;
                finish: root.export-finish;
                exporting: root.exporting;
                resolution <=> root.export-resolution;
                quality <=> root.export-quality;
                scoreboard <=> root.export-scoreboard;
                mute-source <=> root.export-mute-source;
                chapters <=> root.export-chapters;
                cues <=> root.export-cues;
                whole-match-ticked: root.export-whole-match-ticked;
                tick(index, ticked) => { root.tick-target(index, ticked); }
                start => { root.start-export(); }
                cancel => { root.cancel-export(); }
                close => {
                    root.export-sheet-open = false;
                    keys.focus();
                }
            }
        }

        // --- Basket sheet: modal over the whole window (basket spec U3) ---
        if root.basket-sheet-open: Scrim {
            BasketSheet {
                pieces: root.basket-pieces;
                run: root.export-run;
                basket-run: root.basket-run;
                finish: root.export-finish;
                exporting: root.exporting;
                message: root.basket-message;
                name <=> root.basket-name;
                resolution <=> root.basket-resolution;
                quality <=> root.basket-quality;
                mute-source <=> root.basket-mute-source;
                // Off the name field first, as every other button in this app
                // does -- a click doesn't take focus from a field by itself.
                reorder(from, to) => {
                    keys.focus();
                    root.move-basket-piece(from, to);
                }
                remove(index) => {
                    keys.focus();
                    root.remove-basket-piece(index);
                }
                clear => {
                    keys.focus();
                    root.clear-basket();
                }
                // The name field's text is read on the way out, so Start does
                // not need it committed first.
                start => { root.start-basket(); }
                cancel => { root.cancel-export(); }
                close => { root.close-basket(); }
            }
        }

        // --- Match setup sheet: modal over the whole window (Phase 9 S4) ---
        if root.match-sheet-open: Scrim {
            MatchSetupSheet {
                home-name <=> root.match-home-name;
                home-primary <=> root.match-home-primary;
                home-secondary <=> root.match-home-secondary;
                home-font <=> root.match-home-font;
                away-name <=> root.match-away-name;
                away-primary <=> root.match-away-primary;
                away-secondary <=> root.match-away-secondary;
                away-font <=> root.match-away-font;
                regulation-periods <=> root.match-regulation-periods;
                regulation-minutes <=> root.match-regulation-minutes;
                overtime-periods <=> root.match-overtime-periods;
                overtime-minutes <=> root.match-overtime-minutes;
                back-anchor <=> root.match-back-anchor;
                kit-colors: root.kit-colors;
                picker-field <=> root.match-picker-field;
                hex-color(text) => { return root.hex-color(text); }
                hsv-of-hex(text) => { return root.hsv-of-hex(text); }
                hex-of-hsv(hue, sat, val) => { return root.hex-of-hsv(hue, sat, val); }
                valid-name(text) => { return root.valid-name(text); }
                valid-hex(text) => { return root.valid-hex(text); }
                valid-periods(text) => { return root.valid-periods(text); }
                valid-overtime-periods(text) => { return root.valid-overtime-periods(text); }
                valid-minutes(text) => { return root.valid-minutes(text); }
                over-cap(regulation, overtime, anchor) => {
                    return root.match-over-cap(regulation, overtime, anchor);
                }
                // The bus has the last word on both: it refuses an empty
                // name, and closing here is the sheet's own Cancel.
                save => {
                    root.save-match-setup();
                    root.close-match-setup();
                }
                cancel => { root.close-match-setup(); }
            }
        }

        // --- Match event editor: modal over the whole window (spec P1) ---
        if root.match-editor-open: Scrim {
            MatchEditorSheet {
                rows: root.match-editor-rows;
                selected: root.match-editor-selected;
                line <=> root.match-editor-line;
                paste <=> root.match-editor-paste;
                sources: root.match-editor-sources;
                default-source <=> root.match-editor-source;
                message: root.match-editor-message;
                revision: root.project-revision;
                line-focused <=> root.match-editor-line-focused;
                valid-line(id, text) => { return root.valid-match-line(id, text); }
                check-paste(text, source, revision) => {
                    return root.check-paste(text, source, revision);
                }
                select(id) => { root.select-match-event(id); }
                // **Every commit drops focus** (spec T4), unconditionally
                // rather than only when the order changed: Slint's `for`
                // reuses its items by index, so an event that moves to
                // another place in match order would leave the focused field
                // sitting over whatever is at the old index now. The row
                // stays selected -- selection is not focus.
                commit(id, text) => {
                    root.edit-match-event(id, text);
                    keys.focus();
                }
                // Go closes: the picture it seeks to is behind this sheet
                // (spec T10). It leaves the paste box's text alone.
                seek(id) => {
                    root.seek-match-event(id);
                    root.close-match-editor();
                }
                // Off the row's field first, as every other button in this
                // app does -- a click doesn't take focus from a field by
                // itself. Both of these change the event list, and the rows
                // are only rebuilt once that field is out of the way (spec
                // T3); the focus loss commits whatever is in it, which is
                // the rule everywhere else too (T4).
                remove(id) => {
                    keys.focus();
                    root.delete-match-event(id);
                }
                add => {
                    keys.focus();
                    root.add-match-events();
                }
                close => { root.close-match-editor(); }
            }
        }

        // --- New match sheet: modal over the whole window (spec S1) ---
        //
        // Z-order is file order in Slint, so this goes after the other sheets
        // and **before** the error dialog: an error raised by Create has to be
        // drawn over the sheet that raised it (spec C4).
        if root.new-match-sheet-open: Scrim {
            NewMatchSheet {
                home-name <=> root.new-match-home-name;
                away-name <=> root.new-match-away-name;
                projects-dir <=> root.new-match-projects-dir;
                folder-name <=> root.new-match-folder-name;
                provenance: root.new-match-provenance;
                videos: root.new-match-videos;
                creating: root.new-match-creating;
                team-named(name) => { return root.team-named(name); }
                valid-folder-name(name) => { return root.valid-folder-name(name); }
                valid-projects-dir(path) => { return root.valid-projects-dir(path); }
                target-taken(dir, name) => { return root.target-taken(dir, name); }
                folder-edited => { root.new-match-folder-dirty = true; }
                swap => { root.swap-new-match-teams(); }
                // Off the field first, as every other button in this app does.
                choose => {
                    keys.focus();
                    root.choose-projects-dir();
                }
                // Create disables on the click and the sheet closes on
                // `ProjectOpened` and on nothing else, so a failure leaves the
                // sheet up with the coach's typing in it.
                create => {
                    root.new-match-creating = true;
                    root.create-match();
                }
                cancel => { root.close-new-match(); }
            }
        }

        // --- Keys sheet: modal over the whole window (#96) ---
        //
        // After every other sheet and **before** the error dialog, which is
        // the order `handle-key` tests them in: the dialog has to be drawn
        // over whatever raised it (spec C4), and this sheet raises nothing.
        if root.keys-sheet-open: Scrim {
            KeysSheet {
                rows: root.key-rows;
                capturing <=> root.capturing-action;
                message <=> root.keys-message;
                unbind(action) => { root.unbind-key(action); }
                close => {
                    root.keys-sheet-open = false;
                    // The line goes with the sheet: what a rebind took from
                    // where is an answer to something the coach just did, not
                    // something to find still sitting there next time.
                    root.keys-message = "";
                    keys.focus();
                }
            }
        }

        // --- Error dialog: modal over the whole window ---
        //
        // The one sheet with no heading: its message is the
        // only thing it has to say.
        if root.error-message != "": Scrim {
            Sheet {
                card-width: 440px;
                body-spacing: 16px;

                Text {
                    text: root.error-message;
                    color: Palette.foreground;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: "OK";
                        primary: true;
                        clicked => {
                            root.error-message = "";
                            keys.focus();
                        }
                    }
                }
            }
        }
    }
}
